@model Plataforma.ViewModels.Reportes.ReporteGeneralVm
@{
    ViewData["Title"] = "Reporte por Rango de Fechas y Servicio";
}

<div class="content-wrapper">
    <div class="content-wrapper">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Reportes generales</h2>

            <a asp-action="ExportarExcel"
               asp-route-fechaInicio="@Model.Filtro.FechaInicio.ToString("yyyy-MM-dd")"
               asp-route-fechaFin="@Model.Filtro.FechaFin.ToString("yyyy-MM-dd")"
               class="btn btn-success">
                Exportar Excel
            </a>
        </div>

        <form method="get" asp-action="Index" class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <label class="form-label">Fecha inicio</label>
                    <input type="date"
                           name="fechaInicio"
                           class="form-control"
                           value="@Model.Filtro.FechaInicio.ToString("yyyy-MM-dd")" />

                    <label class="form-label">Fecha fin</label>
                    <input type="date"
                           name="fechaFin"
                           class="form-control"
                           value="@Model.Filtro.FechaFin.ToString("yyyy-MM-dd")" />

                    <div class="col-md-4 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Consultar</button>
                    </div>
                </div>
            </div>
        </form>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted">VNeto</div>
                        <h4>@Model.TotalVNeto.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted">SubTotal</div>
                        <h4>@Model.TotalSubTotal.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted">Utilidad</div>
                        <h4>@Model.TotalUtilidad.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted">Participaciones</div>
                        <h4>@Model.TotalParticipaciones.ToString("N2")</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <strong>Ventas por servicio</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>VNeto</th>
                            <th>SubTotal</th>
                            <th>Utilidad</th>
                            <th>Cierres</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.VentasPorServicio.Any())
                        {
                            @foreach (var item in Model.VentasPorServicio)
                            {
                                <tr>
                                    <td>@item.Servicio</td>
                                    <td>@item.TotalVNeto.ToString("N2")</td>
                                    <td>@item.TotalSubTotal.ToString("N2")</td>
                                    <td>@item.TotalUtilidad.ToString("N2")</td>
                                    <td>@item.CantidadCierres</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">No hay información en el rango seleccionado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Ganancias por persona</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Cédula</th>
                            <th>Empleado</th>
                            <th>Servicio</th>
                            <th>Concepto</th>
                            <th>Base utilidad</th>
                            <th>% Promedio</th>
                            <th>Valor ganado</th>
                            <th>Novedades</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GananciasPorPersona.Any())
                        {
                            @foreach (var item in Model.GananciasPorPersona)
                            {
                                <tr>
                                    <td>@item.Cedula</td>
                                    <td>@item.Empleado</td>
                                    <td>@item.Servicio</td>
                                    <td>@item.Concepto</td>
                                    <td>@item.BaseUtilidad.ToString("N2")</td>
                                    <td>@item.PorcentajePromedio.ToString("N2")</td>
                                    <td>@item.ValorGanado.ToString("N2")</td>
                                    <td>@item.CantidadNovedades</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No hay novedades en el rango seleccionado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
