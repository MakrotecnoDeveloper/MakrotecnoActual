@{
    ViewData["Title"] = "Reporte por Rango de Fechas y Servicio";
    var servicios = ViewBag.Servicios as List<ConceptoServicioVM>;
}

<div class="content-wrapper">
    <h2>Reporte por Rango de Fechas y Servicio</h2>

    <form method="get" asp-action="Index" id="filtroForm">
        <div class="row g-2">
            <div class="col-md-3">
                <label>Fecha Inicio</label>
                <input type="date" class="form-control" id="fechaInicio" name="fechaInicio"
                       value="@(((DateTime)ViewBag.FechaInicio).ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="col-md-3">
                <label>Fecha Fin</label>
                <input type="date" class="form-control" id="fechaFin" name="fechaFin"
                       value="@(((DateTime)ViewBag.FechaFin).ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="col-md-3">
                <label>Servicio</label>
                <select class="form-select" name="idServicio" id="selectServicios" required>
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-3 align-self-end">
                <button type="submit" class="btn btn-primary">Consultar</button>
            </div>
        </div>
    </form>


    @if (ViewBag.TotalSub != null)
    {
        <div class="alert alert-info mt-4">
            <strong>Rango:</strong> @ViewBag.FechaInicio.ToShortDateString() - @ViewBag.FechaFin.ToShortDateString() <br />
            <strong>Servicio:</strong>
            @(servicios?.FirstOrDefault(x => x.IdServicio == (int)ViewBag.ServicioSeleccionado)?.NombreServicio ?? "N/A") <br />
            <strong>Total SubTotal:</strong> @ViewBag.TotalSub.ToString("N2") <br />
            <strong>Total VNeto:</strong> @ViewBag.TotalNeto.ToString("N2")
        </div>
    }
</div>
@section Scripts
{
        <script>
             $(document).ready(function () {
                 function cargarServicios() {
                     var inicio = $("#fechaInicio").val();
                     var fin = $("#fechaFin").val();

                     if (!inicio || !fin) return;

                     $.getJSON('/Reporte/GetServicios', { fechaInicio: inicio, fechaFin: fin })
                         .done(function (data) {
                             var $select = $("#selectServicios");
                             $select.empty();
                             $select.append('<option value="">-- Seleccione --</option>');
                             $.each(data, function (i, s) {
                                 $select.append('<option value="' + s.id + '">' + s.nombre + '</option>');
                             });
                         })
                         .fail(function () {
                             alert("Error al cargar los servicios.");
                         });
                 }

                 // Ejecutar al cargar la página
                 cargarServicios();

                 // Ejecutar cuando cambian las fechas
                 $("#fechaInicio, #fechaFin").on("change", function () {
                     cargarServicios();
                 });
             });
    </script>

}
