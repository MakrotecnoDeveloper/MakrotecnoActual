
@{
    ViewData["Title"] = "FormCrearCliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper py-5" style="background-color: #f4f6f9;">
    <div class="container">
        <div class="card shadow-lg border-0 rounded-4">
            <!-- Encabezado con degradado -->
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(90deg, #0062E6, #33AEFF);">
                <h3 class="card-title m-0 fw-bold">
                    <i class="bi bi-person-plus-fill"></i> Agregar Cliente
                </h3>
                <small class="opacity-75">Complete la información para registrar un nuevo cliente</small>
            </div>

            <!-- Cuerpo del formulario -->
            <div class="card-body p-4">
                <form method="post" asp-action="AddCliente" asp-controller="Usuario">
                    <!-- Cédula -->
                    <div class="mb-4">
                        <label for="cedulaCliente" class="form-label fw-semibold">Cédula del Cliente</label>
                        <input type="number" class="form-control form-control-lg" id="cedulaCliente" name="cedulaCliente" required placeholder="Ingrese la cédula del cliente" />
                    </div>

                    <!-- Nombre -->
                    <div class="mb-4">
                        <label for="nombreCliente" class="form-label fw-semibold">Nombre del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="nombreCliente" name="nombreCliente" required placeholder="Ingrese el nombre del cliente" />
                    </div>

                    <!-- Empresa -->
                    <div class="mb-4">
                        <label for="empresaCliente" class="form-label fw-semibold">Empresa del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="empresaCliente" name="empresaCliente" placeholder="Ingrese el nombre de la empresa" />
                    </div>

                    <!-- Ciudad -->
                    <div class="mb-4">
                        <label for="ciudadCliente" class="form-label fw-semibold">Ciudad del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="ciudadCliente" name="ciudadCliente" required placeholder="Ingrese la ciudad del cliente" />
                    </div>

                    <!-- Teléfono -->
                    <div class="mb-4">
                        <label for="telefonoCliente" class="form-label fw-semibold">Teléfono del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="telefonoCliente" name="telefonoCliente" required placeholder="Ingrese el teléfono del cliente" />
                    </div>

                    <!-- Correo -->
                    <div class="mb-4">
                        <label for="correoCliente" class="form-label fw-semibold">Correo del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="correoCliente" name="correoCliente" required placeholder="Ingrese el correo del cliente" />
                    </div>

                    <!-- Direccion -->
                    <div class="mb-4">
                        <label for="direccionCliente" class="form-label fw-semibold">Direccion del Cliente</label>
                        <input type="text" class="form-control form-control-lg" id="direccionCliente" name="direccionCliente" required placeholder="Ingrese la direccion del cliente" />
                    </div>

                    <!-- Botones -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-lg px-5 text-white" style="background: linear-gradient(90deg, #0062E6, #33AEFF); border: none;">
                            <i class="bi bi-save-fill"></i> Guardar Cliente
                        </button>
                        <a href="/" class="btn btn-lg btn-outline-secondary px-5 ms-2">
                            <i class="bi bi-x-circle-fill"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


