@{
    ViewData["Title"] = "Empleados";
    var rolUsuario = User.Claims.FirstOrDefault(c => c.Type == "NombreRol")?.Value;
    var mostrarOpciones = rolUsuario == "Administrador";
}
<div class="content-wrapper">
    <div class="container mt-4">
        <h2 class="mb-3">Listado de Empleados</h2>

        @if (mostrarOpciones)
        {
            <button class="btn btn-primary mb-3" onclick="abrirModalAgregar()">Agregar Empleado</button>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="tablaEmpleados">
                <thead class="table-light">
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Género</th>
                        <th>Correo</th>
                        <th>Celular</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaCuerpo">
                    @foreach (var empleado in Model)
                    {
                        <tr>
                            <td>@empleado.Cedula</td>
                            <td>@empleado.Nombre</td>
                            <td>@empleado.Apellido</td>
                            <td>@empleado.Genero</td>
                            <td>@empleado.Correo</td>
                            <td>@empleado.Celular</td>
                            <td>
                                <button class="btn btn-info btn-sm" onclick="verEmpleado(@empleado.Cedula)">Ver</button>

                                @if (mostrarOpciones)
                                {
                                    <button class="btn btn-warning btn-sm" onclick="editarEmpleado(@empleado.Cedula)">Editar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Controles de paginación -->
        <nav>
            <ul class="pagination justify-content-center" id="paginacionTabla"></ul>
        </nav>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="modalEmpleado" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="contenidoModalEmpleado">
                <!-- Se carga parcial con AJAX -->
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const filasPorPagina = 5;
        let paginaActual = 1;
        const tabla = document.getElementById("tablaEmpleados");
        const cuerpoTabla = document.getElementById("tablaCuerpo");
        const paginacion = document.getElementById("paginacionTabla");

        function mostrarPagina(pagina) {
            const filas = cuerpoTabla.getElementsByTagName("tr");
            const totalPaginas = Math.ceil(filas.length / filasPorPagina);

            // Ocultar todas
            for (let i = 0; i < filas.length; i++) {
                filas[i].style.display = "none";
            }

            // Mostrar las de la página actual
            const inicio = (pagina - 1) * filasPorPagina;
            const fin = inicio + filasPorPagina;

            for (let i = inicio; i < fin && i < filas.length; i++) {
                filas[i].style.display = "";
            }

            // Actualizar controles
            paginacion.innerHTML = "";
            for (let i = 1; i <= totalPaginas; i++) {
                paginacion.innerHTML += `
                    <li class="page-item ${i === pagina ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="mostrarPagina(${i})">${i}</a>
                    </li>
                `;
            }

            paginaActual = pagina;
        }

        // Inicializar
        document.addEventListener("DOMContentLoaded", function () {
            mostrarPagina(1);
        });

        function abrirModalAgregar() {
            $.get('@Url.Action("_AgregarEmpleado", "Usuario")', function (data) {
                $("#contenidoModalEmpleado").html(data);
                $("#modalEmpleado").modal("show");
            });
        }

        function verEmpleado(cedula) {
            $.get('@Url.Action("_VerEmpleado", "Usuario")', { cedula: cedula }, function (data) {
                $("#contenidoModalEmpleado").html(data);
                $("#modalEmpleado").modal("show");
            });
        }

        function editarEmpleado(cedula) {
            $.get('@Url.Action("_EditarEmpleado", "Usuario")', { cedula: cedula }, function (data) {
                $("#contenidoModalEmpleado").html(data);
                $("#modalEmpleado").modal("show");
            });
        }

        function actualizarTabla() {
            location.reload(); // O usar AJAX si quieres mejorar esto más
        }
    </script>
}
