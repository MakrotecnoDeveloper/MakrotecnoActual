@model List<Proveedores>
@{
    ViewData["Title"] = "TblVisuProveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container mt-4">
    <h2>Lista de Proveedores</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No se encontraron proveedores.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>NIT</th>
                    <th>Razon Social</th>
                    <th>Direccion</th>
                    <th>Celular</th>
                    <th>Correo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in Model)
                {
                    <tr>
                        <td>@proveedor.Nit</td>
                        <td>@proveedor.RazonSocial</td>
                        <td>@proveedor.Direccion</td>
                        <td>@proveedor.Celular</td>
                        <td>@proveedor.Correo</td>
                        <td>
                            <button class="btn btn-sm btn-info modProveedorEditar" data-id="@proveedor.IdProveedor">Modificar Cliente</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div id="sidePanel" class="position-fixed top-0 end-0 bg-light border-start shadow"
     style="width: 400px; height: 100%; display: none; z-index: 1050; overflow-y: auto;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 id="sidePanelTitle" class="mb-0">Detalle</h5>
        <button type="button" class="btn-close" id="closePanel"></button>
    </div>
    <div class="p-3" id="sidePanelContent">
        <!-- Aquí se cargará el contenido dinámico -->
    </div>
</div>

</div>

@section Scripts
{
    <script>
        $(document).on("click", ".modProveedorEditar", function () {
            const idProveedor = $(this).data("id");

            $.get(`/Usuario/ModProveedor/${idProveedor}`, function (html) {
                $("#sidePanelTitle").text("Editar Cliente");
                $("#sidePanelContent").html(html);
                $("#sidePanel").fadeIn();
            });
        });

            // =================== Cerrar Panel ======================= //
        $("#closePanel").click(function () {
            $("#sidePanel").fadeOut();
        });
    </script>
}
