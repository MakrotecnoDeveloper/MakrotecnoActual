@model Empleado

<div class="modal-header">
    <h5 class="modal-title">Información del Empleado</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <p><strong>Cédula:</strong> @Model.Cedula</p>
    <p><strong>Nombre:</strong> @Model.Nombre @Model.Apellido</p>
    <p><strong>Género:</strong> @Model.Genero</p>
    <p><strong>Correo:</strong> @Model.Correo</p>
    <p><strong>Celular:</strong> @Model.Celular</p>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
