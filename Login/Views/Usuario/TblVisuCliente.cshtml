@model List<Clientes>
@{
    ViewData["Title"] = "TblVisuCliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container mt-4">
    <h2>Lista de Clientes</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No se encontraron clientes.</div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Empresa</th>
                    <th>Ciudad</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.CedulaCliente</td>
                        <td>@cliente.NombreCliente</td>
                        <td>@cliente.EmpresaCliente</td>
                        <td>@cliente.CiudadCliente</td>
                        <td>@cliente.TelefonoCliente</td>
                        <td>
                            <button class="btn btn-sm btn-info modClientEditar" data-id="@cliente.IdCliente">Modificar Cliente</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div id="sidePanel" class="position-fixed top-0 end-0 bg-light border-start shadow"
     style="width: 400px; height: 100%; display: none; z-index: 1050; overflow-y: auto;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 id="sidePanelTitle" class="mb-0">Detalle</h5>
        <button type="button" class="btn-close" id="closePanel"></button>
    </div>
    <div class="p-3" id="sidePanelContent">
        <!-- Aquí se cargará el contenido dinámico -->
    </div>
</div>

</div>

@section Scripts 
{
    <script>
        $(document).on("click", ".modClientEditar", function () {
            const idCliente = $(this).data("id");

            $.get(`/Usuario/ModCliente/${idCliente}`, function (html) {
                $("#sidePanelTitle").text("Editar Cliente");
                $("#sidePanelContent").html(html);
                $("#sidePanel").fadeIn();
            });
        });

            // =================== Cerrar Panel ======================= //
        $("#closePanel").click(function () {
            $("#sidePanel").fadeOut();
        });
    </script>
}
