@model Plataforma.ViewModels.CuentasCobro.CuentaCobroCrearVm

@{
    ViewData["Title"] = "Generar cuenta de cobro";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="content-wrapper">
    <div class="container py-4">

        <h3>Generar cuenta de cobro</h3>
        <p class="text-muted">Factura: <strong>@Model.NumeroFactura</strong></p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-action="CrearDesdeFactura" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IdFactura" />
            <input type="hidden" asp-for="IdVenta" />
            <input type="hidden" asp-for="IdCliente" />
            <input type="hidden" asp-for="NumeroFactura" />
            <input type="hidden" asp-for="NumeroCuentaCobro" />

            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Cuenta bancaria</label>
                        <select asp-for="IdCuentaBancariaEmpresa" asp-items="Model.CuentasBancarias" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Fecha</label>
                        <input asp-for="FechaCuentaCobro" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ciudad</label>
                        <input asp-for="Ciudad" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cliente</label>
                        <input asp-for="NombreCliente" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Documento</label>
                        <input asp-for="DocumentoCliente" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Teléfono</label>
                        <input asp-for="TelefonoCliente" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input asp-for="CorreoCliente" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Dirección</label>
                        <input asp-for="DireccionCliente" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Detalle</label>
                        <textarea asp-for="DetalleServicio" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Valor total</label>
                        <input asp-for="ValorTotalServicio" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Retención</label>
                        <input asp-for="RetencionFuente" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Otras deducciones</label>
                        <input asp-for="OtrasDeducciones" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Declaración</label>
                        <textarea asp-for="Declaracion" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">Generar cuenta de cobro</button>
            </div>
        </form>

    </div>
</div>