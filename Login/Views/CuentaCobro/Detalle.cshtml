@model Plataforma.ViewModels.CuentasCobro.CuentaCobroDetalleVm

@{
    ViewData["Title"] = "Detalle cuenta de cobro";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="content-wrapper">
    <div class="container py-4">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h3 class="mb-1 fw-semibold">
                    <i class="bi bi-file-earmark-text"></i> Cuenta de cobro @Model.NumeroCuentaCobro
                </h3>

                <div class="text-muted">
                    Factura asociada: <strong>@Model.NumeroFactura</strong>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>

                <a asp-action="Imprimir"
                   asp-route-id="@Model.IdCuentaCobro"
                   target="_blank"
                   class="btn btn-dark">
                    <i class="bi bi-printer"></i> Imprimir / PDF
                </a>
            </div>
        </div>

        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row g-3">

            <!-- Resumen -->
            <div class="col-12 col-lg-4">

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-semibold mb-0">Resumen</h5>

                            @switch (Model.EstadoCuentaCobro)
                            {
                                case "Pendiente":
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;

                                case "Enviada":
                                    <span class="badge bg-info text-dark">Enviada</span>
                                    break;

                                case "Pagada":
                                    <span class="badge bg-success">Pagada</span>
                                    break;

                                case "Anulada":
                                    <span class="badge bg-danger">Anulada</span>
                                    break;

                                default:
                                    <span class="badge bg-secondary">@Model.EstadoCuentaCobro</span>
                                    break;
                            }
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">Número cuenta de cobro</div>
                            <div class="fw-semibold">@Model.NumeroCuentaCobro</div>
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">Factura</div>
                            <div class="fw-semibold">@Model.NumeroFactura</div>
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">Fecha</div>
                            <div class="fw-semibold">@Model.FechaCuentaCobro.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="mb-2">
                            <div class="text-muted small">Ciudad</div>
                            <div class="fw-semibold">@(Model.Ciudad ?? "No registrada")</div>
                        </div>

                        <hr />

                        <div class="text-muted small">Valor neto a pagar</div>
                        <div class="fs-3 fw-bold text-success">
                            @Model.ValorNetoPagar.ToString("C0", cultura)
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Acciones</h5>

                        <div class="d-grid gap-2">

                            @if (Model.EstadoCuentaCobro == "Pendiente")
                            {
                                <form asp-action="MarcarEnviada" asp-route-id="@Model.IdCuentaCobro" method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-info w-100">
                                        <i class="bi bi-send"></i> Marcar como enviada
                                    </button>
                                </form>
                            }

                            @if (Model.EstadoCuentaCobro == "Pendiente" || Model.EstadoCuentaCobro == "Enviada")
                            {
                                <form asp-action="MarcarPagada" asp-route-id="@Model.IdCuentaCobro" method="post"
                                      onsubmit="return confirm('¿Desea marcar esta cuenta de cobro como pagada?');">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-check-circle"></i> Marcar como pagada
                                    </button>
                                </form>

                                <form asp-action="Anular" asp-route-id="@Model.IdCuentaCobro" method="post"
                                      onsubmit="return confirm('¿Está seguro de anular esta cuenta de cobro?');">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-x-circle"></i> Anular
                                    </button>
                                </form>
                            }

                            <a asp-action="Imprimir"
                               asp-route-id="@Model.IdCuentaCobro"
                               target="_blank"
                               class="btn btn-dark">
                                <i class="bi bi-printer"></i> Imprimir / Guardar PDF
                            </a>

                        </div>
                    </div>
                </div>

            </div>

            <!-- Detalle principal -->
            <div class="col-12 col-lg-8">

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Datos de la empresa</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-muted small">Empresa</div>
                                <div class="fw-semibold">@(Model.Empresa?.Nombre ?? "No registrada")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">NIT / Documento</div>
                                <div class="fw-semibold">@(Model.Empresa?.Id_empresa ?? "No registrado")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Teléfono</div>
                                <div class="fw-semibold">@(Model.Empresa?.Telefono ?? "No registrado")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Dirección</div>
                                <div class="fw-semibold">@(Model.Empresa?.Direccion ?? "No registrada")</div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Cuenta bancaria para pago</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-muted small">Titular</div>
                                <div class="fw-semibold">@(Model.CuentaBancaria?.TitularCuenta ?? "No registrado")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Documento titular</div>
                                <div class="fw-semibold">@(Model.CuentaBancaria?.DocumentoTitular ?? "No registrado")</div>
                            </div>

                            <div class="col-md-4">
                                <div class="text-muted small">Banco</div>
                                <div class="fw-semibold">@(Model.CuentaBancaria?.Banco ?? "No registrado")</div>
                            </div>

                            <div class="col-md-4">
                                <div class="text-muted small">Tipo de cuenta</div>
                                <div class="fw-semibold">@(Model.CuentaBancaria?.TipoCuenta ?? "No registrado")</div>
                            </div>

                            <div class="col-md-4">
                                <div class="text-muted small">Número</div>
                                <div class="fw-semibold">@(Model.CuentaBancaria?.NumeroCuenta ?? "No registrado")</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.CuentaBancaria?.Convenio))
                            {
                                <div class="col-md-12">
                                    <div class="text-muted small">Convenio</div>
                                    <div class="fw-semibold">@Model.CuentaBancaria.Convenio</div>
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Datos del cliente</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-muted small">Cliente</div>
                                <div class="fw-semibold">@Model.NombreCliente</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Documento</div>
                                <div class="fw-semibold">@Model.DocumentoCliente</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Teléfono</div>
                                <div class="fw-semibold">@Model.TelefonoCliente</div>
                            </div>

                            <div class="col-md-6">
                                <div class="text-muted small">Correo</div>
                                <div class="fw-semibold">@Model.CorreoCliente</div>
                            </div>

                            <div class="col-md-12">
                                <div class="text-muted small">Dirección</div>
                                <div class="fw-semibold">@Model.DireccionCliente</div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Detalle cobrado</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.DetalleServicio))
                        {
                            <div class="alert alert-light border">
                                @Model.DetalleServicio
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Producto / Servicio</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Valor unitario</th>
                                        <th class="text-end">IVA</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model.Detalles != null && Model.Detalles.Any())
                                    {
                                        foreach (var item in Model.Detalles)
                                        {
                                            <tr>
                                                <td>@item.CodigoProducto</td>
                                                <td>@item.NombreProducto</td>
                                                <td class="text-end">@item.Cantidad.ToString("N2", cultura)</td>
                                                <td class="text-end">@item.ValorUnitario.ToString("C0", cultura)</td>
                                                <td class="text-end">@item.IvaValor.ToString("C0", cultura)</td>
                                                <td class="text-end fw-semibold">@item.TotalLinea.ToString("C0", cultura)</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">
                                                No hay detalles registrados.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Valor total</th>
                                        <td class="text-end">@Model.ValorTotalServicio.ToString("C0", cultura)</td>
                                    </tr>
                                    <tr>
                                        <th>Retención</th>
                                        <td class="text-end">@Model.RetencionFuente.ToString("C0", cultura)</td>
                                    </tr>
                                    <tr>
                                        <th>Otras deducciones</th>
                                        <td class="text-end">@Model.OtrasDeducciones.ToString("C0", cultura)</td>
                                    </tr>
                                    <tr class="table-dark">
                                        <th>Valor neto a pagar</th>
                                        <td class="text-end">@Model.ValorNetoPagar.ToString("C0", cultura)</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">

                        <h5 class="fw-semibold mb-3">Declaración</h5>

                        @if (!string.IsNullOrWhiteSpace(Model.Declaracion))
                        {
                            <p class="mb-0">@Model.Declaracion</p>
                        }
                        else
                        {
                            <p class="mb-0">
                                Declaro bajo la gravedad de juramento que los productos y/o servicios relacionados en la presente
                                cuenta de cobro fueron efectivamente suministrados a @Model.NombreCliente.
                            </p>
                        }

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>