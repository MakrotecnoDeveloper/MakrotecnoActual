@model List<Plataforma.Models.FacturaCompra>

@{
    ViewData["Title"] = "Facturas de compra";
}

<div class="content-wrapper">
    <div class="container-fluid mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">
                <i class="fas fa-file-invoice"></i> Facturas de compra
            </h3>

            <a asp-action="CrearFacturaCompra" class="btn btn-primary">
                <i class="fas fa-plus"></i> Agregar factura
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card shadow-sm">
            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Número factura</th>
                            <th>Proveedor</th>
                            <th>Fecha compra</th>
                            <th>Archivo</th>
                            <th>Fecha registro</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.NumeroFactura</td>
                                    <td>@item.Proveedor.RazonSocial</td>
                                    <td>@item.FechaCompra.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a href="@item.RutaArchivo" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-eye"></i> Ver archivo
                                        </a>
                                    </td>
                                    <td>@item.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-action="VerFacturaCompra" asp-route-id="@item.IdFacturaCompra" class="btn btn-sm btn-info">
                                            <i class="fas fa-search"></i>
                                        </a>

                                        <a asp-action="EditarFacturaCompra" asp-route-id="@item.IdFacturaCompra" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-action="InactivarFacturaCompra" asp-route-id="@item.IdFacturaCompra" method="post" class="d-inline"
                                              onsubmit="return confirm('Esta acción inactivará la factura, pero conservará el archivo para trazabilidad documental. ¿Desea continuar?');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="motivoInactivacion" value="Inactivada manualmente desde el módulo de compras" />

                                            <button type="submit" class="btn btn-sm btn-danger" title="Inactivar factura">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No hay facturas de compra registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>