@model CompraViewModel
@{
    ViewData["Title"] = "InsertarCompra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var proveedores = ViewBag.Proveedores as List<Proveedores>;
}
<div class="content-wrapper mt-4">
    <form id="productForm" asp-action="InsertarCompraCreate" method="POST">
        <section class="content">
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card border-0 shadow-lg rounded-4">
                            <div class="card-body">
                                <!-- Proveedor y Factura -->
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Proveedor</label>
                                        <select asp-for="IdProveedor" name="IdProveedor" class="form-select shadow-sm">
                                            @foreach (var prov in proveedores)
                                            {
                                                <option value="@prov.IdProveedor">@prov.RazonSocial</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Factura Externa</label>
                                        <input asp-for="CodFacturaExterno" name="CodFacturaExterno" class="form-control shadow-sm" value="No tiene" />
                                    </div>
                                </div>

                                <!-- Detalles productos -->
                                <div class="mt-5">
                                    <h5 class="text-primary fw-bold">Detalles de los Productos</h5>
                                    <div class="d-flex justify-content-end mb-2">
                                        <button type="button" class="btn btn-success btn-sm" onclick="insertarFilasCrearPedido()">
                                            <i class="fas fa-plus"></i> Agregar Producto
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover table-bordered align-middle" data-tipo="compra">
                                            <thead class="table-primary">
                                                <tr>
                                                    <th>Código</th>
                                                    <th>Cantidad</th>
                                                    <th>Valor Unitario</th>
                                                    <th>Valor Venta</th>
                                                    <th>Acumulado</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tablaProductos">
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control codigoProducto" name="Productos[0].Codigo" placeholder="Código" id="codfact0">
                                                        <div class="opcionesCodigosProducto small text-muted"></div>
                                                    </td>

                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].Stock" placeholder="Cantidad" id="stock0">
                                                    </td>

                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].ValorUnidad" placeholder="Valor Unitario" id="valorUnidad0">
                                                    </td>

                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].ValorVentaProducto" placeholder="Valor Venta" id="valorVentaProducto0">
                                                    </td>

                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].VTotal" placeholder="Valor Total" id="vtotal0" readonly>
                                                    </td>

                                                    <td>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <div class="text-end">
                                            <button type="button" class="btn btn-outline-success btn-sm" onclick="AcumularProductosDePedido()">
                                                <i class="fas fa-plus"></i> Acumulado Pedido
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Resumen factura -->
                                <div class="mt-5">
                                    <h5 class="text-primary fw-bold">Resumen de la Factura</h5>
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label for="subtotalFactura" class="form-label fw-semibold">Subtotal</label>
                                            <input type="text" class="form-control bg-light" id="subtotalFactura" name="subtotalFactura" readonly value="0.00">
                                        </div>
                                        <div class="col-md-4">
                                            <label for="ivaFactura" class="form-label fw-semibold">IVA (19%)</label>
                                            <input type="number" class="form-control bg-light" id="iva" name="Iva" value="0">
                                        </div>
                                        <div class="col-md-4">
                                            <label for="descuentoFactura" class="form-label fw-semibold">Descuento</label>
                                            <input type="number" class="form-control" id="descuentoFactura" name="DescuentoFactura" value="0">
                                        </div>
                                        <div class="col-md-6 mt-3">
                                            <label for="totalFactura" class="form-label fw-bold">Total</label>
                                            <input type="text" class="form-control bg-light text-success fw-bold" id="totalFactura" name="totalFactura" readonly value="0">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Botón enviar -->
                            <div class="card-footer text-center bg-white border-top-0">
                                <button type="submit" class="btn btn-primary btn-lg px-4">
                                    <i class="fas fa-save me-2"></i>Guardar Factura
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </form>
</div>


@section Scripts
{
    <script>
                let index = 1;

        function insertarFilasCrearPedido() {
            const nuevaFila = `
                <tr>
                    <td>
                        <input type="text" class="form-control codigoProducto" name="Productos[${index}].Codigo" placeholder="Código" id="codfact${index}">
                        <div class="opcionesCodigosProducto small text-muted"></div>
                    </td>

                    <td>
                        <input type="number" class="form-control" name="Productos[${index}].Stock" placeholder="Cantidad" id="stock${index}">
                    </td>

                    <td>
                        <input type="number" class="form-control" name="Productos[${index}].ValorUnidad" placeholder="Valor Unitario" id="valorUnidad${index}">
                    </td>

                    <td>
                        <input type="number" class="form-control" name="Productos[${index}].ValorVentaProducto" placeholder="Valor Venta" id="valorVentaProducto${index}">
                    </td>

                    <td>
                        <input type="number" class="form-control" name="Productos[${index}].VTotal" readonly placeholder="Valor Total" id="vtotal${index}">
                    </td>

                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila(this)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;

            $('#tablaProductos').append(nuevaFila);
            index++;
        }

        // Función para mostrar las opciones de autocompletado
        function mostrarOpcionesAutocompletado(opciones, container) {
            var opcionesHtml = '';
            opciones.forEach(function (opcion) {
                opcionesHtml += '<div class="opcion">' + opcion.value + '</div>';
            });
            container.html(opcionesHtml);
        }

        // Manejar el evento de entrada en el campo de código de producto dinámico
        $(document).on('input', '.codigoProducto', function () {
            var inputActual = $(this); // Input que se está editando
            var codigo = inputActual.val(); // Valor del input actual
            var contenedorOpciones = inputActual.siblings('.opcionesCodigosProducto'); // Contenedor asociado a este input

            if (codigo.length >= 3) {
                // Llamada AJAX para obtener las opciones de autocompletado
                $.ajax({
                    url: '/Compras/BuscarProductoPorCodigo',
                    type: 'GET',
                    data: { codigo: codigo },
                    success: function (response) {
                        // Mostrar las opciones en el contenedor asociado
                        mostrarOpcionesAutocompletado(response, contenedorOpciones);
                    },
                    error: function () {
                        console.error('Error al obtener los códigos.');
                        contenedorOpciones.empty(); // Limpiar opciones en caso de error
                    }
                });
            } else {
                contenedorOpciones.empty(); // Limpiar opciones si el texto es muy corto
            }
        });

        // Manejar la selección de una opción de autocompletado
                $(document).on('click', '.opcion', function () {
            var codigoSeleccionado = $(this).text();
            var contenedorOpciones = $(this).closest('.opcionesCodigosProducto');
            var inputCodigo = contenedorOpciones.siblings('.codigoProducto');
            var fila = contenedorOpciones.closest('tr');

            inputCodigo.val(codigoSeleccionado);
            contenedorOpciones.empty();

            $.ajax({
                url: '/Compras/BuscarProductoPorCodigo',
                type: 'GET',
                data: { codigo: codigoSeleccionado },
                success: function (data) {
                    if (Array.isArray(data) && data.length > 0) {
                        var producto = data[0];

                        fila.find('[id^="valorUnidad"]').val(producto.valorUnidad ?? 0);
                        fila.find('[id^="valorVentaProducto"]').val(producto.valorVentaProducto ?? 0);
                    }
                },
                error: function () {
                    console.error('Error al obtener los datos del producto.');
                }
            });
        });
        // Cálculo dinámico del valor total al editar 'Stock' o 'VVenta'
        $(document).on('input', '[id^="stock"], [id^="valorUnidad"], [id^="valorVentaProducto"]', function () {
            var fila = $(this).closest('tr');

            var stock = parseFloat(fila.find('[id^="stock"]').val()) || 0;
            var valorUnidad = parseFloat(fila.find('[id^="valorUnidad"]').val()) || 0;

            var vtotal = stock * valorUnidad;

            fila.find('[id^="vtotal"]').val(vtotal.toFixed(2));
        });

        function AcumularProductosDePedido() {
            let subtotal = 0;

            $('#tablaProductos tr').each(function () {
                let vtotal = parseFloat($(this).find('input[name$=".VTotal"]').val()) || 0;
                subtotal += vtotal;
            });

            $('#subtotalFactura').val(subtotal.toFixed(2));

            let ivaPorcentaje = parseFloat($('#iva').val()) || 0;
            let descuento = parseFloat($('#descuentoFactura').val()) || 0;

            let iva = (subtotal * ivaPorcentaje) / 100;

            let total = subtotal + iva - descuento;

            $('#totalFactura').val(total.toFixed(2));
        }
    </script>
}