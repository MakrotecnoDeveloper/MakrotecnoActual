@model MakroTecno.ViewModels.Compras.FacturaCompraViewModel

@{
    ViewData["Title"] = "Agregar factura de compra";
}
<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="fas fa-file-upload"></i> Agregar factura de compra
                </h4>
            </div>

            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="CrearFacturaCompra" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row">

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Prefijo</label>
                            <input asp-for="PrefijoFactura" class="form-control" placeholder="Ej: FE, FV, A" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Número de factura</label>
                            <input asp-for="NumeroFactura" class="form-control" />
                            <span asp-validation-for="NumeroFactura" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Proveedor</label>
                            <select asp-for="IdProveedor" asp-items="Model.Proveedores" class="form-control">
                                <option value="">Seleccione un proveedor</option>
                            </select>
                            <span asp-validation-for="IdProveedor" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha de compra</label>
                            <input asp-for="FechaCompra" type="date" class="form-control" />
                            <span asp-validation-for="FechaCompra" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">Observación</label>
                            <textarea asp-for="Observacion" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">Archivo de factura</label>
                            <input asp-for="ArchivoFactura" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                            <small class="text-muted">
                                Formatos permitidos: JPG, JPEG, PNG, WEBP o PDF. Tamaño máximo: 5 MB.
                            </small>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end">
                        <a asp-action="FacturasCompra" class="btn btn-secondary me-2">
                            Cancelar
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Guardar factura
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}