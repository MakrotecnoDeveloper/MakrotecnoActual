@model Plataforma.Models.FacturaCompra

@{
    ViewData["Title"] = "Ver factura de compra";
    var extension = System.IO.Path.GetExtension(Model.RutaArchivo)?.ToLower();
}
<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">

            <div class="card-header bg-info text-white">
                <h4 class="mb-0">
                    <i class="fas fa-search"></i> Detalle factura de compra
                </h4>
            </div>

            <div class="card-body">

                <div class="row mb-3">

                    <div class="col-md-4">
                        <strong>Número de factura:</strong>
                        <p>@Model.NumeroFactura</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Proveedor:</strong>
                        <p>@Model.Proveedor.RazonSocial</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Fecha de compra:</strong>
                        <p>@Model.FechaCompra.ToString("yyyy-MM-dd")</p>
                    </div>

                    <div class="col-md-12">
                        <strong>Observación:</strong>
                        <p>@Model.Observacion</p>
                    </div>

                </div>

                <hr />

                <h5>Archivo de factura</h5>

                @if (extension == ".pdf")
                {
                    <iframe src="@Model.RutaArchivo" width="100%" height="600px" style="border:1px solid #ccc;"></iframe>
                }
                else
                {
                    <img src="@Model.RutaArchivo" class="img-fluid rounded border" style="max-height:700px;" />
                }

                <div class="mt-4 d-flex justify-content-end">
                    <a asp-action="FacturasCompra" class="btn btn-secondary me-2">
                        Volver
                    </a>

                    <a asp-action="EditarFacturaCompra" asp-route-id="@Model.IdFacturaCompra" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>