@model MakroTecno.Models.ViewModels.InicializacionClientes.InicializacionClienteViewModel

@{
    ViewData["Title"] = "Inicialización de Clientes ERP";
}

<div class="content-wrapper">
    <div class="container-fluid py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Inicialización de Clientes ERP</h2>
                <p class="text-muted mb-0">
                    Busca una empresa por NIT para configurar plan, licencia, sedes, PDV, empleados y módulos.
                </p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">NIT / Identificación de la empresa</label>
                        <input type="text"
                               name="nit"
                               value="@Model.NitBuscado"
                               class="form-control"
                               placeholder="Ej: 123456789" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-1"></i> Buscar cliente
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.BusquedaRealizada && !Model.ClienteExiste)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="alert alert-warning mb-4">
                        <strong>Cliente no encontrado.</strong>
                        Puedes crear la empresa y generar la configuración inicial del ERP.
                    </div>

                    <h5 class="fw-bold mb-3">Crear nuevo cliente ERP</h5>

                    <form asp-action="CrearCliente" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="NuevoCliente.IdEmpresa" value="@Model.NitBuscado" />

                        <ul class="nav nav-tabs mb-3" id="crearClienteTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active"
                                        id="datos-empresa-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#datos-empresa"
                                        type="button"
                                        role="tab">
                                    Empresa
                                </button>
                            </li>

                            <li class="nav-item" role="presentation">
                                <button class="nav-link"
                                        id="sede-pdv-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#sede-pdv"
                                        type="button"
                                        role="tab">
                                    Sede y PDV
                                </button>
                            </li>

                            <li class="nav-item" role="presentation">
                                <button class="nav-link"
                                        id="admin-inicial-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#admin-inicial"
                                        type="button"
                                        role="tab">
                                    Administrador
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="crearClienteTabsContent">

                            <div class="tab-pane fade show active" id="datos-empresa" role="tabpanel">
                                <div class="card border">
                                    <div class="card-header bg-light fw-bold">
                                        Datos de empresa
                                    </div>

                                    <div class="card-body row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">NIT</label>
                                            <input asp-for="NuevoCliente.IdEmpresa" class="form-control" value="@Model.NitBuscado" />
                                        </div>

                                        <div class="col-md-8">
                                            <label class="form-label">Nombre empresa</label>
                                            <input asp-for="NuevoCliente.NombreEmpresa" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">País</label>
                                            <input asp-for="NuevoCliente.Pais" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Teléfono</label>
                                            <input asp-for="NuevoCliente.TelefonoEmpresa" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Actividad económica</label>
                                            <select asp-for="NuevoCliente.ActividadEconomicaId" class="form-select">
                                                <option value="">Seleccione...</option>
                                                @foreach (var actividad in Model.ActividadesEconomicas)
                                                {
                                                    <option value="@actividad.IdActividad">@actividad.NombreActividad</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-md-8">
                                            <label class="form-label">Dirección</label>
                                            <input asp-for="NuevoCliente.DireccionEmpresa" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Plan</label>
                                            <select asp-for="NuevoCliente.IdPlan" class="form-select">
                                                <option value="">Seleccione...</option>
                                                @foreach (var plan in Model.Planes)
                                                {
                                                    <option value="@plan.IdPlan">@plan.NombrePlan - @plan.PrecioMensual.ToString("C0")</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="sede-pdv" role="tabpanel">
                                <div class="card border">
                                    <div class="card-header bg-light fw-bold">
                                        Sede y PDV inicial
                                    </div>

                                    <div class="card-body row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Nombre sede</label>
                                            <input asp-for="NuevoCliente.NombreSede" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Ciudad</label>
                                            <input asp-for="NuevoCliente.CiudadSede" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Teléfono sede</label>
                                            <input asp-for="NuevoCliente.TelefonoSede" class="form-control" />
                                        </div>

                                        <div class="col-md-8">
                                            <label class="form-label">Dirección sede</label>
                                            <input asp-for="NuevoCliente.DireccionSede" class="form-control" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Nombre PDV</label>
                                            <input asp-for="NuevoCliente.NombrePdv" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="admin-inicial" role="tabpanel">
                                <div class="card border">
                                    <div class="card-header bg-light fw-bold">
                                        Administrador inicial
                                    </div>

                                    <div class="card-body row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label">Cédula</label>
                                            <input asp-for="NuevoCliente.CedulaAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Nombre</label>
                                            <input asp-for="NuevoCliente.NombreAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Apellido</label>
                                            <input asp-for="NuevoCliente.ApellidoAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Correo</label>
                                            <input asp-for="NuevoCliente.CorreoAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Celular</label>
                                            <input asp-for="NuevoCliente.CelularAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Género</label>
                                            <input asp-for="NuevoCliente.GeneroAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">RH</label>
                                            <input asp-for="NuevoCliente.RhAdministrador" class="form-control" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label">Contraseña inicial</label>
                                            <input asp-for="NuevoCliente.ContrasenaAdministrador" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-1"></i> Crear e inicializar cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.BusquedaRealizada && Model.ClienteExiste && Model.Empresa != null)
        {
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Empresa</h5>
                            <p class="mb-1"><strong>NIT:</strong> @Model.Empresa.IdEmpresa</p>
                            <p class="mb-1"><strong>Nombre:</strong> @Model.Empresa.Nombre</p>
                            <p class="mb-1"><strong>Estado:</strong> @Model.Empresa.Estado</p>
                            <p class="mb-1"><strong>Actividad:</strong> @Model.Empresa.ActividadEconomica</p>
                            <p class="mb-1"><strong>Teléfono:</strong> @Model.Empresa.Telefono</p>
                            <p class="mb-0"><strong>Dirección:</strong> @Model.Empresa.Direccion</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Licencia actual</h5>

                            @if (Model.Licencia != null)
                            {
                                <p class="mb-1"><strong>Plan:</strong> @Model.Licencia.NombrePlan</p>
                                <p class="mb-1"><strong>Estado:</strong> @Model.Licencia.Estado</p>
                                <p class="mb-1"><strong>Inicio:</strong> @Model.Licencia.FechaInicio.ToString("yyyy-MM-dd")</p>
                                <p class="mb-3"><strong>Fin:</strong> @Model.Licencia.FechaFin.ToString("yyyy-MM-dd")</p>
                            }
                            else
                            {
                                <div class="alert alert-warning">Esta empresa no tiene licencia registrada.</div>
                            }

                            <form asp-action="CambiarPlan" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idEmpresa" value="@Model.Empresa.IdEmpresa" />

                                <label class="form-label">Cambiar plan</label>
                                <div class="input-group">
                                    <select name="idPlan" class="form-select">
                                        @foreach (var plan in Model.Planes)
                                        {
                                            <option value="@plan.IdPlan">@plan.NombrePlan</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-primary">
                                        Cambiar
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Resumen</h5>

                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h4 class="fw-bold mb-0">@Model.Sedes.Count</h4>
                                        <small>Sedes</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h4 class="fw-bold mb-0">@Model.Pdvs.Count</h4>
                                        <small>PDV</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <h4 class="fw-bold mb-0">@Model.Empleados.Count</h4>
                                        <small>Usuarios</small>
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <p class="text-muted mb-0">
                                Desde este panel puedes validar la configuración inicial del cliente y realizar cambios importantes.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">

                    <ul class="nav nav-tabs" id="configClienteTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="tab-sedes"
                                    data-bs-toggle="tab"
                                    data-bs-target="#panel-sedes"
                                    type="button"
                                    role="tab">
                                <i class="fas fa-building me-1"></i> Sedes
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="tab-pdv"
                                    data-bs-toggle="tab"
                                    data-bs-target="#panel-pdv"
                                    type="button"
                                    role="tab">
                                <i class="fas fa-cash-register me-1"></i> Puntos de venta
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="tab-empleados"
                                    data-bs-toggle="tab"
                                    data-bs-target="#panel-empleados"
                                    type="button"
                                    role="tab">
                                <i class="fas fa-users me-1"></i> Empleados
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="tab-crear-modulo"
                                    data-bs-toggle="tab"
                                    data-bs-target="#panel-crear-modulo"
                                    type="button"
                                    role="tab">
                                <i class="fas fa-plus-circle me-1"></i> Agregar módulo
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="tab-modulos"
                                    data-bs-toggle="tab"
                                    data-bs-target="#panel-modulos"
                                    type="button"
                                    role="tab">
                                <i class="fas fa-th-large me-1"></i> Administrar módulos
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-4" id="configClienteTabsContent">

                        <div class="tab-pane fade show active" id="panel-sedes" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Sedes registradas</h5>
                                <span class="text-muted small" data-counter="tablaSedes"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-5">
                                    <input id="buscarSedes"
                                           class="form-control"
                                           placeholder="Buscar por nombre de sede o ciudad..." />
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="tablaSedes" class="table table-striped table-hover table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Sede</th>
                                            <th>Ciudad</th>
                                            <th>Dirección</th>
                                            <th>Teléfono</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sede in Model.Sedes)
                                        {
                                            <tr>
                                                <td>@sede.IdSede</td>
                                                <td>@sede.NombreSede</td>
                                                <td>@sede.Ciudad</td>
                                                <td>@sede.Direccion</td>
                                                <td>@sede.Telefono</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="panel-pdv" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Puntos de venta</h5>
                                <span class="text-muted small" data-counter="tablaPdvs"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-5">
                                    <input id="buscarPdvs"
                                           class="form-control"
                                           placeholder="Buscar por nombre de PDV o sede..." />
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="tablaPdvs" class="table table-striped table-hover table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID PDV</th>
                                            <th>Nombre PDV</th>
                                            <th>Sede</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pdv in Model.Pdvs)
                                        {
                                            <tr>
                                                <td>@pdv.IdInfoPdv</td>
                                                <td>@pdv.NombreInfoPdv</td>
                                                <td>@pdv.NombreSede</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="panel-empleados" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Empleados vinculados</h5>
                                <span class="text-muted small" data-counter="tablaEmpleados"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-5">
                                    <input id="buscarEmpleados"
                                           class="form-control"
                                           placeholder="Buscar por cédula, cargo, nombre o sede..." />
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="tablaEmpleados" class="table table-striped table-hover table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Cédula</th>
                                            <th>Nombre</th>
                                            <th>Correo</th>
                                            <th>Celular</th>
                                            <th>Cargo</th>
                                            <th>Sede</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var empleado in Model.Empleados)
                                        {
                                            <tr>
                                                <td>@empleado.Cedula</td>
                                                <td>@empleado.NombreCompleto</td>
                                                <td>@empleado.Correo</td>
                                                <td>@empleado.Celular</td>
                                                <td>@empleado.Cargo</td>
                                                <td>@empleado.Sede</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="panel-crear-modulo" role="tabpanel">
                            <h5 class="fw-bold mb-3">Agregar nuevo módulo</h5>

                            <form asp-action="CrearModulo" method="post" class="row g-3">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="IdEmpresa" value="@Model.Empresa?.IdEmpresa" />

                                <div class="col-md-12">
                                    <div class="alert alert-info mb-0">
                                        El módulo se crea en <strong>Modulos</strong> y su ubicación en el menú se configura en <strong>MenuOpciones</strong>.
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <h6 class="fw-bold border-bottom pb-2">Datos del módulo</h6>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Nombre del módulo</label>
                                    <input name="NombreModulo" class="form-control" placeholder="Ej: Ventas POS" />
                                </div>

                                <div class="col-md-5">
                                    <label class="form-label">Descripción</label>
                                    <input name="Descripcion" class="form-control" placeholder="Descripción del módulo" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Tipo de módulo</label>

                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="EsGenerico" value="true" id="chkGenerico">
                                        <label class="form-check-label" for="chkGenerico">
                                            Genérico
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="EsEspecializado" value="true" id="chkEspecializado">
                                        <label class="form-check-label" for="chkEspecializado">
                                            Especializado
                                        </label>
                                    </div>
                                </div>

                                <div class="col-md-12 mt-3">
                                    <h6 class="fw-bold border-bottom pb-2">Ubicación en el menú principal</h6>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Header</label>
                                    <input name="Header"
                                           class="form-control"
                                           placeholder="Ej: MODULO ADMINISTRATIVO" />
                                    <small class="text-muted">Sección principal del menú.</small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Grupo</label>
                                    <input name="Grupo"
                                           class="form-control"
                                           placeholder="Ej: Parametrizacion Empresa" />
                                    <small class="text-muted">Grupo interno donde aparecerá la opción.</small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Controller</label>
                                    <input name="Controller"
                                           class="form-control"
                                           placeholder="Ej: Usuario" />
                                    <small class="text-muted">Controlador MVC sin la palabra Controller.</small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Action</label>
                                    <input name="Action"
                                           class="form-control"
                                           placeholder="Ej: Cargos" />
                                    <small class="text-muted">Acción del controlador.</small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Icono Header</label>
                                    <input name="IconoHeader"
                                           class="form-control"
                                           placeholder="Ej: fas fa-building, fas fa-users, fas fa-cash-register" />
                                    <small class="text-muted">
                                        Código del ícono principal del módulo.
                                    </small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Icono Grupo</label>
                                    <input name="IconoGrupo"
                                           class="form-control"
                                           placeholder="Ej: fas fa-building, fas fa-boxes, fas fa-file-invoice" />
                                    <small class="text-muted">
                                        Código del ícono del grupo.
                                    </small>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Icono Opción</label>
                                    <input name="IconoOpcion"
                                           class="form-control"
                                           placeholder="Ej: far fa-circle, fas fa-angle-right, fas fa-dot-circle" />
                                    <small class="text-muted">
                                        Código del ícono de la opción del menú.
                                    </small>
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">Orden Header</label>
                                    <input name="OrdenHeader"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="Ej: 1" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">Orden Grupo</label>
                                    <input name="OrdenGrupo"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="Ej: 1" />
                                </div>

                                <div class="col-md-2">
                                    <label class="form-label">Orden Opción</label>
                                    <input name="OrdenOpcion"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="Ej: 1" />
                                </div>

                                <div class="col-md-12 mt-3">
                                    <h6 class="fw-bold border-bottom pb-2">Asignación del módulo</h6>
                                </div>

                                <div class="col-md-4">
                                    <div class="border rounded p-3 h-100">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="AgregarAlPlan" value="true" id="chkAgregarPlan">
                                            <label class="form-check-label fw-semibold" for="chkAgregarPlan">
                                                Agregar al plan
                                            </label>
                                        </div>

                                        <select name="IdPlan" class="form-select">
                                            <option value="">Seleccione un plan...</option>
                                            @foreach (var plan in Model.Planes)
                                            {
                                                <option value="@plan.IdPlan">@plan.NombrePlan</option>
                                            }
                                        </select>

                                        <small class="text-muted">
                                            Se guardará en PlanesModulos.
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="border rounded p-3 h-100">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="AgregarAEmpresaActual" value="true" id="chkAgregarEmpresa">
                                            <label class="form-check-label fw-semibold" for="chkAgregarEmpresa">
                                                Activar para esta empresa
                                            </label>
                                        </div>

                                        <input class="form-control" value="@Model.Empresa?.IdEmpresa" readonly />

                                        <small class="text-muted">
                                            Se guardará en ModulosEmpresa como módulo adicional.
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="border rounded p-3 h-100">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="AgregarAActividadEconomica" value="true" id="chkAgregarActividad">
                                            <label class="form-check-label fw-semibold" for="chkAgregarActividad">
                                                Agregar a actividad económica
                                            </label>
                                        </div>

                                        <select name="IdActividad" class="form-select">
                                            <option value="">Seleccione actividad...</option>
                                            @foreach (var actividad in Model.ActividadesEconomicas)
                                            {
                                                <option value="@actividad.IdActividad">@actividad.NombreActividad</option>
                                            }
                                        </select>

                                        <small class="text-muted">
                                            Se guardará en ModulosActividadEconomica.
                                        </small>
                                    </div>
                                </div>

                                <div class="col-md-12 text-end">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-plus me-1"></i> Crear módulo y opción de menú
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="panel-modulos" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0">Administración de módulos</h5>
                                <span class="text-muted small" data-counter="tablaModulos"></span>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-5">
                                    <input id="buscarModulos"
                                           class="form-control"
                                           placeholder="Buscar por módulo, genérico, especializado, activo o inactivo..." />
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table id="tablaModulos" class="table table-striped table-hover table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Módulo</th>
                                            <th>Descripción</th>
                                            <th>Tipo</th>
                                            <th>Estado</th>
                                            <th class="text-end">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var modulo in Model.ModulosDisponibles)
                                        {
                                            var tipoTexto = "";

                                            if (modulo.EsGenerico)
                                            {
                                                tipoTexto += " Generico";
                                            }

                                            if (modulo.EsEspecializado)
                                            {
                                                tipoTexto += " Especializado";
                                            }

                                            var estadoTexto = modulo.ActivoParaCliente ? "Activo" : "Inactivo";

                                            <tr>
                                                <td>
                                                    <strong>@modulo.NombreModulo</strong>
                                                </td>

                                                <td>@modulo.Descripcion</td>

                                                <td>
                                                    <span class="d-none">@tipoTexto</span>

                                                    @if (modulo.EsGenerico)
                                                    {
                                                        <span class="badge bg-primary">Genérico</span>
                                                    }

                                                    @if (modulo.EsEspecializado)
                                                    {
                                                        <span class="badge bg-warning text-dark">Especializado</span>
                                                    }
                                                </td>

                                                <td>
                                                    <span class="d-none">@estadoTexto</span>

                                                    @if (modulo.ActivoParaCliente)
                                                    {
                                                        <span class="badge bg-success">Activo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactivo</span>
                                                    }
                                                </td>

                                                <td class="text-end">
                                                    @if (modulo.ActivoParaCliente)
                                                    {
                                                        <form asp-action="DesactivarModulo" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="idEmpresa" value="@Model.Empresa.IdEmpresa" />
                                                            <input type="hidden" name="idModulo" value="@modulo.IdModulo" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                Desactivar
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="ActivarModulo" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="idEmpresa" value="@Model.Empresa.IdEmpresa" />
                                                            <input type="hidden" name="idModulo" value="@modulo.IdModulo" />
                                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                                Activar
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        function configurarTablaConBuscador(inputId, tableId, maxRows = 10) {
            const input = document.getElementById(inputId);
            const table = document.getElementById(tableId);

            if (!input || !table) return;

            const tbody = table.querySelector("tbody");
            if (!tbody) return;

            const rows = Array.from(tbody.querySelectorAll("tr"));

            function aplicarFiltro() {
                const filtro = input.value.toLowerCase().trim();
                let visibles = 0;

                rows.forEach(row => {
                    const texto = row.innerText.toLowerCase();
                    const coincide = texto.includes(filtro);

                    if (coincide && visibles < maxRows) {
                        row.style.display = "";
                        visibles++;
                    } else {
                        row.style.display = "none";
                    }
                });

                const contador = document.querySelector(`[data-counter='${tableId}']`);

                if (contador) {
                    const totalCoincidencias = rows.filter(row =>
                        row.innerText.toLowerCase().includes(filtro)
                    ).length;

                    contador.innerText = `Mostrando ${Math.min(visibles, totalCoincidencias)} de ${totalCoincidencias} resultados`;
                }
            }

            input.addEventListener("input", aplicarFiltro);
            aplicarFiltro();
        }

        document.addEventListener("DOMContentLoaded", function () {
            configurarTablaConBuscador("buscarSedes", "tablaSedes", 10);
            configurarTablaConBuscador("buscarPdvs", "tablaPdvs", 10);
            configurarTablaConBuscador("buscarEmpleados", "tablaEmpleados", 10);
            configurarTablaConBuscador("buscarModulos", "tablaModulos", 10);
        });
    </script>
}