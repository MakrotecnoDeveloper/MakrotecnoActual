@model List<Plataforma.ViewModels.Cotizacion.CotizacionIndexVm>

@{
    ViewData["Title"] = "Cotizaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string estado = ViewBag.Estado as string ?? "";
    string buscar = ViewBag.Buscar as string ?? "";
}

<div class="content-wrapper">
    <div class="container py-4">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h3 class="mb-1 fw-semibold">
                    <i class="bi bi-file-earmark-text"></i> Cotizaciones
                </h3>
                <div class="text-muted">
                    Gestión y seguimiento de cotizaciones comerciales.
                </div>
            </div>

            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nueva cotización
            </a>
        </div>

        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">Buscar</label>
                        <input type="text" name="buscar" value="@buscar" class="form-control"
                               placeholder="Número, cliente o teléfono" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label">Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="Pendiente" selected="@(estado == "Pendiente")">Pendiente</option>
                            <option value="EnSeguimiento" selected="@(estado == "EnSeguimiento")">En seguimiento</option>
                            <option value="Aceptada" selected="@(estado == "Aceptada")">Aceptada</option>
                            <option value="Rechazada" selected="@(estado == "Rechazada")">Rechazada</option>
                            <option value="ConvertidaVenta" selected="@(estado == "ConvertidaVenta")">Convertida a venta</option>
                            <option value="Anulada" selected="@(estado == "Anulada")">Anulada</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-5 d-flex gap-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-search"></i> Filtrar
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Limpiar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body table-responsive">

                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Número</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Vencimiento</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NumeroCotizacion</td>
                                    <td>@item.NombreCliente</td>
                                    <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @(item.FechaVencimiento.HasValue
                                                                        ? item.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                                                        : "Sin vencimiento")
                            </td>
                            <td>
                                @switch (item.EstadoCotizacion)
                                        {
                                            case "Pendiente":
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                                break;
                                            case "EnSeguimiento":
                                                <span class="badge bg-info text-dark">En seguimiento</span>
                                                break;
                                            case "Aceptada":
                                                <span class="badge bg-primary">Aceptada</span>
                                                break;
                                            case "Rechazada":
                                                <span class="badge bg-danger">Rechazada</span>
                                                break;
                                            case "ConvertidaVenta":
                                                <span class="badge bg-success">Convertida a venta</span>
                                                break;
                                            case "Anulada":
                                                <span class="badge bg-secondary">Anulada</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark border">@item.EstadoCotizacion</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @item.Total.ToString("C0", new System.Globalization.CultureInfo("es-CO"))
                                    </td>
                                    <td>
                                        <a asp-action="Detalle" asp-route-id="@item.IdCotizacion"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Imprimir"
                                           asp-route-id="@item.IdCotizacion"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-printer"></i>
                                        </a>

                                        @if (item.EstadoCotizacion != "ConvertidaVenta"
                                                                        && item.EstadoCotizacion != "Rechazada"
                                                                        && item.EstadoCotizacion != "Anulada")
                                        {
                                            <a asp-action="ConvertirVenta" asp-route-id="@item.IdCotizacion"
                                               class="btn btn-sm btn-success">
                                                <i class="bi bi-cart-check"></i>
                                            </a>
                                        }

                                        @if (item.IdVentaGenerada.HasValue)
                                        {
                                            <a asp-controller="Pedido"
                                               asp-action="DetalleVenta"
                                               asp-route-idVenta="@item.IdVentaGenerada.Value"
                                               class="btn btn-sm btn-dark">
                                                Venta
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No hay cotizaciones registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>