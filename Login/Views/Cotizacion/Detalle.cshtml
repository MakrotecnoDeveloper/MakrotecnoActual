@model Plataforma.ViewModels.Cotizacion.CotizacionDetalleVm

@{
    ViewData["Title"] = "Detalle cotización";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container py-4">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h3 class="mb-1 fw-semibold">
                    Cotización @Model.NumeroCotizacion
                </h3>
                <div class="text-muted">
                    Cliente: @Model.NombreCliente
                </div>
            </div>

            <a asp-action="Imprimir"
               asp-route-id="@Model.IdCotizacion"
               target="_blank"
               class="btn btn-outline-secondary">
                <i class="bi bi-printer"></i> Imprimir
            </a>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>

                @if (Model.EstadoCotizacion != "ConvertidaVenta"
                                && Model.EstadoCotizacion != "Rechazada"
                                && Model.EstadoCotizacion != "Anulada")
                {
                    <a asp-action="ConvertirVenta" asp-route-id="@Model.IdCotizacion" class="btn btn-success">
                        <i class="bi bi-cart-check"></i> Convertir a venta
                    </a>
                }

                @if (Model.IdVentaGenerada.HasValue)
                {
                    <a asp-controller="Pedido"
                       asp-action="DetalleVenta"
                       asp-route-idVenta="@Model.IdVentaGenerada.Value"
                       class="btn btn-dark">
                        Ver venta
                    </a>
                }
            </div>
        </div>

        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success">@TempData["Ok"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="row g-3">

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Información</h5>

                        <p class="mb-1"><strong>Estado:</strong> @Model.EstadoCotizacion</p>
                        <p class="mb-1"><strong>Fecha creación:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>

                        <p class="mb-1">
                            <strong>Vencimiento:</strong>
                            @(Model.FechaVencimiento.HasValue? Model.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "Sin vencimiento")
                        </p>

                        @if (Model.FechaAceptacion.HasValue)
                        {
                            <p class="mb-1"><strong>Aceptada:</strong> @Model.FechaAceptacion.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        }

                        @if (Model.FechaRechazo.HasValue)
                        {
                            <p class="mb-1"><strong>Rechazada:</strong> @Model.FechaRechazo.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        }

                        @if (Model.FechaConversionVenta.HasValue)
                        {
                            <p class="mb-1"><strong>Convertida:</strong> @Model.FechaConversionVenta.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ObservacionGeneral))
                        {
                            <hr />
                            <p class="mb-0">
                                <strong>Observación:</strong><br />
                                @Model.ObservacionGeneral
                            </p>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Cliente</h5>

                        <p class="mb-1"><strong>Nombre:</strong> @Model.NombreCliente</p>
                        <p class="mb-1"><strong>Documento:</strong> @Model.CedulaCliente</p>
                        <p class="mb-1"><strong>Teléfono:</strong> @Model.TelefonoCliente</p>
                        <p class="mb-1"><strong>Correo:</strong> @Model.CorreoCliente</p>
                        <p class="mb-0"><strong>Dirección:</strong> @Model.DireccionCliente</p>
                    </div>
                </div>

                @if (Model.EstadoCotizacion != "ConvertidaVenta" && Model.EstadoCotizacion != "Anulada")
                {
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h5 class="fw-semibold mb-3">Registrar seguimiento</h5>

                            <form asp-action="RegistrarSeguimiento" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="IdCotizacion" value="@Model.IdCotizacion" />

                                <div class="mb-3">
                                    <label class="form-label">Nuevo estado</label>
                                    <select name="EstadoNuevo" class="form-select" required>
                                        <option value="">Seleccione...</option>
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="EnSeguimiento">En seguimiento</option>
                                        <option value="Aceptada">Aceptada</option>
                                        <option value="Rechazada">Rechazada</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Observación</label>
                                    <textarea name="Observacion" class="form-control" rows="4" required
                                          placeholder="Ej: cliente indica que confirma mañana, solicita descuento, no continúa, etc."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-chat-left-text"></i> Guardar seguimiento
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Productos cotizados</h5>

                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Producto</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">Valor</th>
                                        <th class="text-end">IVA</th>
                                        <th class="text-end">Total</th>
                                        <th>Incluido</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Detalles)
                                    {
                                        <tr>
                                            <td>@item.CodigoProducto</td>
                                            <td>@item.NombreProducto</td>
                                            <td class="text-end">@item.Cantidad</td>
                                            <td class="text-end">@item.ValorVenta.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                            <td class="text-end">@item.IvaValor.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                            <td class="text-end fw-semibold">@item.TotalLinea.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                            <td>
                                                @if (item.IncluidoEnVenta)
                                                {
                                                    <span class="badge bg-success">Sí</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row justify-content-end">
                            <div class="col-12 col-md-5">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Subtotal</th>
                                        <td class="text-end">@Model.Subtotal.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                    </tr>
                                    <tr>
                                        <th>IVA</th>
                                        <td class="text-end">@Model.IvaTotal.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                    </tr>
                                    <tr>
                                        <th>Descuento</th>
                                        <td class="text-end">@Model.Descuento.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                    </tr>
                                    <tr class="table-dark">
                                        <th>Total</th>
                                        <td class="text-end">@Model.Total.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-semibold mb-3">Histórico de seguimiento</h5>

                        @if (Model.Seguimientos.Any())
                        {
                            <div class="list-group">
                                @foreach (var seg in Model.Seguimientos)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <strong>@seg.EstadoAnterior → @seg.EstadoNuevo</strong>
                                            <span class="text-muted small">@seg.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>

                                        <div class="mt-2">@seg.Observacion</div>

                                        <div class="text-muted small mt-1">
                                            Usuario: @(seg.UsuarioRegistro ?? "sistema")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">No hay seguimientos registrados.</div>
                        }
                    </div>
                </div>
            </div>

        </div>

        @if (Model.EstadoCotizacion != "ConvertidaVenta" && Model.EstadoCotizacion != "Anulada")
        {
            <form asp-action="Anular" asp-route-id="@Model.IdCotizacion" method="post" class="mt-3"
                  onsubmit="return confirm('¿Está seguro de anular esta cotización?');">
                @Html.AntiForgeryToken()

                <input type="hidden" name="observacion" value="Cotización anulada desde el detalle." />

                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle"></i> Anular cotización
                </button>
            </form>
        }

    </div>
</div>