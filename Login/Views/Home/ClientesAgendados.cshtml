@model List<Agendamientos>
@{
    ViewData["Title"] = "ClientesAgendados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<div class="content-wrapper">
    <h2 class="mt-4 mb-4">Clientes Agendados</h2>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Cod_Producto</th>
                    <th>Fecha</th>
                    <th>Nombre Cliente</th>
                    <th>Celular</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Cod_Producto</td>
                        <td>@item.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.NombreCliente</td>
                        <td>@item.CelularCliente</td>
                        <td>@item.Estado</td>
                        <td>
                            <button class="btn btn-success btn-sm" title="Aprobar" onclick="aprobarServicio(@item.Id)">
                                <i class="fas fa-check"></i>
                            </button>
                            <button class="btn btn-primary btn-sm" title="Editar" onclick="abrirModalEditar(@item.Id)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" title="Eliminar" onclick="eliminarServicio(@item.Id)">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="modalEditarServicio" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" id="modalBodyEditarServicio">
                <!-- Aquí se carga _EditarServicioPartial.cshtml -->
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).on("submit", "#formEditarServicio", function (e) {
            e.preventDefault();

            var form = $(this);
            $.ajax({
                url: '/Inicio/GuardarEdicion',
                method: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        alert(response.mensaje);
                        $("#modalEditarServicio").modal('hide');
                        location.reload();
                    } else {
                        alert(response.mensaje);
                    }
                },
                error: function () {
                    alert("Error al guardar la edición.");
                }
            });
        });

        function abrirModalEditar(idServicio) {
            $.ajax({
                url: '/Inicio/EditarServicio',
                type: 'GET',
                data: { id: idServicio },
                success: function (html) {
                    $("#modalBodyEditarServicio").html(html);
                    $("#modalEditarServicio").modal('show');
                }
            });
        }

        function aprobarServicio(idServicio) {
            if (confirm("¿Estás seguro de aprobar este servicio?")) {
                $.post('/Inicio/AprobarServicio', { id: idServicio }, function (response) {
                    alert(response.mensaje);
                    if (response.success) {
                        location.reload();
                    }
                });
            }
        }

        function eliminarServicio(idServicio) {
            if (confirm("¿Estás seguro de eliminar este servicio? Esta acción no se puede deshacer.")) {
                $.post('/Inicio/EliminarServicio', { id: idServicio }, function (response) {
                    alert(response.mensaje);
                    if (response.success) {
                        location.reload();
                    }
                });
            }
        }
    </script>
}