@model Plataforma.Helpers.HomeListView
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_LayoutInfo.cshtml";
    string version = DateTime.Now.ToString();

    var listPromo = Model.listPromociones;
    var listProductos = Model.listProductos;
}

<!-- Header-->
<header class="bg-dark py-5">
    <div class="container ">
        <div class="text-center text-white ">

            <section class="splide" aria-label="Splide Basic HTML Example">
                <div class="splide__track">
                    <ul class="splide__list">
                        @foreach (var item in listPromo)
                        {
                            
                            <li class="splide__slide">
                                <img class="card-img-top"
                                     src='https://dummyimage.com/1920x1080/@(item.NombreArchivo.Trim())/61x757d.jpg'
                                     alt="@item.NombreArchivo" />
                            </li>
                        }
                    </ul>
                </div>
            </section>

        </div>
    </div>
</header>

<!-- Section-->
<section class="py-5">
    <div class="container px-4 px-lg-5 mt-5">
        <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">

            @foreach (var item in listProductos)
            {
                <div class="col mb-5">
                    <div class="card h-100">
                        <!-- Product image-->
                        <img class="card-img-top" src="https://dummyimage.com/640x480/828282/fff&text=+Producto" alt="@item.Cod_Producto" />
                        <!-- Product details-->
                        <div class="card-body p-4">
                            <div class="text-center">
                                <!-- Product name-->
                                <h5 class="fw-bolder">@item.NombreProducto</h5>
                                <!-- Product reviews-warnings -->
                                <div class="d-flex justify-content-center small text-warning mb-2">
                                    <div class="bi-star-fill">Prueba-warning</div>
                                </div>
                                <!-- Product price line-midle -->
                                <span class="text-danger text-decoration-line-through">
                                    @item.ValorNetoProducto.ToString("C2")
                                </span>
                                 <span class="text-green text-decoration-underline">
                                    @item.ValorNetoProducto.ToString("C2")
                                </span> 
                            </div>
                        </div>
                        <!-- Product actions-->
                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">Add to cart</a></div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</section>

