@model IReadOnlyList<Servicio>
@{
    Layout = null;

    // Obtiene la imagen del servicio sin depender del nombre exacto de la propiedad
    string GetServicioImgUrl(object s)
    {
        if (s == null) return null;

        var t = s.GetType();
        string[] props = { "ImagenUrl", "ImageUrl", "UrlImagen", "Imagen", "FotoUrl", "ImagenServicio", "RutaImagen" };

        foreach (var p in props)
        {
            var pi = t.GetProperty(p);
            if (pi == null) continue;
            var val = pi.GetValue(s)?.ToString();
            if (!string.IsNullOrWhiteSpace(val)) return val;
        }
        return null;
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <title>Makrotecno - Soluciones tecnológicas a la medida</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Makrotecno es una empresa especializada en el desarrollo de plataformas web, software personalizado, soporte técnico a empresas y venta de accesorios para celular y computadores." />
    <meta name="author" content="Equipo Makrotecno" />
    <meta name="keywords" content="Makrotecno, desarrollo web, software, tecnología, soporte técnico, soluciones tecnológicas, cargadores, audífonos, cables de datos, adaptadores, netflix, amazon" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- ✅ CSS separado -->
