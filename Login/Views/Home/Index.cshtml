                        </div>
                    </div>
                </div>
                <div class="bg-dark text-center py-3 mt-3">
                    <small>&copy; 2024 Makro Tecno. Todos los derechos reservados.</small>
                </div>
            </footer>
            <!-- FIN FOOTER-->
        </div>
    </div>
    </div>
</body>
</html>
