                    <a class="btnx" href="#portfServicios"><i class="fas fa-briefcase"></i> Portafolio</a>
                    <a class="btnx" href="#contacto"><i class="fas fa-envelope"></i> Contacto</a>

                    <!-- Portal discreto -->
                    <a class="btnx portal" asp-controller="Home" asp-action="Login">
                        <i class="fas fa-sign-in-alt"></i> Portal
                    </a>

                    <a class="btnx cta" href="#portfServicios"><i class="fas fa-bolt"></i> Ver servicios</a>
                </nav>

