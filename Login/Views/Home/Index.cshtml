                <a href="#nosotros"><i class="fas fa-users me-2"></i> Nosotros</a>
                <a href="#portfServicios"><i class="fas fa-briefcase me-2"></i> Portafolio</a>
                <a href="#contacto"><i class="fas fa-envelope me-2"></i> Contacto</a>
