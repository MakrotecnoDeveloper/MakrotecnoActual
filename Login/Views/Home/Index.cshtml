                            <ul class="list-unstyled">
                                <li>
                                    <a href="#!" class="text-white">Footer Link 1</a>
                                </li>
                                <li>
                                    <a href="#!" class="text-white">Footer Link 2</a>
                                </li>
                                <li>
                                    <a href="#!" class="text-white">Footer Link 3</a>
                                </li>
                                <li>
                                    <a href="#!" class="text-white">Footer Link 4</a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                            <h5 class="text-uppercase">Contacto</h5>
                            <p>
                                Dirección: Calle 33E # 25-11<br>
                                Teléfono: +57 318 531 3379<br>
                                Email: makrotecnocomercio@gmail.com
                            </p>
                        </div>
                        <div class="col-lg-4 col-md-12 mb-4 mb-md-0">
