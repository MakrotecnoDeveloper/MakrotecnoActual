@model Plataforma.Models.ProductosCategoriaViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda MakroTecno</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            min-height: 100vh;
            background: #f4f6f8;
            color: #333;
        }

        .sidebar {
            width: 260px;
            background: #1a1d23;
            color: #fff;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .sidebar h2 {
                font-size: 18px;
                margin-bottom: 10px;
                color: #00c2ff;
            }

            .sidebar label {
                font-size: 13px;
                margin-top: 10px;
                margin-bottom: 4px;
                display: block;
            }

            .sidebar select,
            .sidebar input[type="number"] {
                width: 100%;
                padding: 8px;
                border-radius: 6px;
                border: 1px solid #444;
                background: #252a33;
                color: #fff;
                font-size: 14px;
            }

                .sidebar input[type="number"]::placeholder {
                    color: #aaa;
                }

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }

            .topbar h1 {
                flex: 1;
                text-align: center;
            }

            .topbar input {
                width: 350px;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 8px;
                font-size: 15px;
            }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background: #fff;
            padding: 15px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.2s;
            display: flex;
            flex-direction: column;
        }

            .card:hover {
                transform: translateY(-3px);
            }

            .card img {
                width: 100%;
                height: 130px;
                object-fit: cover;
                border-radius: 10px;
                margin-bottom: 10px;
            }

            .card h3 {
                font-size: 16px;
                margin-bottom: 5px;
                color: #222;
                min-height: 40px;
            }

            .card p {
                font-size: 14px;
                color: #555;
                margin-bottom: 3px;
            }

            .card .price {
                font-weight: 700;
                margin-top: 4px;
            }

        .stock {
            margin-top: 6px;
            font-weight: 600;
        }

            .stock.ok {
                color: green;
            }

            .stock.low {
                color: orange;
            }

            .stock.none {
                color: red;
            }

        .product-actions {
            margin-top: 12px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            border: none;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            font-size: 16px;
        }

            .action-btn.whatsapp {
                background: #25D366;
                color: white;
            }

            .action-btn.view {
                background: #0d6efd;
                color: white;
            }

            .action-btn.cart {
                background: #ff9800;
                color: white;
            }

            .action-btn:hover {
                transform: translateY(-2px) scale(1.05);
                opacity: 0.92;
            }

            .action-btn.disabled {
                background: #ccc !important;
                color: #666 !important;
                cursor: not-allowed;
                pointer-events: none;
            }

        .pagination {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            gap: 15px;
        }

            .pagination button {
                background: #1a1d23;
                color: white;
                border: none;
                padding: 8px 16px;
                border-radius: 6px;
                cursor: pointer;
                transition: background 0.2s;
            }

                .pagination button:hover {
                    background: #00c2ff;
                    color: black;
                }

                .pagination button:disabled {
                    opacity: 0.5;
                    cursor: not-allowed;
                }

            .pagination span {
                display: flex;
                align-items: center;
                color: #333;
            }

        .cart-float {
            position: fixed;
            right: 25px;
            bottom: 25px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            background: #1a1d23;
            color: white;
            font-size: 22px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            z-index: 1000;
        }

        .cart-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 22px;
            height: 22px;
            background: #e53935;
            color: white;
            border-radius: 50%;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 5px;
        }

        .custom-modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 20px;
        }

            .custom-modal-backdrop.show {
                display: flex;
            }

        .custom-modal {
            width: 100%;
            max-width: 520px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.25);
            overflow: hidden;
        }

        .custom-modal-header {
            background: #1a1d23;
            color: white;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .custom-modal-body {
            padding: 20px;
        }

        .custom-modal-footer {
            padding: 15px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            border-top: 1px solid #eee;
        }

        .modal-close-btn {
            border: none;
            background: transparent;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .modal-input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            margin-top: 6px;
        }

        .btn-primary-custom,
        .btn-secondary-custom,
        .btn-success-custom,
        .btn-danger-custom {
            border: none;
            padding: 10px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-primary-custom {
            background: #0d6efd;
            color: white;
        }

        .btn-secondary-custom {
            background: #e9ecef;
            color: #333;
        }

        .btn-success-custom {
            background: #25D366;
            color: white;
        }

        .btn-danger-custom {
            background: #dc3545;
            color: white;
        }

        .cart-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 340px;
            overflow-y: auto;
        }

        .cart-item {
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 12px;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
        }

        .cart-item-info {
            flex: 1;
        }

            .cart-item-info h4 {
                font-size: 15px;
                margin-bottom: 4px;
            }

            .cart-item-info p {
                font-size: 13px;
                color: #666;
            }

        .cart-item-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cart-item-actions input {
                width: 70px;
                padding: 6px 8px;
                border-radius: 8px;
                border: 1px solid #ccc;
                text-align: center;
            }

        .empty-cart {
            text-align: center;
            color: #777;
            padding: 25px 10px;
        }

        .cart-summary {
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid #eee;
            font-size: 14px;
            color: #333;
        }

        @@media (max-width: 900px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
            }

            .topbar {
                flex-direction: column;
                align-items: stretch;
            }

                .topbar h1 {
                    text-align: left;
                }

                .topbar input {
                    width: 100%;
                }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <h2>Filtros</h2>

        <label for="categorySelect">Categoría</label>
        <select id="categorySelect" onchange="applyFilters()"></select>

        <label>Precio mínimo</label>
        <input type="number" id="minPrice" placeholder="Mínimo" oninput="applyFilters()" />

        <label>Precio máximo</label>
        <input type="number" id="maxPrice" placeholder="Máximo" oninput="applyFilters()" />

        <label for="estadoSelect">Estado</label>
        <select id="estadoSelect" onchange="applyFilters()">
            <option value="">Todos</option>
            <option value="Nuevo">Nuevo</option>
            <option value="Segunda">Segunda</option>
        </select>

        <label for="sedeSelect">Sede</label>
        <select id="sedeSelect" onchange="cambiarSede()">
            @foreach (var s in Model.Sedes)
            {
                <option value="@s.Id_sede" selected="@(s.Id_sede == Model.SedeSeleccionada)">
                    @s.NombreSede
                </option>
            }
        </select>
    </aside>

    <main class="main">
        <div class="topbar">
            <button onclick="location.href='@Url.Action("Index", "Home")'"
                    style="background:#1a1d23; color:white; border:none; padding:10px 16px; border-radius:8px; cursor:pointer; font-size:14px;">
                ⬅ Devolver
            </button>

            <h1>Tienda</h1>

            <input type="text" id="searchInput" placeholder="Buscar por nombre o código..." oninput="searchProducts()">
        </div>

        <div id="grid" class="grid"></div>

        <div class="pagination">
            <button id="prevBtn" onclick="prevPage()">Anterior</button>
            <span id="pageInfo">Página 1</span>
            <button id="nextBtn" onclick="nextPage()">Siguiente</button>
        </div>
    </main>

    <button class="cart-float" onclick="abrirModalCarrito()" title="Ver carrito">
        <i class="fas fa-cart-shopping"></i>
        <span class="cart-badge" id="cartBadge">0</span>
    </button>

    <div class="custom-modal-backdrop" id="modalAgregarCarrito">
        <div class="custom-modal">
            <div class="custom-modal-header">
                <h3>Agregar al carrito</h3>
                <button class="modal-close-btn" onclick="cerrarModalAgregar()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="custom-modal-body">
                <input type="hidden" id="modalCodigoProducto" />
                <input type="hidden" id="modalNombreProducto" />
                <input type="hidden" id="modalPrecioProducto" />
                <input type="hidden" id="modalStockDisponible" />

                <div style="margin-bottom:12px;">
                    <strong id="modalTituloProducto"></strong>
                    <p id="modalCodigoTexto" style="margin-top:6px; color:#666;"></p>
                    <p id="modalStockTexto" style="margin-top:4px; color:#666;"></p>
                </div>

                <label for="modalCantidad">Cantidad</label>
                <input type="number" id="modalCantidad" class="modal-input" min="1" value="1" />
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-secondary-custom" onclick="cerrarModalAgregar()">Cancelar</button>
                <button type="button" class="btn-primary-custom" onclick="confirmarAgregarCarrito()">Agregar</button>
            </div>
        </div>
    </div>

    <div class="custom-modal-backdrop" id="modalCarrito">
        <div class="custom-modal">
            <div class="custom-modal-header">
                <h3>Carrito de cotización</h3>
                <button class="modal-close-btn" onclick="cerrarModalCarrito()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="custom-modal-body">
                <div id="cartList" class="cart-list"></div>
                <div class="cart-summary" id="cartSummary"></div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-danger-custom" onclick="vaciarCarrito()">Vaciar</button>
                <button type="button" class="btn-secondary-custom" onclick="cerrarModalCarrito()">Cerrar</button>
                <button type="button" class="btn-success-custom" onclick="enviarCarritoPorWhatsapp()">Enviar a WhatsApp</button>
            </div>
        </div>
    </div>

    <script>
        const modelo = @Html.Raw(Json.Serialize(Model));

        const productos = modelo.productos || modelo.Productos || [];
        const categorias = modelo.categoriaProductos || modelo.CategoriaProductos || [];

        let currentPage = 1;
        const perPage = 20;
        let filteredData = [...productos];

        const CART_KEY = "makrotecno_tienda_carrito";
        let carrito = [];

        function guardarCarritoStorage() {
            localStorage.setItem(CART_KEY, JSON.stringify(carrito));
        }

        function cargarCarritoStorage() {
            const raw = localStorage.getItem(CART_KEY);
            if (!raw) {
                carrito = [];
                return;
            }

            try {
                carrito = JSON.parse(raw) || [];
            } catch {
                carrito = [];
            }
        }

        function renderCategorySelect() {
            const select = document.getElementById("categorySelect");
            if (!select) return;

            select.innerHTML = "";

            const optTodas = document.createElement("option");
            optTodas.value = "";
            optTodas.textContent = "Todas";
            select.appendChild(optTodas);

            categorias.forEach(c => {
                const opt = document.createElement("option");
                opt.value = c.idCateProducto ?? c.IdCateProducto ?? "";
                opt.textContent = c.descripcion ?? c.Descripcion ?? "Categoría";
                select.appendChild(opt);
            });
        }

        function formatCurrency(value) {
            if (value == null || isNaN(value)) return "";
            return Number(value).toLocaleString('es-CO', { style: 'currency', currency: 'COP' });
        }

        async function cargarProductos(page = 1, data = productos) {
            return new Promise((resolve) => {
                setTimeout(() => {
                    const start = (page - 1) * perPage;
                    const end = start + perPage;
                    resolve(data.slice(start, end));
                }, 80);
            });
        }

        async function mostrarProductos(lista) {
            const grid = document.getElementById("grid");
            grid.innerHTML = "";

            if (!lista || lista.length === 0) {
                grid.innerHTML = `
                    <div style="grid-column:1/-1; background:white; padding:30px; border-radius:12px; text-align:center; box-shadow:0 2px 8px rgba(0,0,0,0.08);">
                        No hay productos para mostrar con los filtros aplicados.
                    </div>
                `;
            } else {
                lista.forEach(p => {
                    const cantidad = Number(p.cantidadProducto ?? p.CantidadProducto ?? 0);
                    const codigoProducto = p.cod_Producto ?? p.codProducto ?? p.Codigo ?? "";
                    const nombreProducto = p.nombreProducto ?? p.NombreProducto ?? "Producto";
                    const condicionProducto = p.condicionProducto ?? p.CondicionProducto ?? "Nuevo";
                    const imagenPath = p.imagenPath ?? p.ImagenPath ?? "";
                    const valorVenta = Number(p.valorVentaProducto ?? p.precioVenta ?? p.PrecioVenta ?? 0);

                    const estadoStock = cantidad === 0 ? "none" : cantidad < 3 ? "low" : "ok";

                    const card = document.createElement("div");
                    card.className = "card";

                    const imagen = imagenPath && imagenPath.trim() !== ""
                        ? imagenPath
                        : "/img/Productos/nodisponible.png";

                    const textoStock = cantidad === 0 ? "Agotado" : `Disponible (${cantidad})`;

                    const mostrarWhatsapp = cantidad > 0;

                    const mensaje = `Hola, Estoy cotizando el producto ${nombreProducto} con el código ${codigoProducto}, requiero más información.`;
                    const whatsappUrl = `https://wa.me/573185313379?text=${encodeURIComponent(mensaje)}`;

                    const precioTexto = formatCurrency(valorVenta);

                    card.innerHTML = `
                        <img src="${imagen}" alt="${nombreProducto}"
                             onerror="this.onerror=null; this.src='/img/Productos/nodisponible.png';">
                        <h3>${nombreProducto}</h3>
                        <p>Código: ${codigoProducto}</p>
                        ${precioTexto ? `<p class="price">${precioTexto}</p>` : ""}
                        <p>Estado: ${condicionProducto}</p>
                        <p>Valor: ${precioTexto}</p>
                        <p class="stock ${estadoStock}">
                            ${textoStock}
                        </p>

                        <div class="product-actions">
                            ${
                                mostrarWhatsapp
                                    ? `<a href="${whatsappUrl}" target="_blank" class="action-btn whatsapp" title="Cotizar por WhatsApp">
                                            <i class="fab fa-whatsapp"></i>
                                       </a>`
                                    : `<span class="action-btn whatsapp disabled" title="Producto agotado">
                                            <i class="fab fa-whatsapp"></i>
                                       </span>`
                            }

                            <a href="/producto/ver/${encodeURIComponent(codigoProducto)}"
                               class="action-btn view"
                               title="Ver producto">
                                <i class="fas fa-eye"></i>
                            </a>

                            ${
                                cantidad > 0
                                    ? `<button type="button"
                                               class="action-btn cart"
                                               title="Agregar al carrito"
                                               onclick="abrirModalAgregar('${escapeJs(codigoProducto)}', '${escapeJs(nombreProducto)}', '${valorVenta}', '${cantidad}')">
                                            <i class="fas fa-cart-shopping"></i>
                                       </button>`
                                    : `<span class="action-btn cart disabled" title="Producto agotado">
                                            <i class="fas fa-cart-shopping"></i>
                                       </span>`
                            }
                        </div>
                    `;

                    grid.appendChild(card);
                });
            }

            const totalPages = Math.max(1, Math.ceil(filteredData.length / perPage));
            document.getElementById("pageInfo").textContent = `Página ${currentPage} de ${totalPages}`;
            document.getElementById("prevBtn").disabled = currentPage === 1;
            document.getElementById("nextBtn").disabled = currentPage >= totalPages;
        }

        async function updatePage() {
            const data = await cargarProductos(currentPage, filteredData);
            await mostrarProductos(data);
        }

        function nextPage() {
            const totalPages = Math.max(1, Math.ceil(filteredData.length / perPage));
            if (currentPage < totalPages) {
                currentPage++;
                updatePage();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                updatePage();
            }
        }

        function applyFilters() {
            const term = document.getElementById("searchInput").value.trim().toLowerCase();
            const selectedCat = document.getElementById("categorySelect").value;
            const estado = document.getElementById("estadoSelect").value;

            const minPriceVal = parseFloat(document.getElementById("minPrice").value);
            const maxPriceVal = parseFloat(document.getElementById("maxPrice").value);

            const minPrice = isNaN(minPriceVal) ? null : minPriceVal;
            const maxPrice = isNaN(maxPriceVal) ? null : maxPriceVal;

            filteredData = productos.filter(p => {
                const nombre = (p.nombreProducto ?? p.NombreProducto ?? "").toLowerCase();
                const codigo = (p.cod_Producto ?? p.codProducto ?? p.Codigo ?? "").toLowerCase();
                const precio = Number(p.precioVenta ?? p.valorVentaProducto ?? p.PrecioVenta ?? 0);
                const categoria = p.idCatepro ?? p.idCateProducto ?? p.IdCateProducto ?? "";
                const condicion = p.condicionProducto ?? p.CondicionProducto ?? "";

                const matchesSearch = !term || nombre.includes(term) || codigo.includes(term);
                const matchesCategory = !selectedCat || String(categoria) === String(selectedCat);
                const matchesMin = minPrice === null || precio >= minPrice;
                const matchesMax = maxPrice === null || precio <= maxPrice;
                const matchesEstado = !estado || condicion === estado;

                return matchesSearch && matchesCategory && matchesMin && matchesMax && matchesEstado;
            });

            currentPage = 1;
            updatePage();
        }

        function searchProducts() {
            applyFilters();
        }

        function cambiarSede() {

            const sedeId = document.getElementById("sedeSelect").value;
            const servicio = @Model.Servicio;

            window.location.href = `/Home/Tienda/${servicio}/${sedeId}`;
        }

        function abrirModalAgregar(codigo, nombre, precio, stockDisponible) {
            document.getElementById("modalCodigoProducto").value = codigo;
            document.getElementById("modalNombreProducto").value = nombre;
            document.getElementById("modalPrecioProducto").value = precio;
            document.getElementById("modalStockDisponible").value = stockDisponible;

            document.getElementById("modalTituloProducto").textContent = nombre;
            document.getElementById("modalCodigoTexto").textContent = `Código: ${codigo}`;
            document.getElementById("modalStockTexto").textContent = `Stock disponible: ${stockDisponible}`;
            document.getElementById("modalCantidad").value = 1;
            document.getElementById("modalCantidad").max = stockDisponible;

            document.getElementById("modalAgregarCarrito").classList.add("show");
        }

        function cerrarModalAgregar() {
            document.getElementById("modalAgregarCarrito").classList.remove("show");
        }

        function confirmarAgregarCarrito() {
            const codigo = document.getElementById("modalCodigoProducto").value;
            const nombre = document.getElementById("modalNombreProducto").value;
            const precio = Number(document.getElementById("modalPrecioProducto").value || 0);
            const stockDisponible = Number(document.getElementById("modalStockDisponible").value || 0);
            const cantidad = Number(document.getElementById("modalCantidad").value || 0);

            if (cantidad <= 0) {
                alert("La cantidad debe ser mayor a 0.");
                return;
            }

            if (cantidad > stockDisponible) {
                alert(`La cantidad no puede superar el stock disponible (${stockDisponible}).`);
                return;
            }

            const existente = carrito.find(x => x.codigo === codigo);

            if (existente) {
                const nuevaCantidad = existente.cantidad + cantidad;

                if (nuevaCantidad > stockDisponible) {
                    alert(`No puedes superar el stock disponible (${stockDisponible}) para este producto.`);
                    return;
                }

                existente.cantidad = nuevaCantidad;
            } else {
                carrito.push({
                    codigo,
                    nombre,
                    precio,
                    cantidad,
                    stockDisponible
                });
            }

            guardarCarritoStorage();
            actualizarBadgeCarrito();
            cerrarModalAgregar();
            abrirModalCarrito();
        }

        function abrirModalCarrito() {
            renderCarrito();
            document.getElementById("modalCarrito").classList.add("show");
        }

        function cerrarModalCarrito() {
            document.getElementById("modalCarrito").classList.remove("show");
        }

        function renderCarrito() {
            const cartList = document.getElementById("cartList");
            const cartSummary = document.getElementById("cartSummary");

            if (carrito.length === 0) {
                cartList.innerHTML = `<div class="empty-cart">No has agregado productos todavía.</div>`;
                cartSummary.innerHTML = `<strong>Total de productos:</strong> 0`;
                return;
            }

            let html = "";
            let totalItems = 0;

            carrito.forEach((item, index) => {
                totalItems += Number(item.cantidad || 0);

                html += `
                    <div class="cart-item">
                        <div class="cart-item-info">
                            <h4>${item.nombre}</h4>
                            <p>Código: ${item.codigo}</p>
                            <p>Disponible: ${item.stockDisponible}</p>
                        </div>
                        <div class="cart-item-actions">
                            <input type="number"
                                   min="1"
                                   max="${item.stockDisponible}"
                                   value="${item.cantidad}"
                                   onchange="cambiarCantidadCarrito(${index}, this.value)" />
                            <button type="button" class="btn-danger-custom" onclick="eliminarDelCarrito(${index})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            cartList.innerHTML = html;
            cartSummary.innerHTML = `<strong>Total de productos seleccionados:</strong> ${totalItems}`;
        }

        function cambiarCantidadCarrito(index, nuevaCantidad) {
            nuevaCantidad = Number(nuevaCantidad || 0);

            if (nuevaCantidad <= 0) {
                eliminarDelCarrito(index);
                return;
            }

            if (nuevaCantidad > carrito[index].stockDisponible) {
                alert(`No puedes superar el stock disponible (${carrito[index].stockDisponible}).`);
                renderCarrito();
                return;
            }

            carrito[index].cantidad = nuevaCantidad;
            guardarCarritoStorage();
            actualizarBadgeCarrito();
            renderCarrito();
        }

        function eliminarDelCarrito(index) {
            carrito.splice(index, 1);
            guardarCarritoStorage();
            actualizarBadgeCarrito();
            renderCarrito();
        }

        function vaciarCarrito() {
            carrito = [];
            guardarCarritoStorage();
            actualizarBadgeCarrito();
            renderCarrito();
        }

        function actualizarBadgeCarrito() {
            const total = carrito.reduce((acc, item) => acc + Number(item.cantidad || 0), 0);
            document.getElementById("cartBadge").textContent = total;
        }

        function enviarCarritoPorWhatsapp() {
            if (carrito.length === 0) {
                alert("El carrito está vacío.");
                return;
            }

            let mensaje = "Hola, estoy interesado en cotizar los siguientes productos:\n\n";

            carrito.forEach((item, index) => {
                mensaje += `${index + 1}. ${item.nombre} - Código: ${item.codigo} - Cantidad: ${item.cantidad}\n`;
            });

            mensaje += `\nQuedo atento(a) a más información.`;

            const whatsappUrl = `https://wa.me/573185313379?text=${encodeURIComponent(mensaje)}`;
            window.open(whatsappUrl, "_blank");
        }

        function escapeJs(text) {
            if (text === null || text === undefined) return "";
            return String(text)
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/"/g, '&quot;')
                .replace(/\r/g, " ")
                .replace(/\n/g, " ");
        }

        document.addEventListener("DOMContentLoaded", async () => {
            renderCategorySelect();
            cargarCarritoStorage();
            actualizarBadgeCarrito();

            // Mostrar todo al entrar, sin ordenar ni filtrar
            filteredData = [...productos];
            currentPage = 1;
            await updatePage();
        });
    </script>
</body>
</html>