@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
  <script src="~/js/customPlataforma.js"></script>
</head>
<body>
	<style>
		/* Background image (replace with URL from step 1) */
		body {
			background-image: url("https://images.unsplash.com/photo-1567095761054-7a02e69e5c43?q=80&w=1887&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
			background-size: cover;
			background-position: center;
			height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		/* Login form styling (using Bootstrap) */
		.login-form {
			width: 360px;
			padding: 30px;
			background-color: #fff;
			border-radius: 10px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
		}

		.login-form-header {
			text-align: center;
			margin-bottom: 20px;
		}

		.login-form-font-header {
			font-size: 30px;
			font-weight: bold;
		}

			.login-form-font-header span {
				color: #007bff; /* Bootstrap primary color */
			}

		.login-from-row {
			margin-bottom: 15px;
		}
	</style>
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-6 login-form">
				<form asp-controller="Home" asp-action="Login" method="POST">
					<div class="row login-form-header">
						<p class="login-form-font-header">Makro<span>tecno</span></p>
					</div>
					<div class="row login-from-row">
						<div class="col-md-12">
							<input type="text" name="correo" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Correo">
						</div>
					</div>
					<div class="row login-from-row">
						<div class="col-md-12">
							<input type="password" name="password" class="form-control" id="exampleInputPassword1" placeholder="Contraseña">
						</div>
					</div>
					<div class="row login-from-row">
						<div class="col-md-12">
							<button class="btn btn-primary">Entrar</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
	<script>
		$("btnLogin").click(function () {
			event.preventDefault();
			let btn = $(this);
			var form = $(this).closest('form');
			if (system.formValidate(form) == false) {
				return;
			}
			system.sendForm(
				'@Url.Content("~/Home/Login")',
				form,
				function (response) {
					if (response.isSuccess == true) {
						system.inputClear(form);
						Swal.fire({
							title: response.titulo,
							html: response.message,
							icon: "success",
							confirmButtonText = 'Cerrar'
						});
					} else {
						Swal.fire("Error!", response.message, "error");
					}
					system.btnEnabled(btn);
				},
				btn
			);
		});
	</script>
</body>
</html>