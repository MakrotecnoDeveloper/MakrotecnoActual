@model DetalleFacturaViewModel
@using System.Globalization
@using DocumentFormat.OpenXml.Office2010.PowerPoint
@{
    Layout = null;
    var cultura = new CultureInfo("es-CO");

    // =========================
    // DATOS FISCALES (EDITA AQUÍ)
    // =========================
    var empresaNombre = "MakroTecno S.A.S.";
    var empresaNit = "NIT 1234193470-6";
    var empresaRegimen = "Régimen: No Responsable de IVA";
    var empresaDir = "Cali - Valle del Cauca";
    var empresaDireccion = "Calle 33E #25-11, Alfonso Barberena, Cali";
    var empresaTel = "318 531 3379 / 316 566 6293";
    var empresaEmail = "administracion@makrotecno.com.co";

    // Resolución DIAN (si aún no tienes, déjalo como "N/A")
    var resolucion = "Resolución DIAN: N/A";
    var prefijo = "Prefijo: MT";
    var rango = "Rango autorizado: N/A";
    var actividad = "Actividad económica: Servicios / Comercio";

    // Cliente (no tienes FK, mostramos IdCliente/CedulaCliente)
    var clienteRef = Model?.Factura.Venta?.IdCliente.ToString() ?? "-";
    var cedulaCliente = Model?.Factura.Venta?.CedulaCliente.ToString() ?? "-";

    //Tipo de documentos
    var tipoDocumento = Model?.Factura?.TipoDocumento ?? "FacturaVenta";
    var origenModulo = Model?.Factura?.OrigenModulo
                       ?? Model?.Factura?.Venta?.OrigenModulo
                       ?? "VentaNormal";

    var codigoReferencia = Model?.Factura?.CodigoReferenciaOrigen
                           ?? Model?.Factura?.Venta?.CodigoReferenciaOrigen
                           ?? "N/A";

    var tipoOperacion = Model?.Factura?.Venta?.TipoOperacion ?? "Producto";

    var observacionDocumento = Model?.Factura?.Observacion
                               ?? Model?.Factura?.Venta?.ObservacionVenta
                               ?? "";

    // URL/Texto para QR (puedes meter un link a tu factura si luego lo tienes)
    // Por ahora: datos clave para verificación rápida
    var qrText = $"Factura:{Model?.Factura.NumeroFactura}|Venta:{Model?.Factura.IdVenta}|Origen:{origenModulo}|Ref:{codigoReferencia}|Fecha:{Model?.Factura.FechaEmision:yyyy-MM-dd}|Total:{Model?.Factura.Total}";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Factura @Model.Factura.NumeroFactura</title>

    <!-- Bootstrap opcional (para utilidades) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root{
            --ink:#111827;
            --muted:#6b7280;
            --line:#e5e7eb;
            --soft:#f9fafb;
        }

        html,body { background:#fff; color:var(--ink); }
        body { font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif; }

        /* =========================
           CONTROLES DE TAMAÑO
           ========================= */
        .actions{
            display:flex;
            gap: 8px;
            justify-content:flex-end;
            align-items:center;
            padding: 10px 12px;
            border-bottom: 1px solid var(--line);
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .sheet{
            margin: 0 auto;
            background:#fff;
        }

        /* Por defecto: Carta */
        .size-letter .sheet{
            width: 216mm;     /* 8.5 in */
            min-height: 279mm;/* 11 in */
            padding: 12mm;
        }

        /* Media Carta (mitad vertical) */
        .size-half-letter .sheet{
            width: 216mm;
            min-height: 140mm;
            padding: 10mm;
        }

        /* (Opcional) tirilla 80mm */
        .size-receipt .sheet{
            width: 80mm;
            min-height: auto;
            padding: 8mm;
        }

        /* =========================
           HEADER MEJORADO
           ========================= */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
            gap: 18px;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px 20px;
            margin-bottom: 10px;
            background: #fff;
        }

        .invoice-brand {
            display: flex;
            gap: 16px;
            align-items: center;
            flex: 1;
            min-width: 0;
        }

        .logo-box {
            width: 92px;
            height: 92px;
            border: 1px solid var(--line);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            flex-shrink: 0;
        }

            .logo-box img {
                max-width: 78px;
                max-height: 78px;
                object-fit: contain;
            }

        .business-name {
            margin: 0;
            font-size: 22px;
            font-weight: 900;
            color: var(--ink);
            line-height: 1.1;
        }

        .business-subtitle {
            font-size: 13px;
            color: var(--muted);
            margin-top: 3px;
            margin-bottom: 8px;
        }

        .business-meta {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.35;
        }

        .invoice-doc {
            min-width: 250px;
            text-align: right;
            border-left: 1px solid var(--line);
            padding-left: 18px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .invoice-doc .status {
                align-self: flex-end;
                display: inline-block;
                padding: 5px 14px;
                border-radius: 999px;
                border: 1px solid #bbf7d0;
                background: #f0fdf4;
                color: #15803d;
                font-size: 12px;
                font-weight: 800;
                margin-bottom: 10px;
            }

            .invoice-doc .title {
                font-size: 13px;
                text-transform: uppercase;
                letter-spacing: .8px;
                color: var(--muted);
                font-weight: 800;
            }

            .invoice-doc .number {
                font-size: 21px;
                font-weight: 900;
                color: var(--ink);
                margin-top: 3px;
                word-break: break-word;
            }

            .invoice-doc .date-label {
                margin-top: 10px;
                font-size: 11px;
                color: var(--muted);
            }

            .invoice-doc .date-value {
                font-size: 14px;
                font-weight: 900;
                color: var(--ink);
            }

        .invoice-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 12px;
            background: var(--soft);
        }

        .invoice-strip-item {
            padding: 9px 12px;
            border-right: 1px solid var(--line);
        }

            .invoice-strip-item:last-child {
                border-right: none;
            }

            .invoice-strip-item span {
                display: block;
                font-size: 10.5px;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: var(--muted);
                font-weight: 700;
                margin-bottom: 2px;
            }

            .invoice-strip-item strong {
                display: block;
                font-size: 12.5px;
                color: var(--ink);
                font-weight: 900;
                word-break: break-word;
            }

        /* =========================
           BLOQUES INFO
           ========================= */
        .grid-3{
            display:grid;
            grid-template-columns: 1.2fr 1fr .9fr;
            gap: 10px;
            margin-top: 10px;
        }

        .box{
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 10px 12px;
            background: #fff;
        }

        .box .box-title{
            font-size: 11px;
            color: var(--muted);
            margin-bottom: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
        }

        .kv{
            display:grid;
            grid-template-columns: 120px 1fr;
            row-gap: 6px;
            column-gap: 10px;
            font-size: 12.5px;
        }
        .kv .k{ color: var(--muted); }
        .kv .v{ font-weight: 700; }

        /* QR + Barcode */
        .qr-wrap{
            display:flex;
            gap: 10px;
            align-items:flex-start;
            justify-content:space-between;
        }
        #qrcode{
            width: 92px;
            height: 92px;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 6px;
        }
        #barcode{
            width: 100%;
            height: 44px;
        }

        /* =========================
           TABLA ITEMS
           ========================= */
        table.items{
            width:100%;
            border-collapse: collapse;
            margin-top: 12px;
            font-size: 12.5px;
        }
        table.items thead th{
            text-transform: uppercase;
            letter-spacing: .5px;
            font-size: 10.5px;
            color: var(--muted);
            text-align:left;
            border-bottom: 1px solid var(--line);
            padding: 9px 8px;
        }
        table.items tbody td{
            border-bottom: 1px solid var(--line);
            padding: 9px 8px;
            vertical-align: top;
        }
        .text-end{ text-align:right; }
        .muted{ color: var(--muted); }

        /* =========================
           TOTALES
           ========================= */
        .totals-wrap{
            display:flex;
            justify-content:flex-end;
            margin-top: 12px;
        }
        .totals{
            width: 320px;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 10px 12px;
            background: var(--soft);
        }
        .totals .row{
            display:flex;
            justify-content:space-between;
            margin: 6px 0;
            font-size: 12.5px;
        }
        .totals .grand{
            border-top: 1px dashed #cbd5e1;
            margin-top: 10px;
            padding-top: 10px;
            font-size: 13.5px;
            font-weight: 900;
        }

        .legal{
            margin-top: 14px;
            border-top: 1px solid var(--line);
            padding-top: 10px;
            font-size: 10.5px;
            color: var(--muted);
            line-height: 1.35;
        }

        /* =========================
           PRINT
           ========================= */
        @@media print {
            .actions {
                display: none !important;
            }

            .sheet {
                width: auto !important;
                min-height: auto !important;
                margin: 0 !important;
                padding: 0 !important;
            }
        }

        /* Por defecto imprime en Carta */
        @@page {
            size: letter;
            margin: 12mm;
        }

        /* Media carta */
        body.size-half-letter @@page {
            size: 216mm 140mm;
            margin: 10mm;
        }

        /* Tirilla (opcional) */
        body.size-receipt @@page {
            size: 80mm 297mm;
            margin: 3mm;
        }

        /* Responsive: si media carta o tirilla, apila */
        body.size-half-letter .grid-3,
        body.size-receipt .grid-3{
            grid-template-columns: 1fr;
        }
        body.size-receipt #qrcode{
            width: 82px;
            height: 82px;
        }
        /* =========================
           MEDIA CARTA
           ========================= */
        body.size-half-letter .sheet {
            padding: 8mm;
        }

        body.size-half-letter .invoice-header {
            padding: 12px 14px;
            gap: 12px;
        }

        body.size-half-letter .logo-box {
            width: 68px;
            height: 68px;
            border-radius: 12px;
        }

            body.size-half-letter .logo-box img {
                max-width: 58px;
                max-height: 58px;
            }

        body.size-half-letter .business-name {
            font-size: 18px;
        }

        body.size-half-letter .business-subtitle {
            font-size: 11px;
            margin-bottom: 5px;
        }

        body.size-half-letter .business-meta {
            font-size: 10.5px;
        }

        body.size-half-letter .invoice-doc {
            min-width: 205px;
            padding-left: 12px;
        }

            body.size-half-letter .invoice-doc .number {
                font-size: 16px;
            }

        body.size-half-letter .invoice-strip {
            grid-template-columns: repeat(2, 1fr);
        }

        body.size-half-letter .invoice-strip-item {
            border-bottom: 1px solid var(--line);
        }

            body.size-half-letter .invoice-strip-item:nth-child(2n) {
                border-right: none;
            }

        body.size-half-letter .grid-3 {
            grid-template-columns: 1fr 1fr;
        }

            body.size-half-letter .grid-3 .box:last-child {
                grid-column: 1 / -1;
            }

        body.size-half-letter table.items {
            font-size: 11px;
        }

            body.size-half-letter table.items thead th,
            body.size-half-letter table.items tbody td {
                padding: 6px 5px;
            }

        body.size-half-letter .totals {
            width: 260px;
        }
        /* =========================
           TIRILLA 80MM
           ========================= */
        body.size-receipt {
            font-family: Arial, sans-serif;
        }

            body.size-receipt .sheet {
                width: 80mm;
                padding: 4mm;
            }

            body.size-receipt .invoice-header {
                display: block;
                border: none;
                border-radius: 0;
                padding: 0;
                margin-bottom: 6px;
                text-align: center;
            }

            body.size-receipt .invoice-brand {
                display: block;
            }

            body.size-receipt .logo-box {
                width: auto;
                height: auto;
                border: none;
                border-radius: 0;
                margin-bottom: 4px;
            }

                body.size-receipt .logo-box img {
                    max-width: 42mm;
                    max-height: 20mm;
                }

            body.size-receipt .business-name {
                font-size: 14px;
                text-align: center;
            }

            body.size-receipt .business-subtitle {
                font-size: 10px;
                text-align: center;
                margin-bottom: 4px;
            }

            body.size-receipt .business-meta {
                font-size: 9.5px;
                text-align: center;
                line-height: 1.25;
                border-bottom: 1px dashed #999;
                padding-bottom: 6px;
            }

            body.size-receipt .invoice-doc {
                min-width: 0;
                border-left: none;
                padding-left: 0;
                margin-top: 6px;
                text-align: center;
                display: block;
            }

                body.size-receipt .invoice-doc .status {
                    display: inline-block;
                    margin-bottom: 5px;
                    padding: 3px 8px;
                    font-size: 10px;
                }

                body.size-receipt .invoice-doc .title {
                    font-size: 12px;
                    color: var(--ink);
                }

                body.size-receipt .invoice-doc .number {
                    font-size: 12px;
                    margin-top: 2px;
                }

                body.size-receipt .invoice-doc .date-label {
                    font-size: 9px;
                    margin-top: 4px;
                }

                body.size-receipt .invoice-doc .date-value {
                    font-size: 10px;
                }

            body.size-receipt .invoice-strip {
                display: block;
                border: none;
                border-radius: 0;
                background: #fff;
                border-top: 1px dashed #999;
                border-bottom: 1px dashed #999;
                padding: 5px 0;
                margin-bottom: 6px;
            }

            body.size-receipt .invoice-strip-item {
                display: flex;
                justify-content: space-between;
                gap: 6px;
                border: none;
                padding: 1px 0;
            }

                body.size-receipt .invoice-strip-item span {
                    font-size: 9.5px;
                    text-transform: none;
                    letter-spacing: 0;
                    margin: 0;
                }

                body.size-receipt .invoice-strip-item strong {
                    font-size: 9.5px;
                    text-align: right;
                    max-width: 42mm;
                }

            body.size-receipt .grid-3 {
                display: block;
            }

            body.size-receipt .box {
                border: none;
                border-radius: 0;
                padding: 5px 0;
                border-bottom: 1px dashed #999;
            }

                body.size-receipt .box .box-title {
                    font-size: 10px;
                    margin-bottom: 4px;
                }

            body.size-receipt .kv {
                grid-template-columns: 24mm 1fr;
                font-size: 9.5px;
                row-gap: 2px;
            }

            body.size-receipt .box:nth-child(1),
            body.size-receipt .box:nth-child(3) {
                display: none;
            }

            body.size-receipt table.items {
                font-size: 9.5px;
                margin-top: 6px;
            }

                body.size-receipt table.items thead th {
                    font-size: 8.5px;
                    padding: 4px 2px;
                }

                body.size-receipt table.items tbody td {
                    padding: 4px 2px;
                }

                body.size-receipt table.items th:nth-child(1),
                body.size-receipt table.items td:nth-child(1) {
                    display: none;
                }

                body.size-receipt table.items th:nth-child(2),
                body.size-receipt table.items td:nth-child(2) {
                    width: 42%;
                }

            body.size-receipt .totals-wrap {
                display: block;
            }

            body.size-receipt .totals {
                width: 100%;
                border: none;
                border-radius: 0;
                background: #fff;
                padding: 5px 0;
                border-top: 1px dashed #999;
            }

                body.size-receipt .totals .row {
                    font-size: 10px;
                }

                body.size-receipt .totals .grand {
                    font-size: 11px;
                }

            body.size-receipt .legal {
                font-size: 8.5px;
                text-align: center;
                border-top: 1px dashed #999;
                margin-top: 6px;
                padding-top: 6px;
            }
    </style>
</head>

<body class="size-letter">

    <!-- Acciones (no se imprimen) -->
    <div class="actions">
        <select id="paperSize" class="form-select form-select-sm" style="max-width: 220px;">
            <option value="size-letter" selected>🧾 Carta</option>
            <option value="size-half-letter">📄 Media Carta</option>
            <option value="size-receipt">🧻 Tirilla 80mm (opcional)</option>
        </select>

        <button class="btn btn-dark btn-sm" onclick="window.print()">🖨️ Imprimir</button>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">Cerrar</button>
    </div>

    <div class="sheet">

        <!-- Encabezado -->
        <div class="invoice-header">
            <div class="invoice-brand">
                <div class="logo-box">
                    <img src="~/img/logo.png" alt="Logo" />
                </div>

                <div>
                    <h1 class="business-name">@empresaNombre</h1>
                    <div class="business-subtitle">Soluciones tecnológicas integrales</div>

                    <div class="business-meta">
                        <div><b>@empresaNit</b> · @empresaRegimen</div>
                        <div>@empresaDireccion</div>
                        <div>@empresaDir</div>
                        <div>Tel: @empresaTel</div>
                        <div>@empresaEmail</div>
                    </div>
                </div>
            </div>

            <div class="invoice-doc">
                <div class="status">@Model.Factura.EstadoFactura</div>

                <div class="title">Factura de venta</div>
                <div class="number">@Model.Factura.NumeroFactura</div>

                <div class="date-label">Fecha de emisión</div>
                <div class="date-value">@Model.Factura.FechaEmision.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="invoice-strip">
            <div class="invoice-strip-item">
                <span>Tipo documento</span>
                <strong>@tipoDocumento</strong>
            </div>

            <div class="invoice-strip-item">
                <span>Origen</span>
                <strong>@origenModulo</strong>
            </div>

            <div class="invoice-strip-item">
                <span>Referencia</span>
                <strong>@codigoReferencia</strong>
            </div>

            <div class="invoice-strip-item">
                <span>Tipo operación</span>
                <strong>@tipoOperacion</strong>
            </div>
        </div>

        <!-- Bloques -->
        <div class="grid-3">
            <div class="box">
                <div class="box-title">Datos fiscales</div>
                <div class="kv">
                    <div class="k">Resolución</div><div class="v">@resolucion</div>
                    <div class="k">Prefijo</div><div class="v">@prefijo</div>
                    <div class="k">Rango</div><div class="v">@rango</div>
                    <div class="k">Actividad</div><div class="v">@actividad</div>
                </div>
            </div>

            <div class="box">
                <div class="box-title">Cliente</div>
                <div class="kv">
                    <div class="k">Cliente (ID)</div><div class="v">@clienteRef</div>
                    <div class="k">Cédula</div><div class="v">@cedulaCliente</div>
                    <div class="k">Venta</div><div class="v">#@Model.Factura.IdVenta</div>
                    <div class="k">Método</div><div class="v">@(Model?.Factura.Venta?.MetodoPago ?? "N/A")</div>
                    <div class="k">Origen</div><div class="v">@origenModulo</div>
                    <div class="k">Referencia</div><div class="v">@codigoReferencia</div>
                    <div class="k">Tipo operación</div><div class="v">@tipoOperacion</div>
                </div>
            </div>

            <div class="box">
                <div class="box-title">Validación</div>
                <div class="qr-wrap">
                    <div>
                        <div id="qrcode"></div>
                        <div class="muted" style="font-size:10.5px; margin-top:6px;">
                            QR de verificación
                        </div>
                    </div>
                    <div style="flex:1;">
                        <svg id="barcode"></svg>
                        <div class="muted" style="font-size:10.5px; margin-top:6px;">
                            Código: @Model.Factura.NumeroFactura
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items -->
        <table class="items">
            <thead>
                <tr>
                    <th style="width: 26%">Código</th>
                    <th>Detalle</th>
                    <th class="text-end" style="width: 10%">Cant</th>
                    <th class="text-end" style="width: 18%">V/Unit</th>
                    <th class="text-end" style="width: 18%">Subtotal</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var pedido in Model.Factura.Venta.Pedidos)
            {
                <tr>
                    <td style="font-weight:800;">@pedido.Codigo</td>
                        <td class="muted">@(pedido.Producto?.NombreProducto ?? "Producto / Servicio")</td>
                    <td class="text-end">@pedido.Stock</td>
                    <td class="text-end">@pedido.VVenta.ToString("C0", cultura)</td>
                    <td class="text-end" style="font-weight:900;">@pedido.SubTotal.ToString("C0", cultura)</td>
                </tr>
            }
            </tbody>
        </table>

        <!-- Totales -->
        <div class="totals-wrap">
            <div class="totals">
                <div class="row">
                    <span class="muted">Subtotal</span>
                    <span style="font-weight:800;">@Model.Factura.SubTotal.ToString("C0", cultura)</span>
                </div>
                <div class="row">
                    <span class="muted">IVA</span>
                    <span style="font-weight:800;">@Model.Factura.IVA.ToString("C0", cultura)</span>
                </div>
                <div class="row grand">
                    <span>Total</span>
                    <span>@Model.Factura.Total.ToString("C0", cultura)</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(observacionDocumento))
        {
            <div class="legal">
                <b>Observación:</b> @observacionDocumento
            </div>
        }

        <!-- Nota -->
        <div class="legal">
            <b>Nota:</b> Documento de soporte generado por el sistema.
            Para facturación electrónica DIAN real se requiere numeración autorizada e integración de validación.
        </div>

    </div>

    <!-- QR + Barcode -->
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

    <script>
        // Selector tamaño (Carta / MediaCarta / Tirilla)
        const sel = document.getElementById("paperSize");
        sel.addEventListener("change", () => {
            document.body.className = sel.value; // cambia clase del body
        });

        // QR
        new QRCode(document.getElementById("qrcode"), {
            text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(qrText)),
            width: 90,
            height: 90,
            correctLevel: QRCode.CorrectLevel.M
        });

        // Barcode
        JsBarcode("#barcode", "@Model.Factura.NumeroFactura", {
            format: "CODE128",
            displayValue: false,
            margin: 0,
            height: 42
        });

        // Si quieres que al abrir imprima de una:
        // window.onload = () => window.print();
    </script>
</body>
</html>