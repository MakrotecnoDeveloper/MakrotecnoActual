@model PedidoViewModel
@{
    ViewData["Title"] = "CrearPedido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h2 class="text-primary">Factura de Venta</h2>
                    <p class="text-muted">Ingrese los detalles de la factura y los productos correspondientes.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <!-- Contenedor principal -->
                <div class="col-md-10">
                    <div class="card shadow-lg border-secondary">
                        <!-- Encabezado de la factura -->
                        <div class="card-header bg-dark text-white">
                            <h3 class="card-title text-center mb-0">Factura de Venta</h3>
                        </div>
                        <!-- Contenido de la factura -->
                        <div class="card-body">
                            <!-- Información del cliente y factura -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h5 class="text-secondary">Detalles del Cliente</h5>
                                    <div class="form-group">
                                        <label for="clienteNombre" class="fw-bold">Nombre del Cliente</label>
                                        <input type="text" class="form-control" id="clienteNombre" name="clienteNombre" placeholder="Ingrese el nombre del cliente">
                                    </div>
                                    <div class="form-group">
                                        <label for="clienteCedula" class="fw-bold">Cédula</label>
                                        <input type="text" class="form-control" id="clienteCedula" name="clienteCedula" placeholder="Ingrese la cédula">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <h5 class="text-secondary">Información de la Factura</h5>
                                    <div class="form-group">
                                        <label for="numeroFactura" class="fw-bold">Número de Factura</label>
                                        <input type="text" class="form-control bg-light border-0" id="numeroFactura" name="numeroFactura" value="001-000123" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label for="fechaFactura" class="fw-bold">Fecha</label>
                                        <input type="date" class="form-control" id="fechaFactura" name="fechaFactura" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                    </div>
                                </div>
                            </div>

                            <!-- Tabla de productos -->
                            <h5 class="text-secondary">Detalles de los Productos</h5>
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered">
                                    <thead class="bg-primary text-white">
                                        <tr>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th>Cantidad</th>
                                            <th>Precio Unitario</th>
                                            <th>Subtotal</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tablaProductos">
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control" name="codigoProducto[]" placeholder="Código">
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" name="descripcionProducto[]" placeholder="Descripción">
                                            </td>
                                            <td>
                                                <input type="number" class="form-control" name="cantidadProducto[]" placeholder="Cantidad">
                                            </td>
                                            <td>
                                                <input type="number" class="form-control" name="precioUnitario[]" placeholder="Precio Unitario">
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" name="subtotalProducto[]" readonly placeholder="Subtotal">
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila(this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <button type="button" class="btn btn-success btn-sm" onclick="agregarFila()">
                                    <i class="fas fa-plus"></i> Agregar Producto
                                </button>
                            </div>

                            <!-- Resumen de la factura -->
                            <h5 class="text-secondary">Resumen de la Factura</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="subtotalFactura" class="fw-bold">Subtotal</label>
                                        <input type="text" class="form-control bg-light border-0" id="subtotalFactura" name="subtotalFactura" readonly value="0.00">
                                    </div>
                                    <div class="form-group">
                                        <label for="ivaFactura" class="fw-bold">IVA (19%)</label>
                                        <input type="text" class="form-control bg-light border-0" id="ivaFactura" name="ivaFactura" readonly value="0.00">
                                    </div>
                                    <div class="form-group">
                                        <label for="descuentoFactura" class="fw-bold">Descuento</label>
                                        <input type="number" class="form-control" id="descuentoFactura" name="descuentoFactura" value="0">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="totalFactura" class="fw-bold">Total</label>
                                        <input type="text" class="form-control bg-light border-0 text-success fw-bold" id="totalFactura" name="totalFactura" readonly value="0.00">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Footer de la factura -->
                        <div class="card-footer text-center">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save"></i> Guardar Factura
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    $(document).ready(function () {
        // Manejar cambios en el campo de código de producto dinámico
        $(document).on('input', '.codigoProducto', function () {
            var codigo = $(this).val();
            var opcionesCodigosProducto = $(this).siblings('.opcionesCodigosProducto');
            var index = $(this).attr('id').replace('codfact', ''); // Obtener el índice del conjunto actual

            if (codigo.length >= 3) {
                // Realizar la solicitud AJAX para autocompletar códigos de productos
                $.ajax({
                    url: '@Url.Action("AutocompletarCodigosProducto", "Pedido")',
                    type: 'GET',
                    dataType: 'json',
                    data: { codigo: codigo },
                    success: function (response) {
                        mostrarOpcionesAutocompletado(response, opcionesCodigosProducto);
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al autocompletar códigos de productos:', error);
                        opcionesCodigosProducto.empty();
                    }
                });

                // Realizar la solicitud AJAX para autocompletar datos de producto
                $.ajax({
                    url: '@Url.Action("AutocompletarProducto", "Pedido")',
                    type: 'GET',
                    data: { codigo: codigo },
                    success: function (data) {
                        $('#vneto' + index).val(data.vneto);
                        $('#vventa' + index).val(data.vventa);
                    },
                    error: function (xhr, status, error) {
                        console.error('Error al obtener los datos del producto:', error);
                    }
                });
            } else {
                opcionesCodigosProducto.empty();
            }
        });

        // Manejar clic del botón "Agregar Producto(s)"
        $(document).on('click', '#btnAgregar', function () {
            var productos = [];

            $('.codigoProducto').each(function (index) {
                var index = $(this).attr('id').replace('codfact', '');
                var producto = {
                    codfact: $(this).val(),
                    vneto: $('#vneto' + index).val(),
                    vventa: $('#vventa' + index).val(),
                    stock: $('#stock' + index).val(),
                };
                productos.push(producto);
            });

            console.log(productos); // Puedes enviarlos al controlador aquí
        });
    });






    $(document).ready(function () {
        // Manejar cambios en el campo de código de producto
        $('#cod_producto').on('input', function () {
            var codigo = $(this).val();
            //console.log(codigo);
            if (codigo.length >= 3) { // Realizar la solicitud solo si el código tiene al menos 3 caracteres

                // Realizar la solicitud AJAX para autocompletar códigos de productos
                $.ajax({
                    url: '@Url.Action("AutocompletarCodigosProducto", "Pedido")',
                    type: 'GET',
                    dataType: 'json',
                    data: { codigo: codigo },
                    success: function (response) {
                        mostrarOpcionesAutocompletado(response);
                    },
                    error: function (xhr, status, error) {
                        console.error(error);
                    }
                });

                // Realizar la solicitud AJAX para autocompletar datos de producto
                $.ajax({
                    url: '@Url.Action("AutocompletarProducto", "Pedido")',
                    type: 'GET',
                    data: { codigo: codigo },
                    success: function (data) {
                        console.log(data);
                        $('#vneto').val(data.valorNetoProducto);
                        $('#vventa').val(data.valorVentaProducto);
                    },
                    error: function () {
                        //console.log('Error al obtener los datos del producto.');
                    }
                });

            } else {
                // Limpiar las opciones de autocompletado si el código es demasiado corto
                $('#opcionesCodigosProducto').empty();
            }
        });
    });






    // Mostrar opciones de autocompletado obtenidas como respuesta AJAX
    function mostrarOpcionesAutocompletado(opciones) {
        var opcionesHtml = '';
        opciones.forEach(function (opcion) {
            opcionesHtml += '<div class="opcion">' + opcion + '</div>';
        });
        $('#opcionesCodigosProducto').html(opcionesHtml);
    }







    // Manejar selección de una opción de autocompletado
    $(document).on('click', '.opcion', function () {
        var codigoSeleccionado = $(this).text();
        $('#cod_producto').val(codigoSeleccionado); // Llenar el campo con el código seleccionado
        $('#opcionesCodigosProducto').empty(); // Limpiar las opciones de autocompletado
    });
</script>

