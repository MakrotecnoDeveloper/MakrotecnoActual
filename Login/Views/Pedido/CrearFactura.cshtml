@{
    ViewData["Title"] = "Crear Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="container mt-5">
        <h2 class="text-center mb-4">Crear Factura Manual</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" asp-action="CrearFactura" asp-controller="Pedido">
            <div class="mb-3">
                <label for="idVenta" class="form-label">ID de Venta</label>
                <input type="number" name="idVenta" class="form-control" placeholder="Ingrese el ID de la venta aprobada" required />
            </div>
            <div class="mb-3">
                <label for="ivaFactura" class="form-label fw-semibold">IVA (19%)</label>
                <input type="number" name="Iva" class="form-control" id="ivaFactura" value="0">
            </div>
            <button type="submit" class="btn btn-success">Generar Factura</button>
        </form>
    </div>
</div>