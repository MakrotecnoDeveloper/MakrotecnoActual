@model IEnumerable<Factura>
@{
    ViewData["Title"] = "Listado de Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="container mt-5">
        <h2 class="mb-4 text-center">Listado de Facturas</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <!-- Buscador de Factura Individual -->
        <div class="mb-4 text-center">
            <div class="input-group w-50 mx-auto">
                <input type="number" id="buscarFacturaInput" class="form-control" placeholder="Buscar por ID de Factura" />
                <button class="btn btn-primary" id="btnBuscarFactura">Buscar</button>
            </div>
        </div>

        <!-- Resultado de la búsqueda -->
        <div id="resultadoFactura"></div>

        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID Factura</th>
                    <th>Factura</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Tipo documento</th>
                    <th>Origen</th>
                    <th>Referencia</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    <tr>
                        <td>@factura.IdFactura</td>
                        <td>@factura.NumeroFactura</td>
                        <td>@factura.FechaEmision.ToShortDateString()</td>
                        <td>@factura.Venta.IdCliente</td>
                        <td>@(factura.TipoDocumento ?? "FacturaVenta")</td>
                        <td>
                            <span class="badge bg-secondary">
                                @(factura.OrigenModulo ?? factura.Venta?.OrigenModulo ?? "VentaNormal")
                            </span>
                        </td>

                        <td>
                            @(factura.CodigoReferenciaOrigen ?? factura.Venta?.CodigoReferenciaOrigen ?? "N/A")
                        </td>
                        <td>$@factura.Total</td>
                        <td>@factura.EstadoFactura</td>
                        <td>
                            <a asp-action="DetalleFactura"
                               asp-route-idFactura="@factura.IdFactura"
                               class="btn btn-sm btn-info">Detalle</a>

                            <button class="btn btn-sm btn-secondary"
                                    onclick="mostrarAdicion(@factura.IdFactura)">
                                Ajustar
                            </button>

                            <form asp-action="AnularFactura" method="post" style="display:inline">
                                <input type="hidden" name="idFactura" value="@factura.IdFactura" />
                                <button class="btn btn-sm btn-warning" type="submit">Anular</button>
                            </form>

                            <form asp-action="EliminarFactura" method="post" style="display:inline"
                                  onsubmit="return confirm('¿Seguro que deseas eliminar esta factura?');">
                                <input type="hidden" name="idFactura" value="@factura.IdFactura" />
                                <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                            </form>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
        <div id="formularioAdicion" class="mt-4"></div>
    </div>
</div>



@section Scripts {
    <script>
        $(document).on('click', '#btnBuscarFactura', function () {
            var IdFactura = $('#buscarFacturaInput').val();
            if (!IdFactura) return;

            $.get('/Pedido/BuscarFacturaPorId', { IdFactura: IdFactura }, function (html) {
                $('#resultadoFactura').html(html);
            });
        });

        function mostrarAdicion(IdFactura) {
            $.get('/Pedido/FormularioAdicion', { IdFactura: IdFactura }, function (html) {
                $('#formularioAdicion').html(html);
            });
        }

        $(document).on('submit', '#formAgregarAdicion', function (e) {
            e.preventDefault();

            $.post('/Pedido/GuardarAdicion', $(this).serialize(), function (resp) {
                if (resp.success) {
                    alert("Adición registrada correctamente");
                    $('#btnBuscarFactura').click(); // Recargar factura actualizada
                } else {
                    alert("Error al guardar la adición.");
                }
            });
        });
    </script>
}