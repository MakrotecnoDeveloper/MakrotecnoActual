@{
    ViewData["Title"] = "Agregar Factura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Agregar Factura
        </h1>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Formulario de Factura</h3>
                    </div>
                    <!-- /.box-header -->
                    <!-- form start -->
                    <form role="form" method="post" asp-controller="Pedido" asp-action="CrearFactura" id="formCrearFactura">
                        <div class="box-body">
                                <div class="form-group">
                                    <label for="cedula_cliente">Cédula del Cliente</label>
                                    <input type="text" class="form-control" id="cedula_cliente" name="cedula_cliente" placeholder="Cédula del Cliente">
                                </div>
                                <div class="form-group">
                                    <label for="cedula_empleado">Cédula del Empleado</label>
                                    <input type="text" class="form-control" id="cedula_empleado" name="cedula_empleado" placeholder="Cédula del Empleado" readonly value="1234193470">
                                </div>
                                <div class="form-group">
                                    <label for="estado">Estado</label>
                                    <select class="form-control" id="estado" name="estado">
                                        <option value="Proceso">Proceso</option>
                                    </select>
                                </div>
                        </div>
                        
                        <!-- /.box-body -->

                        <div class="box-footer">
                            <button type="submit" class="btn btn-primary" id="btnCrearFactura">Agregar Factura</button>
                        </div>
                    </form>
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <!-- /.content -->
</div>
<!-- /.content-wrapper -->