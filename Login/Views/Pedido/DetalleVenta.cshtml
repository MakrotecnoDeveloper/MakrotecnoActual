@model DetalleVentaViewModel
@{
    ViewData["Title"] = "Detalle de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cultura = new System.Globalization.CultureInfo("es-CO");
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Detalle de Venta #@Model.Venta.IdVenta</h2>
            <a asp-action="ListaVentas" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>

        <!-- Resumen -->
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-8">
                <div class="border rounded-3 bg-white p-3 shadow-sm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Cliente</div>
                            <div class="fw-semibold">
                                @(Model.Cliente?.NombreCliente ?? ("Cliente ID: " + Model.Venta.IdCliente))
                            </div>
                            <div class="text-muted small mt-1">Fecha</div>
                            <div class="fw-semibold">@Model.Venta.FechaVenta.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="col-md-6 text-md-end">
                            <div class="text-muted small">Estado</div>
                            <div class="fw-semibold">@Model.Venta.EstadoVenta</div>

                            <div class="text-muted small mt-1">Total</div>
                            <div class="fs-4 fw-bold">@Model.Venta.Total.ToString("C0", cultura)</div>

                            @if (!string.IsNullOrWhiteSpace(Model.Venta.MetodoPago))
                            {
                                <div class="text-muted small mt-1">Método de pago</div>
                                <div class="fw-semibold">@Model.Venta.MetodoPago</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="border rounded-3 bg-white p-3 shadow-sm">
                    <div class="text-muted small">Factura</div>

                    @if (Model.Venta.EstadoVenta == "Facturada")
                    {
                        <div class="fw-bold"># @Model.NumeroFactura</div>
                        <div class="text-muted small">
                            Emisión: @(Model.Venta.FechaEmisionFactura?.ToString("dd/MM/yyyy") ?? "N/A")
                        </div>

                        <div class="d-grid mt-2">
                            <a asp-action="DetalleFactura"
                               asp-route-idFactura="@Model.IdFactura"
                               class="btn btn-dark">
                                <i class="bi bi-receipt"></i> Ver / Imprimir Factura
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Aún no emitida</div>
                    }

                    @* Si tu ViewModel trae info de CxC, muéstrala *@
                    @if (Model.SaldoPendienteCredito > 0)
                    {
                        <hr />
                        <div class="text-muted small">Crédito pendiente</div>
                        <div class="fw-bold text-danger">
                            @Model.SaldoPendienteCredito.ToString("C0", cultura)
                        </div>
                        <div class="text-muted small">
                            Vence: @(Model.FechaVencimientoCredito?.ToString("dd/MM/yyyy") ?? "N/A")
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tabla productos -->
        <div class="border rounded-3 bg-white shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">Productos / Servicios</h5>
                <span class="text-muted small">Items: @(Model.Venta.Pedidos?.Count ?? 0)</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:160px;">Código</th>
                            <th>Detalle</th>
                            <th class="text-end" style="width:110px;">Cant.</th>
                            <th class="text-end" style="width:160px;">V. Unitario</th>
                            <th class="text-end" style="width:160px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model.Venta.Pedidos)
                        {
                            <tr>
                                <td class="fw-semibold">@pedido.Codigo</td>

                                <td class="text-muted">
                                    Producto / Servicio
                                </td>

                                <td class="text-end">@pedido.Stock</td>

                                <td class="text-end">
                                    @pedido.VVenta.ToString("C0", cultura)
                                </td>

                                <td class="text-end fw-semibold">
                                    @pedido.SubTotal.ToString("C0", cultura)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Acciones por estado -->
        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (Model.Venta.EstadoVenta == "Pendiente")
            {
                <a asp-action="AgregarProductoAVenta"
                   asp-route-idVenta="@Model.Venta.IdVenta"
                   class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Agregar Producto
                </a>

                <form asp-action="CambiarEstadoVenta" method="post">
                    <input type="hidden" name="idVenta" value="@Model.Venta.IdVenta" />
                    <input type="hidden" name="nuevoEstado" value="Confirmada" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle"></i> Confirmar Venta
                    </button>
                </form>

                <form asp-action="CambiarEstadoVenta" method="post">
                    <input type="hidden" name="idVenta" value="@Model.Venta.IdVenta" />
                    <input type="hidden" name="nuevoEstado" value="Anulada" />
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle"></i> Anular
                    </button>
                </form>
            }

            @if (Model.Venta.EstadoVenta == "Confirmada")
            {
                <div class="alert alert-info mb-0">
                    <strong>Venta confirmada</strong> — pendiente de registrar pagos.
                </div>

                <a asp-action="RegistrarPagos"
                   asp-route-idVenta="@Model.Venta.IdVenta"
                   class="btn btn-dark">
                    <i class="bi bi-cash-coin"></i> Registrar Pagos
                </a>
            }

            @if (Model.Venta.EstadoVenta == "Facturada")
            {
                <div class="alert alert-success mb-0">
                    <strong>Venta facturada</strong> — Factura #@Model.NumeroFactura
                </div>
            }
        </div>

    </div>
</div>