@model Plataforma.Models.Ventas
@{
    ViewData["Title"] = "Detalle de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="container mt-4">
        <h2 class="text-center mb-4">Detalle de Venta #@Model.IdVenta</h2>

        <div class="mb-3">
            <strong>Cliente:</strong> @Model.IdCliente <br />
            <strong>Fecha:</strong> @Model.FechaVenta.ToString("dd/MM/yyyy") <br />
            <strong>Estado:</strong> @Model.EstadoVenta <br />
            <strong>Total:</strong> $@Model.Total
        </div>

        <h4>Productos Agregados</h4>
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Código Producto</th>
                    <th>Cantidad</th>
                    <th>Valor Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.Pedidos)
                {
                    <tr>
                        <td>@pedido.Codigo</td>
                        <td>@pedido.Stock</td>
                        <td>$@pedido.VVenta</td>
                        <td>$@pedido.SubTotal</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-3">
            @if (Model.EstadoVenta == "Pendiente")
            {
                <a asp-action="AgregarProductoAVenta" asp-route-idVenta="@Model.IdVenta" class="btn btn-success">Agregar Producto</a>
                <form asp-action="CambiarEstadoVenta" method="post" style="display:inline;">
                    <input type="hidden" name="idVenta" value="@Model.IdVenta" />
                    <input type="hidden" name="nuevoEstado" value="Aprobada" />
                    <button type="submit" class="btn btn-primary">Aprobar</button>
                </form>

                <form asp-action="CambiarEstadoVenta" method="post" style="display:inline;">
                    <input type="hidden" name="idVenta" value="@Model.IdVenta" />
                    <input type="hidden" name="nuevoEstado" value="Rechazada" />
                    <button type="submit" class="btn btn-danger">Rechazar</button>
                </form>
            }
            @if (Model.EstadoVenta == "Aprobada")
            {
                <div class="card p-3 mt-3">
                    <h5 class="mb-3">Método de Pago: @Model.MetodoPago</h5>

                    @if (Model.MetodoPago == 1 || Model.MetodoPago == 4)
                    {
                        <a asp-action="CrearFactura" asp-route-idVenta="@Model.IdVenta" class="btn btn-primary">
                            Generar Factura
                        </a>
                    }
                    else if (Model.MetodoPago == 3)
                    {
                        <form asp-action="CrearFactura" method="post" class="row g-2">
                            <input type="hidden" name="idVenta" value="@Model.IdVenta" />
                            <div class="col-md-6">
                                <input type="text" name="numeroTDC" class="form-control" placeholder="Número de Venta TDC" required />
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100">Confirmar y Facturar</button>
                            </div>
                        </form>
                    }
                    else if (Model.MetodoPago == 2)
                    {
                        <form asp-action="CrearFactura" method="post" class="row g-2">
                            <input type="hidden" name="idVenta" value="@Model.IdVenta" />
                            <div class="col-md-6">
                                <input type="text" name="numeroConsignacion" class="form-control" placeholder="Número de consignación" required />
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-primary w-100">Confirmar y Facturar</button>
                            </div>
                        </form>
                    }
                </div>
            }
            <a asp-action="ListaVentas" class="btn btn-secondary">Volver</a>
        </div>
    </div>
</div>