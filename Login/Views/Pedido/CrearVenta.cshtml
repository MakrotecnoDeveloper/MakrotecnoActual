@model OrdenesServicioViewModel
@{
    ViewData["Title"] = "Crear Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cedula = User.FindFirst("Cedula");
}
<div class="content-wrapper">
    <div class="container mt-5">
        <h2 class="text-center mb-4">Crear Nueva Venta</h2>
        <form method="POST" asp-action="CrearVenta" asp-controller="Pedido">
            <div class="mb-3">
                <label class="form-label">Cédula del Cliente</label>
                <select name="IdCliente" id="m_cliente" class="form-control">
                    <option disabled selected>Seleccione un cliente</option>
                    @foreach (var clientes in Model.Clientes)
                    {
                        <option value="@clientes.IdCliente">@clientes.NombreCliente</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Metodos de Pago</label>
                <select name="MetodoPago" id="m_metodoPago" class="form-control">
                    <option disabled selected>Seleccione un metodo de pago</option>
                    @foreach (var metodoPago in Model.MetodoPagos)
                    {
                        <option value="@metodoPago.IdMetodo">@metodoPago.Metodo</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Concepto</label>
                <input type="text" name="Conceptos" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Cédula del Vendedor</label>
                <input type="number" name="Cedula" class="form-control" value="@cedula.Value" placeholder="@cedula.Value" readonly />
            </div>
            <button type="submit" class="btn btn-primary">Crear Venta</button>
        </form>
    </div>
</div>