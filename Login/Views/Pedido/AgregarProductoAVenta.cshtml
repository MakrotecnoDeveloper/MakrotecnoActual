@model Plataforma.Models.Pedidos
@{
    ViewData["Title"] = "Agregar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="container mt-5">
        <h2 class="text-center mb-4">Agregar Producto a la Venta</h2>

        <form method="post" asp-action="AgregarProductoAVenta" asp-controller="Pedido">
            <input type="hidden" asp-for="IdVenta" />

            <div class="mb-3">
                <label class="form-label">Código Producto</label>
                <input type="text" asp-for="CodProducto" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Cantidad</label>
                <input type="number" asp-for="Cantidad" step="0.01" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Valor Unitario</label>
                <input type="number" asp-for="ValorVenta" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">PDV (ID opcional)</label>
                <input type="number" asp-for="InfopdvId" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Agregar</button>
            <a asp-action="DetalleVenta" asp-route-idVenta="@Model.IdVenta" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>