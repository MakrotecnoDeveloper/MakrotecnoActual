@model Plataforma.Models.PedidosViewModel

@{
    ViewData["Title"] = "Agregar Productos a Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper mt-4">
    <form role="form" id="productForm" asp-action="AgregarMultiplesProductosAVenta">
        <section class="content">
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card border-0 shadow-lg rounded-4">
                            <div class="card-body">
                                <!-- Proveedor y Factura -->
                                <div class="row g-4">
                                    <div class="col-sm-6">
                                        <h2 class="text-primary">Factura de Venta</h2>
                                        <p class="text-muted">Ingrese los detalles de la factura y los productos correspondientes.</p>
                                    </div>
                                </div>
                                <!-- Información del cliente y factura -->
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <h5 class="text-secondary">Información de la Factura</h5>
                                        <div class="form-group">
                                            <label for="numeroFactura" class="fw-bold">Número de Factura</label>
                                            <input type="text" class="form-control bg-light border-0" id="IdVenta" name="IdVenta" value="@Model.IdVenta" readonly>
                                        </div>
                                        <div class="form-group">
                                            <label for="fechaFactura" class="fw-bold">Fecha</label>
                                            <input type="date" class="form-control" id="fechaFactura" name="FechaRegistro" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                        </div>
                                    </div>
                                </div>

                                <!-- Detalles productos -->
                                <div class="mt-5">
                                    <h5 class="text-primary fw-bold">Detalles de los Productos</h5>
                                    <div class="d-flex justify-content-end mb-2">
                                        <button type="button" class="btn btn-success btn-sm" onclick="insertarFilasCrearPedido()">
                                            <i class="fas fa-plus"></i> Agregar Producto
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover table-bordered align-middle" data-tipo="venta">
                                            <thead class="table-primary">
                                                <tr>
                                                    <th>Código</th>
                                                    <th>Cantidad</th>
                                                    <th>Valor Neto</th>
                                                    <th>Valor Unitario</th>
                                                    <th>Acumulado</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tablaProductos">
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control codigoProducto" name="Productos[0].Codigo" placeholder="Código" id="codfact0">
                                                        <div class="opcionesCodigosProducto small text-muted"></div>
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].Stock" placeholder="Cantidad" id="stock0">
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control" name="Productos[0].VNeto" readonly placeholder="Venta Neto" id="vneto0">
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control" name="Productos[0].VVenta" placeholder="Valor Venta" id="vventa0">
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control" name="Productos[0].VTotal" readonly placeholder="Valor Total" id="vtotal0">
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="eliminarFila(this)">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <div class="text-end">
                                            <button type="button" class="btn btn-outline-success btn-sm" onclick="AcumularProductosDePedido()">
                                                <i class="fas fa-plus"></i> Acumulado Pedido
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Resumen factura -->
                                <div class="mt-5">
                                    <h5 class="text-primary fw-bold">Resumen de la Factura</h5>
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <label for="subtotalFactura" class="form-label fw-semibold">Subtotal</label>
                                            <input type="text" class="form-control bg-light" id="subtotalFactura" name="subtotalFactura" readonly value="0.00">
                                        </div>
                                        <div class="col-md-4">
                                            <label for="descuentoFactura" class="form-label fw-semibold">Descuento</label>
                                            <input type="number" class="form-control" id="descuentoFactura" name="DescuentoFactura" value="0">
                                        </div>
                                        <div class="col-md-4">
                                             <label for="ivaFactura" class="form-label fw-semibold">IVA (19%)</label>
                                             <input type="number" class="form-control bg-light" id="ivaFactura" name="Iva" value="0">
                                        </div>
                                        <div class="col-md-6 mt-3">
                                            <label for="totalFactura" class="form-label fw-bold">Total</label>
                                            <input type="text" class="form-control bg-light text-success fw-bold" id="totalFactura" name="totalFactura" readonly value="0.00">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Botón enviar -->
                            <div class="card-footer text-center bg-white border-top-0">
                                <button type="submit" class="btn btn-primary btn-lg px-4">
                                    <i class="fas fa-save me-2"></i>Guardar Pedido
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </form>
</div>