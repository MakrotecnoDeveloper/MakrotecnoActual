@model Plataforma.Models.OrdenServicios
@{
    ViewData["Title"] = "CreateOrden";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <h2>Nueva Orden de Servicio</h2>
    <form asp-action="CreateOrden" method="post">
        <div class="mb-3">
            <label asp-for="IdDispositivo" class="form-label">ID del Dispositivo</label>
            <input asp-for="IdDispositivo" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ProblemaReportado" class="form-label"></label>
            <textarea asp-for="ProblemaReportado" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" class="form-select">
                <option>Pendiente</option>
                <option>En proceso</option>
                <option>Terminado</option>
                <option>Entregado</option>
            </select>
        </div>
        <button type="submit" class="btn btn-success">Guardar</button>
    </form>
</div>