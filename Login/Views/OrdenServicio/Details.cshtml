@model Plataforma.Models.Dispositivos

@{
    ViewData["Title"] = "Detalle del Dispositivo";
}
<div class="content-wrapper">
    <div class="container mt-4">
        <h2>Detalle del Dispositivo</h2>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.Cliente?.NombreCliente</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.Marca</dd>

            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.Modelo</dd>

            <dt class="col-sm-3">IMEI</dt>
            <dd class="col-sm-9">@Model.IMEI</dd>

        </dl>

        <a asp-action="Dispositivos" class="btn btn-secondary">Volver</a>
    </div>
</div>