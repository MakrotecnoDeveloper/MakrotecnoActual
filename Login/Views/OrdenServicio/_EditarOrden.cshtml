@model Plataforma.Models.OrdenServicios

<form id="formEditarOrden">
    <input type="hidden" asp-for="IdOrden" />
    <input type="hidden" asp-for="FechaIngreso" />
    <input type="hidden" asp-for="Cedula" />

    <div class="mb-3">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" class="form-select">
            <option value="Pendiente">Pendiente</option>
            <option value="Ejecucion">Ejecución</option>
            <option value="Finalizada">Finalizada</option>
            <option value="Rechazada">Rechazada</option>
        </select>
    </div>
    <div class="mb-3">
        <input type="hidden" name="ValorPago" id="ValorCobrar" />
        <label asp-for="Observaciones" class="form-label">Observaciones</label>
        <input asp-for="Observaciones" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="IdDispositivo" class="form-label">IdDispositivo</label>
        <input asp-for="IdDispositivo" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="ProblemaReportado" class="form-label">Problema Reportado</label>
        <input asp-for="ProblemaReportado" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
</form>

<script>
        $("#formEditarOrden").on("submit", function (e) {
        e.preventDefault();

        var estado = $("select[name='Estado']").val();

        if (estado === "Finalizada") {
            var valor = prompt("Ingrese el valor a cobrar:");

            if (valor === null || valor.trim() === "" || isNaN(valor)) {
                alert("Debe ingresar un valor válido.");
                return; // detenemos el submit
            }

            $("#ValorCobrar").val(valor);
        }

        $.ajax({
            url: '/OrdenServicio/EditarOrden',
            type: 'POST',
            data: $(this).serialize(),
            success: function (resp) {
                alert(resp.mensaje);
                $("#modalEditarOrden").modal('hide');
                location.reload();
            },
            error: function () {
                alert('Ocurrió un error al actualizar el estado.');
            }
        });
    });
</script>