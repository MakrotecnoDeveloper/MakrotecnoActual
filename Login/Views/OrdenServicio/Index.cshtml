@model OrdenesServicioViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/OrdenServicio/Index.css">

<div class="content-wrapper">
    <div class="container">
        <h1 class="mb-3">Tabla de Ordenes de Servicio</h1>

        <!-- CONTROLES -->
        <div class="row mb-3 g-2">
            <div class="col-md-8">
                <div class="btn-group">
                    <button class="btn btn-primary" onclick="openUnifiedModal()">➕ Gestionar</button>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <div class="table-responsive border">
                    <table class="table table-sm table-striped mb-0" id="mainTable">
                        <thead class="table-dark">
                            <tr>
                                <th>FECHA</th>
                                <th>CLIENTE</th>
                                <th>TELEFONO</th>
                                <th>PASSWORD</th>
                                <th>MARCA</th>
                                <th>MODELO</th>
                                <th>DESCRIPCION</th>
                                <th>OBSERVACION</th>
                                <th>ESTADO</th>
                                <th>Tecnico</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbody">
                                @foreach (var ordenServicio in Model.OrdenServicios)
                                {
                                <tr>
                                    <td>@ordenServicio.FechaIngreso</td>
                                    <td>@ordenServicio.Dispositivo.Cliente.NombreCliente</td>
                                    <td>@ordenServicio.Dispositivo.Cliente.TelefonoCliente</td>
                                    <td>@ordenServicio.Dispositivo.Clave</td>
                                    <td>@ordenServicio.Dispositivo.Marca</td>
                                    <td>@ordenServicio.Dispositivo.Modelo</td>
                                    <td>@ordenServicio.ProblemaReportado</td>
                                    <td>@ordenServicio.Observaciones</td>
                                    <td>@ordenServicio.Estado</td>
                                    <td>@ordenServicio.Cedula</td>
                                    <td>
                                        <button class="btn btn-sm btn-info modOrdenBtn" data-id="@ordenServicio.IdOrden">
                                            Modificar Orden
                                        </button>
                                        <button class="btn btn-sm btn-info verOrdenBtn" data-id="@ordenServicio.IdOrden">
                                            Ver Registros
                                        </button>
                                        <button class="btn btn-sm btn-success nuevaOrdenBtn" data-id="@ordenServicio.IdOrden">
                                            Nuevo Registro
                                        </button>
                                        <button class="btn btn-sm btn-success asignarTecnico" data-id="@ordenServicio.IdOrden">
                                            Asignar Tecnico
                                        </button>
                                    </td>
                                </tr>
                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="unifiedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content rounded-4 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Gestión General</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">

                    <!-- NAV TABS -->
                    <ul class="nav nav-tabs mb-3" id="modalTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="cliente-tab" data-bs-toggle="tab" data-bs-target="#clienteTab" type="button">Agregar Cliente</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="dispositivo-tab" data-bs-toggle="tab" data-bs-target="#dispositivoTab" type="button">Agregar Dispositivo</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="orden-tab" data-bs-toggle="tab" data-bs-target="#ordenTab" type="button">Crear Orden</button>
                        </li>
                    </ul>

                    <!-- TAB CONTENT -->
                    <div class="tab-content">

                        <!-- ================= TAB ORDEN ================= -->
                        <div class="tab-pane fade" id="ordenTab">
                            <form id="rowForm">
                                <div class="row g-2">
                                    <div class="col-md-3">
                                        <label asp-for="orden.FechaIngreso">Fecha</label>
                                        <input asp-for="orden.FechaIngreso" id="m_fecha" class="form-control" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="orden.IdDispositivo">Dispositivo</label>
                                        <select asp-for="orden.IdDispositivo" name="cliente" id="m_dispositivo" class="form-control">
                                            <option disabled selected>Seleccione un dispositivo</option> 
                                            @foreach (var dispositivo in Model.Dispositivos) 
                                            {
                                            <option value="@dispositivo.IdDispositivo" data-descripcion="@dispositivo.Detalle">@dispositivo.IdDispositivo - @dispositivo.Cliente.NombreCliente - @dispositivo.FechaIngreso</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="orden.ProblemaReportado">Problema Reportado</label>
                                        <input asp-for="orden.ProblemaReportado" id="m_descripcion" class="form-control">
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="orden.Estado">Estado</label>
                                        <select asp-for="orden.Estado" id="m_estado" class="form-select"> 
                                            <option value="Ingresada">Ingresada</option> 
                                        </select>
                                    </div>
                                    <div class="col-md-12 mt-2">
                                        <label asp-for="orden.Observaciones">Observación</label>
                                        <textarea asp-for="orden.Observaciones" id="m_observacion" class="form-control" rows="5"></textarea>
                                    </div>
                                </div>
                                <div class="text-end mt-3">
                                    <button class="btn btn-primary" type="submit">Guardar Orden</button>
                                </div>
                            </form>
                        </div>

                        <!-- ================= TAB DISPOSITIVO ================= -->
                        <div class="tab-pane fade" id="dispositivoTab">
                            <form id="deviceForm">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label>Fecha</label>
                                        <input type="date" id="d_fecha" class="form-control" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Marca</label>
                                        <input id="d_marca" class="form-control" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Modelo</label>
                                        <input id="d_modelo" class="form-control" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Detalle</label>
                                        <input id="d_detalle" class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label>IMEI</label>
                                        <input id="d_imei" class="form-control" value="0">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Clave o PIN</label>
                                        <input id="d_clave" class="form-control" value="No tiene">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Patrón</label>
                                        <input id="d_patron" class="form-control" value="No tiene">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Tipo Dispositivo</label>
                                        <select name="servicio" id="d_tipodispositivo" class="form-control"> 
                                            <option disabled selected>Seleccione un servicio</option> 
                                            @foreach (var servicio in Model.TipoDispositivos) 
                                            {
                                                <option value="@servicio.TipoDispositivo">@servicio.Descripcion</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label>Cliente</label>
                                        <select name="cliente" id="d_cliente" class="form-control"> 
                                            <option disabled selected>Seleccione un cliente</option> 
                                            @foreach (var cliente in Model.Clientes) 
                                            {
                                                <option value="@cliente.IdCliente">@cliente.NombreCliente</option>
                                            }
                                            </select>
                                    </div>
                                </div>
                                <div class="text-end mt-3">
                                    <button class="btn btn-success" type="submit">Agregar Dispositivo</button>
                                </div>
                            </form>
                        </div>

                        <!-- ================= TAB CLIENTE ================= -->
                        <div class="tab-pane fade active show" id="clienteTab">
                            <form id="clienteForm">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label>Cédula</label>
                                        <input id="c_cedula" class="form-control" value="0">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Nombre</label>
                                        <input id="c_nombre" class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Empresa</label>
                                        <input id="c_empresa" class="form-control" value="No Maneja">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Ciudad</label>
                                        <input id="c_ciudad" class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Teléfono</label>
                                        <input id="c_telefono" class="form-control" value="0">
                                    </div>
                                    <div class="col-md-6">
                                        <label>Correo</label>
                                        <input type="email" id="c_correo" class="form-control" value="notiene@gmail.com">
                                    </div>
                                    <div class="col-md-12">
                                        <label>Dirección</label>
                                        <input id="c_direccion" class="form-control" value="no tiene">
                                    </div>
                                </div>
                                <div class="text-end mt-3">
                                    <button class="btn btn-info" type="submit">Agregar Cliente</button>
                                </div>
                            </form>
                        </div>

                    </div> <!-- TAB CONTENT -->

                </div>
            </div>
        </div>
    </div>
    <!-- Panel flotante -->
    <div id="sidePanel" class="position-fixed top-0 end-0 bg-light border-start shadow"
         style="width: 400px; height: 100%; display: none; z-index: 1050; overflow-y: auto;">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 id="sidePanelTitle" class="mb-0">Detalle</h5>
            <button type="button" class="btn-close" id="closePanel"></button>
        </div>
        <div class="p-3" id="sidePanelContent">
            <!-- Aquí se cargará el contenido dinámico -->
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/OrdenServicio/Index.js"></script>