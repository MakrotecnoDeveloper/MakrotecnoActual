@model OrdenesServicioViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string version = DateTime.Now.ToString();
    var rolClaim = User.FindFirst("NombreRol")?.Value ?? "";
    var cedulaClaim = User.FindFirst("Cedula")?.Value ?? "";
}
<link rel="stylesheet" href="~/css/OrdenServicio/Index.css">

<div class="content-wrapper">
    <div class="container">
        <h1 class="mb-3">Tabla de Ordenes de Servicio</h1>

        <!-- CONTROLES -->
        <div class="row mb-3 g-2 align-items-center">
            <div class="col-12 d-flex flex-wrap gap-2 align-items-center">

                <button class="btn btn-primary" onclick="openUnifiedModal()">➕ Gestionar</button>

                <div class="input-group" style="max-width: 320px;">
                    <input type="number" min="1" class="form-control" id="buscarIdOrden" placeholder="Buscar orden por ID">
                    <button class="btn btn-dark" id="btnBuscarOrden"><i class="bi bi-search"></i></button>
                </div>

                <!-- Filtros -->
                <div class="d-flex gap-2 ms-auto flex-wrap">
                    <select id="filtroEstado" class="form-select" style="min-width: 180px;">
                        <option value="__ALL__">Todos los estados</option>
                    </select>

                    <select id="filtroTecnico" class="form-select" style="min-width: 200px;">
                        <option value="__ALL__">Todos los técnicos</option>
                    </select>
                </div>

            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <!-- ===== RESUMEN (Totales arriba) ===== -->
                <div class="row g-2 mb-2" id="resumenOrdenes">
                    <div class="col-12 col-md-4">
                        <div class="border rounded-3 p-3 bg-white shadow-sm">
                            <div class="text-muted small">Órdenes</div>
                            <div class="fs-4 fw-semibold" id="kpiTotalOrdenes">0</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="border rounded-3 p-3 bg-white shadow-sm">
                            <div class="text-muted small">En proceso</div>
                            <div class="fs-4 fw-semibold" id="kpiEnProceso">0</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="border rounded-3 p-3 bg-white shadow-sm">
                            <div class="text-muted small">Finalizadas</div>
                            <div class="fs-4 fw-semibold" id="kpiFinalizadas">0</div>
                        </div>
                    </div>
                </div>

                <!-- ===== TABLA ===== -->
                <div class="table-responsive border rounded-3 bg-white shadow-sm">
                    <table class="table table-hover align-middle mb-0" id="mainTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:110px;">Código</th>
                                <th style="width:140px;">Fecha</th>
                                <th>Cliente / Equipo</th>
                                <th style="width:160px;">Técnico</th>
                                <th style="width:180px;">Estado</th>
                                <th style="width:140px;" class="text-end">Total</th>
                                <th style="width:190px;" class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody id="tbody">
                            @foreach (var ordenServicio in Model.OrdenServicios)
                            {
                                var total = ordenServicio.ValorPago ?? 0; // <-- tu "Total" base (si luego lo calculas mejor, aquí lo actualizas)

                                <tr>
                                    <!-- Código -->
                                    <td class="fw-semibold">
                                        ST-@ordenServicio.IdOrden
                                    </td>

                                    <!-- Fecha -->
                                    <td>
                                        <div class="small fw-semibold">@ordenServicio.FechaIngreso.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small">@ordenServicio.FechaIngreso.ToString("hh:mm tt")</div>
                                    </td>

                                    <!-- Cliente / Equipo -->
                                    <td>
                                        <div class="fw-semibold">@ordenServicio.Dispositivo?.Cliente?.NombreCliente</div>
                                        <div class="text-muted small">
                                            @ordenServicio.Dispositivo?.TipoDispositivo · @ordenServicio.Dispositivo?.Marca @ordenServicio.Dispositivo?.Modelo
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(ordenServicio.ProblemaReportado))
                                        {
                                            <div class="small mt-1">
                                                <span class="text-muted">Problema:</span>
                                                @ordenServicio.ProblemaReportado
                                            </div>
                                        }
                                    </td>

                                    <!-- Técnico -->
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @ordenServicio.Cedula
                                        </span>
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @{
                                            var estado = ordenServicio.Estado ?? "";
                                            var badgeClass = "bg-secondary";

                                            if (estado == "Ingresada") badgeClass = "bg-secondary";
                                            else if (estado == "Ejecucion") badgeClass = "bg-primary";
                                            else if (estado == "Pendiente") badgeClass = "bg-warning text-dark";
                                            else if (estado == "Finalizada") badgeClass = "bg-dark";
                                            else if (estado == "Rechazada") badgeClass = "bg-danger";
                                        }

                                        <span class="badge @badgeClass px-3 py-2">
                                            @estado
                                        </span>
                                    </td>

                                    <!-- Total -->
                                    <td class="text-end">
                                        <div class="fw-semibold">
                                            @total.ToString("C0", new System.Globalization.CultureInfo("es-CO"))
                                        </div>
                                        <div class="text-muted small">estimado</div>
                                    </td>

                                    <!-- Acciones (iconos estilo imagen1) -->
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary verOrdenBtn"
                                                title="Ver"
                                                data-id="@ordenServicio.IdOrden">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        @if (ordenServicio.Estado != "Rechazada" && ordenServicio.Estado != "Finalizada")
                                        {
                                            <button class="btn btn-sm btn-outline-primary modOrdenBtn"
                                                    title="Editar"
                                                    data-id="@ordenServicio.IdOrden">
                                                <i class="bi bi-pencil"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-success nuevaOrdenBtn"
                                                    title="Nuevo registro"
                                                    data-id="@ordenServicio.IdOrden">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-dark asignarTecnico"
                                                    title="Asignar técnico"
                                                    data-id="@ordenServicio.IdOrden">
                                                <i class="bi bi-person"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Tip -->
                <div class="small text-muted mt-2">
                    Tip: abre una orden para ver historial, repuestos, mano de obra, proforma y factura final.
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="unifiedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content rounded-4 shadow">
                <div class="modal-header bg-primary text-white">
                    <div>
                        <h5 class="modal-title mb-0">Gestión General</h5>
                        <div class="small opacity-75">Orden es obligatoria. Cliente y Dispositivo son opcionales si no existen.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- NAV TABS (Orden primero) -->
                    <ul class="nav nav-tabs mb-3" id="modalTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="orden-tab" data-bs-toggle="tab" data-bs-target="#ordenTab" type="button">
                                ✅ Orden (obligatorio)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="dispositivo-tab" data-bs-toggle="tab" data-bs-target="#dispositivoTab" type="button">
                                ➕ Dispositivo (opcional)
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="cliente-tab" data-bs-toggle="tab" data-bs-target="#clienteTab" type="button">
                                ➕ Cliente (opcional)
                            </button>
                        </li>
                    </ul>

                    <!-- TAB CONTENT -->
                    <div class="tab-content">

                        <!-- ================= TAB ORDEN ================= -->
                        <div class="tab-pane fade show active" id="ordenTab">
                            <div class="alert alert-info py-2 mb-3">
                                Esta orden se creará como <b>Ingresada</b>. El técnico se asigna después según disponibilidad.
                            </div>

                            <!-- ACCESOS RÁPIDOS -->
                            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkNoExisteDispositivo">
                                    <label class="form-check-label" for="chkNoExisteDispositivo">
                                        El dispositivo no existe → ir a crearlo
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkNoExisteCliente">
                                    <label class="form-check-label" for="chkNoExisteCliente">
                                        El cliente no existe → ir a crearlo
                                    </label>
                                </div>

                                <div class="ms-auto d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnIrADispositivo">
                                        ➕ Crear dispositivo
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnIrACliente">
                                        ➕ Crear cliente
                                    </button>
                                </div>
                            </div>

                            <form id="rowForm">
                                <div class="row g-2">

                                    <div class="col-md-5">
                                        <label class="form-label">Dispositivo <span class="text-danger">*</span></label>
                                        <select asp-for="orden.IdDispositivo" id="m_dispositivo" class="form-select" required>
                                            <option value="" selected disabled>Seleccione un dispositivo</option>
                                            @foreach (var dispositivo in Model.Dispositivos)
                                            {
                                                <option value="@dispositivo.IdDispositivo" data-detalle="@dispositivo.Detalle">
                                                    @dispositivo.IdDispositivo - @dispositivo.Cliente.NombreCliente - @dispositivo.FechaIngreso
                                                </option>
                                            }
                                        </select>
                                        <div class="form-text">Si no aparece, créalo en la pestaña <b>Dispositivo</b>.</div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Problema reportado <span class="text-danger">*</span></label>
                                        <textarea id="m_descripcion" class="form-control" rows="2" required
                                                  placeholder="Ej: No enciende, pantalla rota, se reinicia..."></textarea>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Estado</label>
                                        <select id="m_estado" class="form-select" disabled>
                                            <option value="Ingresada" selected>Ingresada</option>
                                        </select>
                                        <div class="form-text">Se asigna técnico después.</div>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label">Observación (opcional)</label>
                                        <textarea id="m_observacion" class="form-control" rows="3"
                                                  placeholder="Ej: No formatear, se entrega con cargador, urgencia..."></textarea>
                                    </div>

                                    <!-- DETALLE VISUAL -->
                                    <div class="col-md-12">
                                        <div class="border rounded p-2 bg-light">
                                            <div class="small text-muted">Detalle del dispositivo (referencia)</div>
                                            <div id="detalleDispositivoSel" class="small">Selecciona un dispositivo para ver el detalle.</div>
                                        </div>
                                    </div>

                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button class="btn btn-primary" type="submit">Crear Orden</button>
                                </div>
                            </form>
                        </div>

                        <!-- ================= TAB DISPOSITIVO ================= -->
                        <div class="tab-pane fade" id="dispositivoTab">
                            <div class="alert alert-secondary py-2 mb-3">
                                Crea un dispositivo solo si no existe. Si ya existe, vuelve a <b>Orden</b> y selecciónalo.
                            </div>

                            <form id="deviceForm">
                                <div class="row g-2">

                                    <div class="col-md-6">
                                        <label class="form-label">Cliente <span class="text-danger">*</span></label>
                                        <select id="d_cliente" class="form-select" required>
                                            <option value="" selected disabled>Seleccione un cliente</option>
                                            @foreach (var cliente in Model.Clientes)
                                            {
                                                <option value="@cliente.IdCliente">@cliente.NombreCliente</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Tipo Dispositivo <span class="text-danger">*</span></label>
                                        <select id="d_tipodispositivo" class="form-select" required>
                                            <option value="" selected disabled>Seleccione un tipo</option>
                                            @foreach (var servicio in Model.TipoDispositivos)
                                            {
                                                <option value="@servicio.TipoDispositivo">@servicio.Descripcion</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Fecha Ingreso <span class="text-danger">*</span></label>
                                        <input type="date" id="d_fecha" class="form-control" required>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Marca <span class="text-danger">*</span></label>
                                        <input id="d_marca" class="form-control" required placeholder="Ej: Samsung, HP">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Modelo <span class="text-danger">*</span></label>
                                        <input id="d_modelo" class="form-control" required placeholder="Ej: A52, Pavilion 15">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Accesorios / Estado físico (opcional)</label>
                                        <input id="d_detalle" class="form-control" placeholder="Ej: Se entrega con cargador, rayones...">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">IMEI (opcional)</label>
                                        <input id="d_imei" class="form-control" placeholder="Solo si aplica">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Clave o PIN (opcional)</label>
                                        <input id="d_clave" class="form-control" placeholder="Opcional">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Patrón (opcional)</label>
                                        <input id="d_patron" class="form-control" placeholder="Opcional">
                                    </div>

                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button class="btn btn-success" type="submit">Guardar Dispositivo</button>
                                </div>
                            </form>
                        </div>

                        <!-- ================= TAB CLIENTE ================= -->
                        <div class="tab-pane fade" id="clienteTab">
                            <div class="alert alert-secondary py-2 mb-3">
                                Crea un cliente solo si no existe. Luego vuelve a <b>Dispositivo</b> u <b>Orden</b>.
                            </div>

                            <form id="clienteForm">
                                <div class="row g-2">

                                    <div class="col-md-6">
                                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                                        <input id="c_nombre" class="form-control" required placeholder="Ej: Juan Pérez">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Teléfono <span class="text-danger">*</span></label>
                                        <input id="c_telefono" class="form-control" required placeholder="Ej: 3001234567">
                                    </div>

                                    <div class="col-md-12 mt-2">
                                        <a class="text-decoration-none" data-bs-toggle="collapse" href="#clienteOpcionales" role="button">
                                            + Datos opcionales
                                        </a>
                                    </div>

                                    <div class="collapse" id="clienteOpcionales">
                                        <div class="row g-2 mt-1">
                                            <div class="col-md-6">
                                                <label class="form-label">Cédula</label>
                                                <input id="c_cedula" class="form-control" placeholder="Opcional">
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Correo</label>
                                                <input type="email" id="c_correo" class="form-control" placeholder="Opcional">
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Ciudad</label>
                                                <input id="c_ciudad" class="form-control" placeholder="Opcional">
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Empresa</label>
                                                <input id="c_empresa" class="form-control" placeholder="Opcional">
                                            </div>

                                            <div class="col-md-12">
                                                <label class="form-label">Dirección</label>
                                                <input id="c_direccion" class="form-control" placeholder="Opcional">
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="d-flex justify-content-end gap-2 mt-3">
                                    <button class="btn btn-info" type="submit">Guardar Cliente</button>
                                </div>

                                <div class="small text-muted mt-2">
                                    * Campos obligatorios mínimos para registrar el cliente.
                                </div>
                            </form>
                        </div>

                    </div><!-- /tab-content -->

                </div><!-- /modal-body -->
            </div>
        </div>
    </div>

    <!-- Panel flotante -->
    <div id="sidePanel" class="position-fixed top-0 end-0 bg-light border-start shadow"
         style="width: 400px; height: 100%; display: none; z-index: 1050; overflow-y: auto;">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 id="sidePanelTitle" class="mb-0">Detalle</h5>
            <button type="button" class="btn-close" id="closePanel"></button>
        </div>
        <div class="p-3" id="sidePanelContent">
            <!-- Aquí se cargará el contenido dinámico -->
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/OrdenServicio/Index.js?v=@version"></script>
<script>
    // Para que JS sepa el rol/cedula sin volver a pedirlos
    window.__ROL__ = "@rolClaim";
    window.__CEDULA__ = "@cedulaClaim";
</script>