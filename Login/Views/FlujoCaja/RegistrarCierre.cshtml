@model CierreCajaViewModel
@{
    ViewData["Title"] = "RegistrarCierre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <h3 class="mb-4">Cierre de Caja - @DateTime.Today.ToShortDateString()</h3>

    <form asp-action="RegistrarCierre" method="post">
        @Html.AntiForgeryToken()

        <div class="card mb-4">
            <div class="card-header">
                <strong>Totales del día</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Efectivo ingresado</label>
                        <input asp-for="Efectivo" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Efectivo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Transferencias bancarias</label>
                        <input asp-for="Transferencia" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Transferencia" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gasto en efectivo</label>
                        <input asp-for="GastoEfectivo" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="GastoEfectivo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gasto por transferencia</label>
                        <input asp-for="GastoTransferencia" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="GastoTransferencia" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Conceptos de servicios (auto del día + manual)</strong>
                <button type="button" id="btnAddConcepto" class="btn btn-sm btn-outline-primary">
                    Agregar concepto
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle" id="tablaConceptos">
                        <thead>
                            <tr>
                                <th style="width:35%">Servicio</th>
                                <th style="width:20%">Total SubTotal</th>
                                <th style="width:20%">Total VNeto</th>
                                <th style="width:10%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Conceptos != null && Model.Conceptos.Any())
                            {
                                for (int i = 0; i < Model.Conceptos.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" name="Conceptos[@i].IdServicio" value="@Model.Conceptos[i].IdServicio" />
                                            <input name="Conceptos[@i].NombreServicio" value="@Model.Conceptos[i].NombreServicio"
                                                   class="form-control" />
                                        </td>
                                        <td>
                                            <input name="Conceptos[@i].TotalSubTotal" value="@Model.Conceptos[i].TotalSubTotal"
                                                   class="form-control total-subtotal" type="text" />
                                        </td>
                                        <td>
                                            <input name="Conceptos[@i].TotalVNeto" value="@Model.Conceptos[i].TotalVNeto"
                                                   class="form-control total-vneto" type="text" />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger btnRemoveRow">Quitar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-end">Totales</th>
                                <th><span id="sumaSubTotal">0.00</span></th>
                                <th><span id="sumaVNeto">0.00</span></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Plantilla para nuevas filas -->
                <template id="rowTemplate">
                    <tr>
                        <td>
                            <input type="hidden" name="Conceptos[__index__].IdServicio" value="0" />
                            <input name="Conceptos[__index__].NombreServicio" class="form-control" placeholder="Ej: Accesorios" />
                        </td>
                        <td>
                            <input name="Conceptos[__index__].TotalSubTotal" class="form-control total-subtotal" type="text" value="0.00" />
                        </td>
                        <td>
                            <input name="Conceptos[__index__].TotalVNeto" class="form-control total-vneto" type="text" value="0.00" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger btnRemoveRow">Quitar</button>
                        </td>
                    </tr>
                </template>
            </div>
        </div>
            <button type="submit" class="btn btn-primary">Guardar Cierre</button>
        
    </form>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const tbody = document.querySelector('#tablaConceptos tbody');
            const btnAdd = document.getElementById('btnAddConcepto');
            const tpl = document.getElementById('rowTemplate');
            const sumaSubTotal = document.getElementById('sumaSubTotal');
            const sumaVNeto = document.getElementById('sumaVNeto');

            let idx = tbody.querySelectorAll('tr').length;

            function recalc() {
                let tSub = 0, tNet = 0;
                tbody.querySelectorAll('.total-subtotal').forEach(i => {
                    const v = parseFloat(i.value);
                    if (!isNaN(v)) tSub += v;
                });
                tbody.querySelectorAll('.total-vneto').forEach(i => {
                    const v = parseFloat(i.value);
                    if (!isNaN(v)) tNet += v;
                });
                sumaSubTotal.textContent = tSub.toFixed(2);
                sumaVNeto.textContent = tNet.toFixed(2);
            }

            function wire(tr) {
                tr.querySelectorAll('.total-subtotal, .total-vneto').forEach(inp => {
                    inp.addEventListener('input', recalc);
                });
                tr.querySelector('.btnRemoveRow')?.addEventListener('click', () => {
                    tr.remove();
                    recalc();
                });
            }

            btnAdd.addEventListener('click', () => {
                const html = tpl.innerHTML.replaceAll('__index__', idx);
                const wrap = document.createElement('tbody');
                wrap.innerHTML = html.trim();
                const tr = wrap.firstElementChild;
                tbody.appendChild(tr);
                wire(tr);
                idx++;
                recalc();

                if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                    const form = jQuery(tr.closest('form'));
                    jQuery.validator.unobtrusive.parse(form);
                }
            });

            // inicial
            tbody.querySelectorAll('tr').forEach(wire);
            recalc();
        })();
    </script>
}
