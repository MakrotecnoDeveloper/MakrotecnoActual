@model CierreCajaViewModel
@{
    ViewData["Title"] = "RegistrarCierre";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <h3 class="mb-4">Cierre de Caja - @ViewBag.FechaTrabajo</h3>

        @if (TempData["Ok"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["Ok"]
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger mt-3">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="alert alert-secondary">
            <strong>Empresa:</strong> @User.FindFirst("NombreEmpresa")?.Value <br />
            <strong>Sede:</strong> @User.FindFirst("NombreSede")?.Value <br />
            <strong>PDV:</strong> @User.FindFirst("NombrePdv")?.Value
        </div>

        <!-- Formulario GET para consultar otra fecha -->
        <div class="card mb-3">
            <div class="card-body">
                <form asp-action="RegistrarCierre" method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Fecha de cierre</label>
                        <input type="date"
                               id="fechaConsulta"
                               name="fecha"
                               class="form-control"
                               value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary">Consultar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Formulario POST para guardar cierre -->
        <form asp-action="RegistrarCierre" method="post" id="formRegistrarCierre">
            @Html.AntiForgeryToken()
            <input asp-for="Fecha" type="hidden" id="fechaHidden" />

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Totales del día</strong>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Efectivo ingresado</label>
                            <input id="EfectivoVisible"
                                   name="EfectivoVisible"
                                   class="form-control decimal-input"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   value="@Model.Efectivo.ToString("0.00")" />
                            <span asp-validation-for="Efectivo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Transferencias bancarias</label>
                            <input id="TransferenciaVisible"
                                   name="TransferenciaVisible"
                                   class="form-control decimal-input"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   value="@Model.Transferencia.ToString("0.00")" />
                            <span asp-validation-for="Transferencia" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Gasto en efectivo</label>
                            <input id="GastoEfectivoVisible"
                                   name="GastoEfectivoVisible"
                                   class="form-control decimal-input"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   value="@Model.GastoEfectivo.ToString("0.00")" />
                            <span asp-validation-for="GastoEfectivo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Gasto por transferencia</label>
                            <input id="GastoTransferenciaVisible"
                                   name="GastoTransferenciaVisible"
                                   class="form-control decimal-input"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   value="@Model.GastoTransferencia.ToString("0.00")" />
                            <span asp-validation-for="GastoTransferencia" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Total facturado del sistema:</strong> @Model.TotalFacturado.ToString("N2")
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Conceptos de servicios (auto del día + manual)</strong>
                    <button type="button" id="btnAddConcepto" class="btn btn-sm btn-outline-primary">
                        Agregar concepto
                    </button>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle" id="tablaConceptos">
                            <thead>
                                <tr>
                                    <th style="width:35%">Servicio</th>
                                    <th style="width:20%">Total SubTotal</th>
                                    <th style="width:20%">Total VNeto</th>
                                    <th style="width:10%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Conceptos != null && Model.Conceptos.Any())
                                {
                                    for (int i = 0; i < Model.Conceptos.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" name="Conceptos[@i].IdServicio" value="@Model.Conceptos[i].IdServicio" />
                                                <input name="Conceptos[@i].NombreServicio"
                                                       value="@Model.Conceptos[i].NombreServicio"
                                                       class="form-control"
                                                       placeholder="Ej: Accesorios" />
                                            </td>
                                            <td>
                                                <input name="Conceptos[@i].TotalSubTotal"
                                                       value="@Model.Conceptos[i].TotalSubTotal.ToString("0.00")"
                                                       class="form-control total-subtotal decimal-input"
                                                       type="text"
                                                       inputmode="decimal"
                                                       autocomplete="off" />
                                            </td>
                                            <td>
                                                <input name="Conceptos[@i].TotalVNeto"
                                                       value="@Model.Conceptos[i].TotalVNeto.ToString("0.00")"
                                                       class="form-control total-vneto decimal-input"
                                                       type="text"
                                                       inputmode="decimal"
                                                       autocomplete="off" />
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger btnRemoveRow">
                                                    Quitar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-end">Totales</th>
                                    <th><span id="sumaSubTotal">0.00</span></th>
                                    <th><span id="sumaVNeto">0.00</span></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <template id="rowTemplate">
                        <tr>
                            <td>
                                <input type="hidden" name="Conceptos[__index__].IdServicio" value="0" />
                                <input name="Conceptos[__index__].NombreServicio"
                                       class="form-control"
                                       placeholder="Ej: Accesorios" />
                            </td>
                            <td>
                                <input name="Conceptos[__index__].TotalSubTotal"
                                       class="form-control total-subtotal decimal-input"
                                       type="text"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       value="0,00" />
                            </td>
                            <td>
                                <input name="Conceptos[__index__].TotalVNeto"
                                       class="form-control total-vneto decimal-input"
                                       type="text"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       value="0,00" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger btnRemoveRow">
                                    Quitar
                                </button>
                            </td>
                        </tr>
                    </template>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar Cierre</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const tbody = document.querySelector('#tablaConceptos tbody');
            const btnAdd = document.getElementById('btnAddConcepto');
            const tpl = document.getElementById('rowTemplate');
            const sumaSubTotal = document.getElementById('sumaSubTotal');
            const sumaVNeto = document.getElementById('sumaVNeto');
            const fechaConsulta = document.getElementById('fechaConsulta');
            const fechaHidden = document.getElementById('fechaHidden');
            const form = document.getElementById('formRegistrarCierre');

            let idx = tbody ? tbody.querySelectorAll('tr').length : 0;

            function parseFlexibleNumber(value) {
                if (value === null || value === undefined) return 0;

                let raw = value.toString().trim();
                if (raw === '') return 0;

                raw = raw.replace(/\s/g, '');

                const lastComma = raw.lastIndexOf(',');
                const lastDot = raw.lastIndexOf('.');

                if (lastComma > -1 && lastDot > -1) {
                    if (lastComma > lastDot) {
                        raw = raw.replace(/\./g, '');
                        raw = raw.replace(',', '.');
                    } else {
                        raw = raw.replace(/,/g, '');
                    }
                } else if (lastComma > -1) {
                    raw = raw.replace(/\./g, '');
                    raw = raw.replace(',', '.');
                } else {
                    const parts = raw.split('.');
                    if (parts.length > 2) {
                        const decimalPart = parts.pop();
                        raw = parts.join('') + '.' + decimalPart;
                    }
                }

                const parsed = parseFloat(raw);
                return isNaN(parsed) ? 0 : parsed;
            }

            function formatForDisplay(value) {
                const num = parseFlexibleNumber(value);
                return num.toLocaleString('es-CO', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function formatForServer(value) {
                const num = parseFlexibleNumber(value);
                return num.toFixed(2); // Ej: 6000.00
            }

            function setHiddenValue(visibleId, hiddenId) {
                const visible = document.getElementById(visibleId);
                const hidden = document.getElementById(hiddenId);

                if (!visible || !hidden) return;

                hidden.value = formatForServer(visible.value);
            }

            function recalc() {
                let tSub = 0;
                let tNet = 0;

                document.querySelectorAll('.total-subtotal').forEach(i => {
                    tSub += parseFlexibleNumber(i.value);
                });

                document.querySelectorAll('.total-vneto').forEach(i => {
                    tNet += parseFlexibleNumber(i.value);
                });

                if (sumaSubTotal) {
                    sumaSubTotal.textContent = tSub.toLocaleString('es-CO', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }

                if (sumaVNeto) {
                    sumaVNeto.textContent = tNet.toLocaleString('es-CO', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            }

            function wire(tr) {
                tr.querySelectorAll('.total-subtotal, .total-vneto').forEach(inp => {
                    inp.addEventListener('input', recalc);

                    inp.addEventListener('blur', function () {
                        this.value = formatForDisplay(this.value);
                        recalc();
                    });
                });

                tr.querySelector('.btnRemoveRow')?.addEventListener('click', () => {
                    tr.remove();
                    recalc();
                });
            }

            document.querySelectorAll('.decimal-input').forEach(inp => {
                inp.value = formatForDisplay(inp.value);

                inp.addEventListener('blur', function () {
                    this.value = formatForDisplay(this.value);
                    recalc();
                });
            });

            if (fechaConsulta && fechaHidden) {
                fechaConsulta.addEventListener('change', function () {
                    fechaHidden.value = this.value;
                });
            }

            if (btnAdd && tpl && tbody) {
                btnAdd.addEventListener('click', () => {
                    const html = tpl.innerHTML.replaceAll('__index__', idx);
                    const wrap = document.createElement('tbody');
                    wrap.innerHTML = html.trim();
                    const tr = wrap.firstElementChild;

                    tbody.appendChild(tr);
                    wire(tr);
                    idx++;
                    recalc();

                    if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        const jqForm = jQuery(tr.closest('form'));
                        jQuery.validator.unobtrusive.parse(jqForm);
                    }
                });
            }

            if (tbody) {
                tbody.querySelectorAll('tr').forEach(wire);
            }

            if (form) {
                form.addEventListener('submit', function () {
                    setHiddenValue('EfectivoVisible', 'Efectivo');
                    setHiddenValue('TransferenciaVisible', 'Transferencia');
                    setHiddenValue('GastoEfectivoVisible', 'GastoEfectivo');
                    setHiddenValue('GastoTransferenciaVisible', 'GastoTransferencia');

                    form.querySelectorAll('.total-subtotal, .total-vneto').forEach(inp => {
                        inp.value = formatForServer(inp.value);
                    });
                });
            }

            recalc();
        })();
    </script>
}