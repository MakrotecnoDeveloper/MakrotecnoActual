@model Plataforma.Models.ViewModels.Cxc.CxcDetalleViewModel
@{
    ViewData["Title"] = "Detalle CxC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Detalle Cuenta por Cobrar #@Model.IdCxc</h2>
            @if (Model.EstadoCxc != "Pagada" && Model.EstadoCxc != "Anulada")
            {
                <a asp-action="RegistrarPago" asp-route-idCxc="@Model.IdCxc" class="btn btn-success">
                    Registrar pago
                </a>
            }
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <p><strong>Venta:</strong> @Model.IdVenta</p>
                <p><strong>Cliente:</strong> @Model.Cliente (@Model.CedulaCliente)</p>
                <p><strong>Total:</strong> @Model.Total.ToString("N2")</p>
                <p><strong>Total pagado:</strong> @Model.TotalPagado.ToString("N2")</p>
                <p><strong>Saldo pendiente:</strong> @Model.SaldoPendiente.ToString("N2")</p>
                <p><strong>Estado:</strong> @Model.EstadoCxc</p>
                <p><strong>Fecha creación:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Fecha vencimiento:</strong> @(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")</p>
                <p><strong>Observación:</strong> @(string.IsNullOrWhiteSpace(Model.Observacion) ? "-" : Model.Observacion)</p>
            </div>
        </div>

        <h4>Pagos registrados</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-secondary">
                    <tr>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Monto</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Pagos.Any())
                    {
                        foreach (var pago in Model.Pagos)
                        {
                            <tr>
                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@pago.MetodoPago</td>
                                <td>@pago.MontoPago.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(pago.Observacion) ? "-" : pago.Observacion)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No hay pagos registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>