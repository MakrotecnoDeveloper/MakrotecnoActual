@model Plataforma.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container">

<div class="container">
    <h2>Chat de Productos</h2>

    <div id="chat-window" style="height: 400px; overflow-y: scroll; border: 1px solid #ccc;">
        <!-- Aquí se cargarán los mensajes del chat -->
        <div id="chat-messages">
            @{
                Html.RenderPartial("_ChatMessages", Model);
            }
        </div>
    </div>

    <form id="chat-form" method="post">
        <div class="form-group">
            <textarea class="form-control" name="Mensaje" id="mensaje" placeholder="Escribe tu consulta..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Función para manejar el envío del formulario
            $('#chat-form').submit(function (e) {
                e.preventDefault();
                var mensaje = $('#mensaje').val();
                $.ajax({
                    url: '@Url.Action("MsjChatGPT", "Producto")',
                    type: 'POST',
                    data: {
                        Mensaje: mensaje
                    },
                    success: function (response) {
                        $('#chat-messages').html(response);
                        $('#mensaje').val('');  // Limpiar el input de texto
                    },
                    error: function (xhr, status, error) {
                    console.error("Status: " + status);
                    console.error("Error: " + error);
                    console.error("Response: " + xhr.responseText);
                    alert("Error al enviar el mensaje");
                }
                });
            });
        });
    </script>
}

</<div>
</div>
