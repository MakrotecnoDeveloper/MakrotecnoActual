@model ProductosIndexViewModel
<link rel="stylesheet" href="~/css/Producto/Index.css">
@{
    ViewData["Title"] = "Visualizar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rolUsuario = User.Claims.FirstOrDefault(c => c.Type == "NombreRol")?.Value;
    var esRol6 = rolUsuario == "Administrador"; // true si tiene rol 6
    var jsData = new { rolUsuario, esRol6 };
}
<div class="content-wrapper">
 
    <!-- ====== MENÚ FILTRO RESPONSIVE ====== -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand font-weight-bold text-info">Filtrar por:</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#filterMenu" aria-controls="filterMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="filterMenu">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('stock')">Con stock</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('low')">Casi sin stock (&lt;3)</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('none')">Sin stock</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('categoria')">Categoría</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('servicio')">Servicio</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('codigo')">Por código</button></li>
                    <li class="nav-item"><button class="btn btn-dark mx-1 my-1" onclick="filterBy('nombre')">Por nombre</button></li>
                </ul>
            </div>

        </div>
    </nav>

    <main class="main">
        <div class="topbar">
            <h1>Inventario de Productos</h1>
            <input type="text" id="searchInput" placeholder="Buscar por nombre o código..." oninput="searchProducts()">
        </div>

        <div id="grid" class="grid"></div>

        <div class="pagination">
            <button id="prevBtn" onclick="prevPage()">Anterior</button>
            <span id="pageInfo">Página 1</span>
            <button id="nextBtn" onclick="nextPage()">Siguiente</button>
        </div>
    </main>

</div>
<script>
    window.modelo = @Html.Raw(Json.Serialize(Model));
    const editarProductoUrl = '@Url.Action("Editar", "Producto")';
    const eliminarProductoUrl = '@Url.Action("Eliminar", "Producto")';
    window.userData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jsData));
</script>
<script src="~/js/Producto/Index.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
