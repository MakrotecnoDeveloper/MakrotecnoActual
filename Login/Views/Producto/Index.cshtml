    function handleCategorySelection(selectElement) {
        const categoriaSeleccionada = selectElement.value;
        // Envía la categoría seleccionada al controlador usando AJAX
        sendSelectedCategoryToController(categoriaSeleccionada);
    }

    function handleProductCodeSearch() {
        const terminoBusqueda = document.getElementById('searchTerm').value;
        // Envía el término de búsqueda al controlador usando AJAX
        sendSearchTermToController(terminoBusqueda);
    }

    function sendSelectedCategoryToController(categoriaSeleccionada) {
        const searchTerm = "";
        $.ajax({
            url: '/Producto/Buscar', // Reemplaza con la URL real de la acción del controlador
            type: 'POST',
            data: { searchTerm: searchTerm, categoriaTerm: categoriaSeleccionada },
            success: function (response) {
                // Maneja la respuesta exitosa del controlador
                // Actualiza la tabla usando los datos recibidos
                $("#resultados").html(response);
            },
            error: function (error) {
                // Maneja el error durante la solicitud AJAX
                console.error('Error enviando categoría:', error);
            }
        });
    }
    function sendSearchTermToController(terminoBusqueda) {
        const categoriaTerm = "";
        $.ajax({
            url: '/Producto/Buscar', // Reemplaza con la URL real de la acción del controlador
            type: 'POST',
            data: { searchTerm: terminoBusqueda, categoriaTerm: categoriaTerm },
            success: function (response) {
                // Maneja la respuesta exitosa del controlador
                // Actualiza la tabla usando los datos recibidos
                $("#resultados").html(response);
            },
            error: function (error) {
                // Maneja el error durante la solicitud AJAX
                console.error('Error enviando término de búsqueda:', error);
            }
        });
    }
</script>