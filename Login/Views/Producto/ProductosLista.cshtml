@model ProductosIndexVm
@{
    ViewData["Title"] = "Inventario por sede";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <label asp-for="FiltroSedeId" class="form-label">Sede</label>
            <select asp-for="FiltroSedeId" class="form-select">
                <option value="">Todas las sedes</option>
                @foreach (var sede in Model.Sede)
                {
                    <option value="@sede.Id_sede">@sede.NombreSede</option>
                }
            </select>
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label">Buscar (SKU/Producto)</label>
        <input id="q" class="form-control" value="@Model.Q" placeholder="Ej: ABC123 / Shampo Hidratante" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Tamaño página</label>
        <select id="pageSize" class="form-select">
            <option>10</option>
            <option selected>20</option>
            <option>50</option>
            <option>100</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button id="btnBuscar" class="btn btn-primary">Buscar</button>
        <button id="btnExcel" class="btn btn-success">Exportar Excel</button>
        <button id="btnAsignarCantidad" class="btn btn-success">Asignar Cantidad</button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <span id="resumen" class="badge bg-secondary">Cargando...</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label m-0">Ordenar por:</label>
            <select id="sortBy" class="form-select form-select-sm">
                <option value="nombre">Nombre</option>
                <option value="cantidad">Cantidad</option>
            </select>
            <select id="sortDir" class="form-select form-select-sm">
                <option value="false">Asc</option>
                <option value="true">Desc</option>
            </select>
        </div>
    </div>

    <table class="table table-striped" id="tablaStock">
        <thead>
            <tr>
                <th>Codigo</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Valor Venta</th>
                <th>Valor Unidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <nav>
        <ul id="paginador" class="pagination"></ul>
    </nav>

    <!-- MODAL: Asignar Cantidad -->
    <div class="modal fade" id="cantidadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="POST" asp-action="AsignacionSedeProducto" asp-controller="Producto" id="formAsignarCantidad">
                    <div class="modal-header">
                        <h5 class="modal-title">Asignar Cantidad a Sede</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-2">
                            <label>Producto</label>
                            <input type="text" id="producto" class="form-control codigoProducto" placeholder="Escribe el nombre del producto..." name="producto" />
                            <div class="opcionesCodigosProducto small text-muted"></div>
                        </div>

                        <ul id="autocomplete-results" class="list-group position-absolute w-100" style="z-index:1000; display:none;"></ul>

                        <div class="mb-2">
                            <label>Sedes</label>
                            <select id="sede" name="sede" class="form-select">
                                @foreach (var sede in Model.Sede)
                                {
                                    <option value="@sede.Id_sede">@sede.NombreSede</option>
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <label>Cantidad</label>
                            <input type="number" id="cantidad" class="form-control" name="cantidad">
                        </div>

                        <div class="mb-2">
                            <label>Valor Unidad</label>
                            <input type="number" id="vunidadModal" class="form-control" name="vUnidad">
                        </div>

                        <div class="mb-2">
                            <label>Valor Venta</label>
                            <input type="number" id="vventa" class="form-control" name="valorVenta">
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cerrar</button>
                        <button class="btn btn-success" type="submit">Agregar Cantidad</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Editar Producto -->
    <div class="modal fade" id="modalEditarProducto" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <form id="formEditarProducto">
                        <div class="mb-3">
                            <label class="form-label">Código</label>
                            <input type="text" id="editProductoId" class="form-control" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" id="editNombre" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Valor Unidad</label>
                            <input type="number" id="editVUnidad" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Valor Venta</label>
                            <input type="number" id="editValorVenta" class="form-control">
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="chkEditarCantidad">
                            <label class="form-check-label" for="chkEditarCantidad">
                                ¿Desea agregar cantidad a esta sede?
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad a agregar</label>
                            <input type="number" id="editCantidad" class="form-control" value="0" disabled>
                            <div class="form-text">
                                Por defecto este campo está deshabilitado para que solo se actualicen Valor Unidad y Valor Venta.
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnGuardarProducto" class="btn btn-primary">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function ($) {

            // =====================
            // LISTADO DE STOCK
            // =====================
            const $sede = $('#FiltroSedeId');
            const $q = $('#q');
            const $pageSize = $('#pageSize');
            const $sortBy = $('#sortBy');
            const $sortDir = $('#sortDir');
            const $resumen = $('#resumen');
            const $tbodyStock = $('#tablaStock tbody');
            const $paginador = $('#paginador');

            const state = {
                sedeId: $sede.val() || null,
                q: $q.val() || '',
                page: 1,
                pageSize: parseInt($pageSize.val(), 10) || 20,
                sortBy: $sortBy.val() || 'nombre',
                desc: $sortDir.val() === 'true'
            };

            function cargarStock() {
                window.cargarStock = cargarStock;

                $resumen.text('Cargando...');

                const params = {
                    sedeId: state.sedeId || null,
                    q: state.q,
                    page: state.page,
                    pageSize: state.pageSize,
                    sortBy: state.sortBy,
                    desc: state.desc
                };

                $.get('@Url.Action("StockAsignacionProductoSede", "Producto")', params)
                    .done(function (resp) {
                        if (!resp || !resp.ok) return;

                        $tbodyStock.empty();
                        resp.data.forEach(row => {
                            $tbodyStock.append(
                                `<tr>
                                    <td>${row.productoId}</td>
                                    <td>${row.nombre}</td>
                                    <td>${Number(row.cantidad).toLocaleString()}</td>
                                    <td>${row.valorVenta != null ? Number(row.valorVenta).toLocaleString() : '-'}</td>
                                    <td>${row.valorUnidad != null ? Number(row.valorUnidad).toLocaleString() : '-'}</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-dark"
                                           href="/Producto/ImprimirSticker?codProducto=${encodeURIComponent(row.productoId)}&copias=1&anchoMm=50&altoMm=25"
                                           target="_blank" title="Imprimir sticker 50x25">
                                           🖨 Sticker 50x25
                                        </a>

                                        <button class="btn btn-sm btn-primary btn-editar" data-id="${row.productoId}">
                                            Editar
                                        </button>
                                    </td>
                                </tr>`
                            );
                        });

                        $resumen.text(
                            `Unidades: ${Number(resp.totalUnidades).toLocaleString()} | ` +
                            `Página ${resp.page} / ${resp.totalPages} (Total filas: ${resp.totalRows})`
                        );

                        renderPaginador(resp.page, resp.totalPages);
                    })
                    .fail(() => $resumen.text('Error al cargar.'));
            }

            function renderPaginador(page, totalPages) {
                $paginador.empty();

                function li(p, text, disabled = false, active = false) {
                    return `<li class="page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}">
                                <a class="page-link" href="#" data-page="${p}">${text}</a>
                            </li>`;
                }

                $paginador.append(li(1, '&laquo;', page === 1));
                $paginador.append(li(page - 1, '&lsaquo;', page === 1));

                const start = Math.max(1, page - 2);
                const end = Math.min(totalPages, page + 2);

                for (let i = start; i <= end; i++) {
                    $paginador.append(li(i, i, false, i === page));
                }

                $paginador.append(li(page + 1, '&rsaquo;', page === totalPages));
                $paginador.append(li(totalPages, '&raquo;', page === totalPages));
            }

            $paginador.on('click', 'a.page-link', function (e) {
                e.preventDefault();
                const p = parseInt($(this).data('page'), 10);
                if (!isNaN(p)) {
                    state.page = p;
                    cargarStock();
                }
            });

            $sede.on('change', function () {
                state.sedeId = $(this).val() || null;
                state.page = 1;
                cargarStock();
            });

            $pageSize.on('change', function () {
                state.pageSize = parseInt($(this).val(), 10) || 20;
                state.page = 1;
                cargarStock();
            });

            $('#btnBuscar').on('click', function () {
                state.q = $q.val() || '';
                state.page = 1;
                cargarStock();
            });

            $sortBy.add($sortDir).on('change', function () {
                state.sortBy = $sortBy.val();
                state.desc = ($sortDir.val() === 'true');
                state.page = 1;
                cargarStock();
            });

            $('#btnExcel').on('click', function () {
                const params = $.param({
                    sedeId: state.sedeId || '',
                    q: state.q || '',
                    sortBy: state.sortBy || '',
                    desc: state.desc
                });

                window.location = '@Url.Action("ExportarExcel", "Producto")' + '?' + params;
            });

            cargarStock();

        })(jQuery);

        // Abrir modal Asignar Cantidad
        document.getElementById("btnAsignarCantidad").addEventListener("click", function () {
            new bootstrap.Modal(document.getElementById("cantidadModal")).show();
        });

                // Enfocar automáticamente el campo Producto al abrir el modal
        $('#cantidadModal').on('shown.bs.modal', function () {
            $('#producto').focus().select();
        });

        // Evitar que el lector o el usuario dispare Enter en el campo Producto
        $(document).on('keydown', '#producto', function (e) {
            if (e.key === 'Enter' || e.key === 'NumpadEnter' || e.keyCode === 13) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        // Limpia saltos de línea por si el lector envía retorno de carro
        $(document).on('input', '#producto', function () {
            this.value = this.value.replace(/[\r\n]+/g, '');
        });

        // Seguridad extra: si por alguna razón el Enter se propaga dentro del form,
        // también lo bloquea solo cuando el foco está en el input Producto
        $('#formAsignarCantidad').on('keydown', function (e) {
            const activo = document.activeElement;
            if ((e.key === 'Enter' || e.key === 'NumpadEnter' || e.keyCode === 13) && activo && activo.id === 'producto') {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        // Autocompletado de producto por código o nombre
        function mostrarOpcionesAutocompletado(opciones, container) {
            var opcionesHtml = '';
            opciones.forEach(function (opcion) {
                opcionesHtml += '<div class="opcion" data-value="' + opcion.value + '">' + opcion.label + '</div>';
            });
            container.html(opcionesHtml);
        }

        $(document).on('input', '.codigoProducto', function () {
            var inputActual = $(this);
            var codigo = inputActual.val();
            var contenedorOpciones = inputActual.siblings('.opcionesCodigosProducto');

            if (codigo.length >= 3) {
                $.ajax({
                    url: '/Producto/BuscarProductoPorCodigoVenta',
                    type: 'GET',
                    data: { codigo: codigo },
                    success: function (response) {
                        mostrarOpcionesAutocompletado(response, contenedorOpciones);
                    },
                    error: function () {
                        console.error('Error al obtener los códigos.');
                        contenedorOpciones.empty();
                    }
                });
            } else {
                contenedorOpciones.empty();
            }
        });

        // Selección de autocompletado
        $(document).on('click', '.opcion', function () {
            var codigo = $(this).data('value');
            var contenedorOpciones = $(this).closest('.opcionesCodigosProducto');
            var inputCodigo = contenedorOpciones.siblings('.codigoProducto');

            inputCodigo.val(codigo);
            contenedorOpciones.empty();

            $.ajax({
                url: '/Producto/BuscarProductoPorCodigoVenta',
                type: 'GET',
                data: { codigo: codigo },
                success: function (data) {
                    if (Array.isArray(data) && data.length > 0) {
                        var producto = data[0];
                        $('#vunidadModal').val(producto.vUnidad ?? producto.valorUnidad ?? 0);
                        $('#vventa').val(producto.valorVenta ?? 0);
                    }
                },
                error: function () {
                    console.error('Error al obtener los datos del producto.');
                }
            });
        });

        // Habilitar o deshabilitar cantidad en editar
        $('#chkEditarCantidad').on('change', function () {
            if ($(this).is(':checked')) {
                $('#editCantidad').prop('disabled', false).val('').focus();
            } else {
                $('#editCantidad').prop('disabled', true).val(0);
            }
        });

        // Modal editar producto
        $(document).on('click', '.btn-editar', function () {
            const productoId = $(this).data('id');

            $.get('/Producto/ObtenerProductoPorId', { id: productoId })
                .done(function (data) {
                    if (data) {
                        $('#editProductoId').val(data.productoId);
                        $('#editNombre').val(data.nombre);
                        $('#editVUnidad').val(data.valorUnidad ?? 0);
                        $('#editValorVenta').val(data.valorVenta ?? 0);

                        // por defecto NO modificar cantidad
                        $('#chkEditarCantidad').prop('checked', false);
                        $('#editCantidad').prop('disabled', true).val(0);

                        const modal = new bootstrap.Modal(document.getElementById('modalEditarProducto'));
                        modal.show();
                    }
                })
                .fail(function () {
                    alert('Error al cargar el producto.');
                });
        });

        // Resetear al cerrar modal
        $('#modalEditarProducto').on('hidden.bs.modal', function () {
            $('#chkEditarCantidad').prop('checked', false);
            $('#editCantidad').prop('disabled', true).val(0);
        });

        // Guardar cambios del modal editar
        $('#btnGuardarProducto').on('click', function () {
            const agregarCantidad = $('#chkEditarCantidad').is(':checked');
            const cantidad = agregarCantidad ? (parseFloat($('#editCantidad').val()) || 0) : 0;

            if (agregarCantidad && cantidad <= 0) {
                alert('Debe ingresar una cantidad mayor a 0.');
                return;
            }

            const datos = {
                productoId: $('#editProductoId').val(),
                nombre: $('#editNombre').val(),
                vUnidad: $('#editVUnidad').val(),
                valorVenta: $('#editValorVenta').val(),
                cantidad: cantidad
            };

            $.post('/Producto/ActualizarProducto', datos)
                .done(function (resp) {
                    if (resp.ok) {
                        alert(resp.message || 'Producto actualizado correctamente');

                        const modalEl = document.getElementById('modalEditarProducto');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();

                        if (window.cargarStock) {
                            window.cargarStock();
                        }
                    } else {
                        alert(resp.message || 'Error al actualizar el producto');
                    }
                })
                .fail(() => alert('Error al intentar actualizar el producto.'));
        });
    </script>
}