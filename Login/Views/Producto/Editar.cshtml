@model List<Producto>
@using System.Globalization
@{
    ViewData["Title"] = "Editar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var p = Model?.FirstOrDefault();
    var servicios = ViewBag.Servicios as IEnumerable<dynamic>;
    var proveedores = ViewBag.Proveedores as IEnumerable<dynamic>;
    var selectedServicioId = ViewBag.SelectedServicioId as int?;  // puede venir null
}

<div class="content-wrapper py-4" style="background-color: #f8f9fa;">
@if (p == null)
{
    <div class="container"><div class="alert alert-warning">No se encontró producto para editar.</div></div>
}
else
{
    <form asp-controller="Producto" asp-action="EditarProducto" method="POST" id="formEditarProducto" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="container">
            <!-- Título -->
            <div class="row mb-4">
                <div class="col-md-8 mx-auto text-center">
                    <h1 class="fw-bold text-primary mb-2"><i class="bi bi-pencil-square"></i> Editar Producto</h1>
                    <p class="text-muted">Actualizacion del producto @p.Cod_Producto</p>
                    <hr class="w-50 mx-auto" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mx-auto">
                    <div class="card shadow-lg border-0 rounded-3">
                        <div class="card-body p-4">

                            <!-- Código (visible, pero se postea como hidden) -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Código</label>
                                <div class="form-control bg-light" readonly>@p.Cod_Producto</div>
                                <input type="hidden" name="codigo" value="@p.Cod_Producto" />
                            </div>

                            <!-- Nombre -->
                            <div class="mb-3">
                                <label for="nombreProducto" class="form-label fw-semibold">Nombre</label>
                                <input type="text" class="form-control" name="nombreProducto" value="@p.NombreProducto"/>
                            </div>

                                <!-- Servicio (UI, no se postea) -->
                                <div class="mb-3">
                                    <label for="servicio" class="form-label fw-semibold">Servicio</label>
                                    <select id="servicio" class="form-select">
                                        @if (servicios != null)
                                        {
                                            foreach (var s in servicios)
                                            {
                                                if (selectedServicioId.HasValue && selectedServicioId.Value == (int)s.IdServicio)
                                                {
                                                    <option value="@s.IdServicio" selected="selected">@s.NombreServicio</option>
                                                }
                                                else
                                                {
                                                    <option value="@s.IdServicio">@s.NombreServicio</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>

                            <!-- Categorías (depende de Servicio, UI sin name) -->
                            <div class="mb-3">
                                <label for="categorias" class="form-label fw-semibold">Categorías</label>
                                <select id="categorias" class="form-select" name="categorias">

                                </select>
                            </div>

                            <!-- Proveedor (UI, no se postea) -->
                            <div class="mb-3">
                                <label for="proveedor" class="form-label fw-semibold">Proveedor</label>
                                    <select id="proveedor" class="form-select" name="id_proveedor">
                                        @if (proveedores != null)
                                        {
                                            foreach (var pr in proveedores)
                                            {
                                                if (ViewBag.SelectedProveedorId != null && (int)ViewBag.SelectedProveedorId == pr.IdProveedor)
                                                {
                                                    <option value="@pr.IdProveedor" selected="selected">@pr.RazonSocial</option>
                                                }
                                                else
                                                {
                                                    <option value="@pr.IdProveedor">@pr.RazonSocial</option>
                                                }
                                            }
                                        }
                                    </select>
                            </div>

                                <!-- Valor Neto -->
                                <div class="mb-3">
                                    <label for="valorNeto" class="form-label fw-semibold">Valor Neto</label>
                                    <input type="number" class="form-control" id="valorNeto" name="valorNeto"
                                           value="@(p.ValorNetoProducto?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0")"
                                           step="0.01" placeholder="0.00" />
                                </div>

                                <!-- Valor Venta -->
                                <div class="mb-3">
                                    <label for="valorVenta" class="form-label fw-semibold">Valor de Venta</label>
                                    <input type="number" class="form-control" id="valorVenta" name="valorVenta"
                                           value="@(p.ValorVentaProducto?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0")"
                                           step="0.01" placeholder="0.00" />
                                </div>

                                <!-- Valor Unitario -->
                                <div class="mb-3">
                                    <label for="valorUnidad" class="form-label fw-semibold">Valor Unitario</label>
                                    <input type="number" class="form-control" id="valorUnidad" name="valorUnidad"
                                           value="@(p.ValorUnidad?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0")"
                                           step="0.01" placeholder="0.00" />
                                </div>

                                <!-- Cantidad -->
                                <div class="mb-4">
                                    <label for="cantidad" class="form-label fw-semibold">Cantidad</label>
                                    <input type="number" class="form-control" id="cantidad" name="cantidad"
                                           value="@p.CantidadProducto.ToString("0.##", CultureInfo.InvariantCulture)" 
                                           step="0.01" placeholder="0.00" />
                                </div>

                                <!-- Imagen -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold d-block text-center">Imágenes</label>
                                    <div class="row justify-content-center">
                                        <!-- Imagen actual -->
                                        <div class="col-md-6 text-center">
                                            <p class="text-muted mb-2">Imagen actual</p>
                                            <img src="@p.ImagenPath" alt="@p.NombreProducto"
                                                 id="imgActual"
                                                 class="img-thumbnail shadow-sm mb-3"
                                                 style="max-height: 220px; max-width: 100%; object-fit: contain;"
                                                 onerror="this.onerror=null;this.src='@Url.Content("~/img/Productos/nodisponible.png")';" />
                                        </div>

                                        <!-- Nueva imagen (preview) -->
                                        <div class="col-md-6 text-center">
                                            <p class="text-muted mb-2">Nueva imagen</p>
                                            <img id="imgPreview"
                                                 src="@Url.Content("~/img/Productos/nodisponible.png")"
                                                 alt="Vista previa"
                                                 class="img-thumbnail shadow-sm mb-3 d-none"
                                                 style="max-height: 220px; max-width: 100%; object-fit: contain;" />
                                        
                                            <input type="hidden" name="imagenActual" value="@p.ImagenPath" />
                                        </div>
                                    </div>

                                    <!-- Input archivo -->
                                    <div class="text-center">
                                        <input type="file" class="form-control mt-3" id="imagen" name="imagen" accept="image/*" />
                                        <small class="text-muted">Si no seleccionas nada, se conservará la imagen actual.</small>
                                    </div>
                                </div>

                            <!-- Botones -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Volver
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Guardar Cambios
                                </button>
                            </div>

                            @if (ViewBag.ErrorMessage != null)
                            {
                                <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
                            }

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
}
</div>

@section Scripts {
    <script>
                // Vista previa de la nueva imagen
        $("#imagen").on("change", function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $("#imgPreview").attr("src", e.target.result).removeClass("d-none");
                }
                reader.readAsDataURL(file);
            } else {
                $("#imgPreview").attr("src", "").addClass("d-none");
            }
        });

        $(function () {
            const $servicio = $('#servicio');
            const $categorias = $('#categorias');
            const categoriaActual = '@p.IdCatepro';

        function cargarCategorias(idServicio, preseleccion) {
            if (!idServicio) {
                $categorias.empty();
                return;
            }

            $.ajax({
                url: '/Producto/ObtenerCategoriaProductos',
                type: 'GET',
                data: { idServicio: idServicio },
                success: function (categorias) {
                    $categorias.empty();

                    // Agregar opción inicial mostrando categoría actual
                    if (preseleccion) {
                        $categorias.append($('<option>', {
                            value: preseleccion,
                            text: 'Categoría actual (ID: ' + preseleccion + ')',
                            selected: true,
                            disabled: true
                        }));
                    }

                    let found = false;
                    $.each(categorias, function (i, c) {
                        const isSelected = preseleccion && String(preseleccion) === String(c.idCateProducto);
                        if (isSelected) found = true;

                        $categorias.append($('<option>', {
                            value: c.idCateProducto,
                            text: c.descripcion,
                            selected: isSelected
                        }));
                    });

                    if (!found && $categorias.children().length > 0) {
                        $categorias.prop('selectedIndex', 0);
                    }
                },
                error: function () { alert('Error al cargar las categorías.'); }
            });
        }

            // Pre-cargar categorías según el servicio actual
            const selectedServicio = '@(selectedServicioId?.ToString() ?? "")';
            if (selectedServicio) {
                cargarCategorias(selectedServicio, categoriaActual);
            }

            // Cambiar servicio -> recargar categorías
            $servicio.on('change', function () {
                cargarCategorias($(this).val(), null);
            });
        });
    </script>
}
