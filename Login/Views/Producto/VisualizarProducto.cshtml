@model Plataforma.Models.ProductosCategoriaViewModel
@{
    ViewData["Title"] = "Visualizar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var producto = Model.Productos.FirstOrDefault();
    var categoria = Model.CategoriaProductos.FirstOrDefault();
    var servicio = Model.Servicio.FirstOrDefault();
}

<div class="content-wrapper flex justify-center">
    <div class="container mt-6">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg rounded-4 border-0">
                    <div class="card-header bg-gradient text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #007bff, #0056b3);">
                        <h3 class="mb-0"><i class="bi bi-box-seam me-2"></i> Detalles del Producto</h3>
                        <a href="javascript:history.back()" class="btn btn-light btn-sm rounded-pill shadow-sm">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>

                    <div class="card-body p-4">
                        @if (producto != null)
                        {
                            <div class="row align-items-center">
                                <div class="col-md-5 text-center">
                                    <img src="@Url.Content(producto.ImagenPath ?? "~/img/Productos/nodisponible.png")"
                                         alt="@producto.NombreProducto"
                                         class="img-fluid rounded shadow-sm border"
                                         style="max-height: 350px; object-fit: contain;" />
                                </div>

                                <div class="col-md-7">
                                    <h2 class="fw-bold">@producto.NombreProducto</h2>
                                    <p class="text-muted mb-2">
                                        <i class="bi bi-tags-fill me-1"></i>
                                        <strong>Categoría:</strong> @categoria?.Descripcion
                                    </p>
                                    <p class="text-muted mb-3">
                                        <i class="bi bi-grid me-1"></i>
                                        <strong>Servicio:</strong> @servicio?.NombreServicio
                                    </p>

                                    <div class="fs-4 text-success fw-bold mb-4">
                                        $@producto.ValorVentaProducto?.ToString("N0")
                                    </div>

                                    <div class="d-flex gap-3">
                                        <button class="btn btn-primary rounded-pill shadow-sm px-4">
                                            <i class="bi bi-cart-plus me-2"></i> Agregar al carrito
                                        </button>
                                        <button class="btn btn-outline-secondary rounded-pill shadow-sm px-4">
                                            <i class="bi bi-share me-2"></i> Compartir
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center">
                                <i class="bi bi-exclamation-triangle me-2"></i> No se encontró el producto solicitado.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
