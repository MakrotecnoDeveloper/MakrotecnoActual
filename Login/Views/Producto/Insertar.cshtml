@model ProductoInsertarViewModel
@{
    ViewData["Title"] = "Insertar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper py-4" style="background-color: #f8f9fa;">
    <form id="formularioProducto" method="POST">
        <div class="container">
            <!-- Título -->
            <div class="row mb-4">
                <div class="col-md-8 mx-auto text-center">
                    <h1 class="fw-bold text-primary mb-2">
                        <i class="bi bi-box-seam"></i> Agregar Productos
                    </h1>
                    <p class="text-muted">
                        Interfaz de Usuario para agregar productos nuevos al sistema
                    </p>
                    <hr class="w-50 mx-auto">
                </div>
            </div>

            <!-- Formulario -->
            <div class="row">
                <div class="col-md-6 mx-auto">
                    <div class="card shadow-lg border-0 rounded-3">
                        <div class="card-body p-4">

                            <!-- Empresa -->
                            <div class="mb-3">
                                <label for="id_empresa" class="form-label fw-semibold">Empresa</label>
                                <select name="id_empresa" id="id_empresa" class="form-select">
                                    <option value="1234193470-6">Makrotecno</option>
                                </select>
                            </div>

                            <!-- Código -->
                            <div class="mb-3">
                                <label for="codigo" class="form-label fw-semibold">Código</label>
                                <input type="text" name="codigo" class="form-control" id="codigo" placeholder="Ingrese el código">
                            </div>

                            <!-- Descripción -->
                            <div class="mb-3">
                                <label for="descripcion" class="form-label fw-semibold">Descripción</label>
                                <input type="text" name="descripcion" class="form-control" id="descripcion" placeholder="Ingrese la descripción">
                            </div>

                            <!-- Valor Neto -->
                            <div class="mb-3">
                                <label for="valorNeto" class="form-label fw-semibold">Valor Neto</label>
                                <input type="number" name="valor_neto" class="form-control" id="valorNeto" placeholder="Ingrese el valor neto">
                            </div>

                            <!-- Valor Unitario -->
                            <div class="mb-3">
                                <label for="valorVenta" class="form-label fw-semibold">Valor Unitario</label>
                                <input type="number" name="valor_unitario" id="valorVenta" class="form-control" placeholder="Ingrese el valor unitario">
                            </div>

                            <!-- Stock -->
                            <div class="mb-3">
                                <label for="stock" class="form-label fw-semibold">Stock</label>
                                <input type="number" name="stock" id="stock" class="form-control" placeholder="Ingrese el stock disponible">
                            </div>

                            <!-- Servicio -->
                            <div class="mb-3">
                                <label for="servicio" class="form-label fw-semibold">Servicio</label>
                                <select name="servicio" id="servicio" class="form-select">
                                    <option disabled selected>Seleccione un servicio</option>
                                    @foreach (var servicio in Model.Servicios)
                                    {
                                        <option value="@servicio.IdServicio">@servicio.NombreServicio</option>
                                    }
                                </select>
                            </div>

                            <!-- Proveedores -->
                            <div class="mb-3">
                                <label for="proveedor" class="form-label fw-semibold">Proveedores</label>
                                <select name="proveedor" id="proveedor" class="form-select">
                                    <option disabled selected>Seleccione un proveedor</option>
                                    @foreach (var proveedor in Model.Proveedores)
                                    {
                                        <option value="@proveedor.IdProveedor">@proveedor.RazonSocial</option>
                                    }
                                </select>
                            </div>

                            <!-- Categorías -->
                            <div class="mb-4">
                                <label for="categorias" class="form-label fw-semibold">Categorías</label>
                                <select name="categorias" id="categorias" class="form-select">
                                    <!-- Se llenará con JS -->
                                </select>
                            </div>

                            <!-- Botón -->
                            <div class="d-grid">
                                <button type="button" id="btnAgregarProducto" class="btn btn-primary btn-lg shadow-sm">
                                    <i class="bi bi-plus-circle"></i> Agregar Producto
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#servicio').on('change', function () {
                var idServicio = $(this).val();

                if (idServicio) {
                    $.ajax({
                        url: '/Producto/ObtenerCategoriaProductos',
                        type: 'GET',
                        data: { idServicio: idServicio },
                        success: function (categorias) {
                            var $categoriaSelect = $('#categorias');
                            $categoriaSelect.empty();

                            $.each(categorias, function (i, categoria) {
                                $categoriaSelect.append(
                                    $('<option>', {
                                        value: categoria.idCateProducto,
                                        text: categoria.descripcion
                                    })
                                );
                            });
                        },
                        error: function () {
                            alert('Error al cargar las categorías.');
                        }
                    });
                } else {
                    $('#categorias').empty();
                }
            });
        });

        $('#btnAgregarProducto').on('click', function () {
            var producto = {
                id_empresa: $('#id_empresa').val(),
                codigo: $('#codigo').val(),
                descripcion: $('#descripcion').val(),
                valor_neto: parseFloat($('#valorNeto').val()),
                valor_unitario: parseFloat($('#valorVenta').val()),
                stock: parseInt($('#stock').val()),
                categorias: $('#categorias').val(),
                id_servicio: $('#servicio').val(),
                id_proveedor: $('#proveedor').val()
            };
            $.ajax({
                type: 'POST',
                url: '/Producto/Insertar',
                data: producto,
                success: function (response) {
                    alert('Producto agregado correctamente.');
                    $('#formularioProducto')[0].reset();
                    $('#categorias').empty();
                },
                error: function () {
                    alert('Error al agregar el producto.');
                }
            });
        });
    </script>
}