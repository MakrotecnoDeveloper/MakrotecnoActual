@model ProductoInsertarViewModel
@{
    ViewData["Title"] = "Insertar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!-- Tu formulario HTML aquí -->
<div class="content-wrapper">
    <form id="formularioProducto" method="POST">
        <div class="container">
            <div class="row">
                <div class="col-md-6 mx-auto text-center">
                    <div class="header-title">
                        <h1 class="wv-heading--title">
                            Agregar Productos
                        </h1>
                        <h2 class="wv-heading--subtitle">
                            Interfaz de Usuario para agregar productos nuevos al sistema
                        </h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mx-auto">
                    <div class="myform form ">
                            <div class="form-group">
                                <select name="id_empresa" id="id_empresa">
                                <option value="1234193470-6">Makrotecno</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <input type="text" name="codigo" class="form-control my-input" id="codigo" placeholder="Codigo">
                            </div>
                            <div class="form-group">
                                <input type="text" name="descripcion" class="form-control my-input" id="descripcion" placeholder="Descripcion">
                            </div>
                            <div class="form-group">
                                <input type="number" name="valor_neto" class="form-control my-input" id="valorNeto" placeholder="Valor Neto">
                            </div>
                            <div class="form-group">
                                <input type="number" name="valor_unitario" id="valorVenta" class="form-control my-input" placeholder="Valor Unitario">
                            </div>
                            <div class="form-group">
                                <input type="number" name="stock" id="stock" class="form-control my-input" placeholder="Stock">
                            </div>
                            <div class="form-group">
                                <label for="servicio">Servicio</label>
                                <select name="servicio" id="servicio" class="form-control my-input">
                                    <option disabled selected>Seleccione un servicio</option>
                                    @foreach (var servicio in Model.Servicios)
                                    {
                                        <option value="@servicio.IdServicio">@servicio.NombreServicio</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Categorías</label>
                                <select name="categorias" id="categorias" class="form-control my-input">
                                    <!-- Se llenará con JS -->
                                </select>
                            </div>
                            <div class="text-center ">
                                <button type="button" id="btnAgregarProducto" class="btn btn-block send-button tx-tfm">Agregar Producto</button>
                            </div>
                    </div>
                 </div>
            </div>
         </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#servicio').on('change', function () {
                var idServicio = $(this).val();

                if (idServicio) {
                    $.ajax({
                        url: '/Producto/ObtenerCategoriaProductos',
                        type: 'GET',
                        data: { idServicio: idServicio },
                        success: function (categorias) {
                            var $categoriaSelect = $('#categorias');
                            $categoriaSelect.empty();

                            $.each(categorias, function (i, categoria) {
                                $categoriaSelect.append(
                                    $('<option>', {
                                        value: categoria.idCateProducto,
                                        text: categoria.descripcion
                                    })
                                );
                            });
                        },
                        error: function () {
                            alert('Error al cargar las categorías.');
                        }
                    });
                } else {
                    $('#categorias').empty();
                }
            });
        });

        $('#btnAgregarProducto').on('click', function () {
            var producto = {
                id_empresa: $('#id_empresa').val(),
                codigo: $('#codigo').val(),
                descripcion: $('#descripcion').val(),
                valor_neto: parseFloat($('#valorNeto').val()),
                valor_unitario: parseFloat($('#valorVenta').val()),
                stock: parseInt($('#stock').val()),
                categorias: $('#categorias').val(),
                id_servicio: $('#servicio').val()
            };
            $.ajax({
                type: 'POST',
                url: '/Producto/Insertar',
                data: producto,
                success: function (response) {
                    alert('Producto agregado correctamente.');
                    $('#formularioProducto')[0].reset();
                    $('#categorias').empty();
                },
                error: function () {
                    alert('Error al agregar el producto.');
                }
            });
        });
    </script>
}