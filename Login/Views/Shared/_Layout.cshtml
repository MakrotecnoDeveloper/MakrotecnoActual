@inject Plataforma.Servicios.Contrato.IMenuService MenuService

@{
    var rol = Context.User.FindFirst("Rol")?.Value;
    List<int> menusActivos = new();

    if (!string.IsNullOrEmpty(rol) && int.TryParse(rol, out int idCargo))
    {
        menusActivos = await MenuService.ObtenerIdsMenusActivosPorCargoAsync(idCargo);
    }
}

