@model Plataforma.Models.ViewModels.Inicio.InicioPortalVm

@{
    ViewData["Title"] = "Portal Administrativo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row align-items-center mb-3">
                <div class="col-md-8">
                    <h1 class="mb-1">Portal Administrativo</h1>
                    <p class="text-muted mb-0">
                        Información actual de la empresa, sede y punto de venta conectado.
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="badge bg-success px-3 py-2">
                        @Model.EstadoConexion
                    </span>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <div class="row mb-4">
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">Empresa</small>
                            <h5 class="mt-2 mb-1">@Model.NombreEmpresa</h5>
                            <p class="mb-0 text-muted">NIT/ID: @Model.EmpresaId</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">Sede conectada</small>
                            <h5 class="mt-2 mb-1">@Model.NombreSede</h5>
                            <p class="mb-0 text-muted">ID Sede: @Model.SedeId</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <small class="text-muted">Punto de venta</small>
                            <h5 class="mt-2 mb-1">@Model.NombrePdv</h5>
                            <p class="mb-0 text-muted">ID PDV: @Model.PdvId</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="small-box bg-primary">
                        <div class="inner">
                            <h3>@Model.TotalSedesEmpresa</h3>
                            <p>Sedes de la empresa</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>@Model.TotalPdvSede</h3>
                            <p>PDV en esta sede</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-cash-register"></i>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="small-box bg-success">
                        <div class="inner">
                            <h3>@Model.TotalEmpleadosSede</h3>
                            <p>Empleados en esta sede</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="small-box bg-secondary">
                        <div class="inner">
                            <h3>@Model.NombreRol</h3>
                            <p>Rol actual</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-user-shield"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8 mb-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <strong>Resumen del contexto actual</strong>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <th>Usuario:</th>
                                    <td>@Model.NombreUsuario</td>
                                </tr>
                                <tr>
                                    <th>Cédula:</th>
                                    <td>@Model.Cedula</td>
                                </tr>
                                <tr>
                                    <th>Empresa:</th>
                                    <td>@Model.NombreEmpresa</td>
                                </tr>
                                <tr>
                                    <th>Sede:</th>
                                    <td>@Model.NombreSede</td>
                                </tr>
                                <tr>
                                    <th>Punto de venta:</th>
                                    <td>@Model.NombrePdv</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 mb-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white">
                            <strong>Accesos rápidos</strong>
                        </div>
                        <div class="card-body">
                            <a href="/Producto/ProductosIndex" class="btn btn-outline-primary w-100 mb-2">
                                <i class="fas fa-boxes"></i> Productos
                            </a>

                            <a href="/Pedido/Index" class="btn btn-outline-success w-100 mb-2">
                                <i class="fas fa-file-invoice-dollar"></i> Ventas
                            </a>

                            <a href="/Compras/Index" class="btn btn-outline-info w-100 mb-2">
                                <i class="fas fa-shopping-cart"></i> Compras
                            </a>

                            <a href="/Usuario/Index" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-users-cog"></i> Usuarios
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>