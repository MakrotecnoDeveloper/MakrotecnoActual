        function abrirModalAsignarCliente(cuenta) {
            document.getElementById("asigIdPltfSuscripcion").value = cuenta.idPltfSuscripcion || 0;
            document.getElementById("asigIdClienteStreaming").value = "";
            document.getElementById("asigTerminoCliente").value = "";
            document.getElementById("asigResultadoClientes").innerHTML = "";
            document.getElementById("asigClienteSeleccionado").classList.add("d-none");
            document.getElementById("asigClienteSeleccionado").innerHTML = "";

            document.getElementById("asigFechaInicio").value = obtenerFechaHoyInput();
            document.getElementById("asigFechaFin").value = obtenerFechaMasUnMesInput();

            document.getElementById("asigClavePerfil").value = "";
            document.getElementById("asigCantidad").value = 1;
            document.getElementById("asigPpm").value = "Perfil";
            document.getElementById("asigValorVenta").value = cuenta.valorVenta || 0;
            document.getElementById("asigValorNeto").value = cuenta.valorNeto || 0;
