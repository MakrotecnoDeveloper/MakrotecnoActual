        async function buscarClienteAsignar() {
            const termino = document.getElementById("asigTerminoCliente").value.trim();

            if (!termino) {
                alert("Debe ingresar nombre, celular o correo.");
                return;
            }

            const resultado = document.getElementById("asigResultadoClientes");

            resultado.innerHTML = `
                <div class="alert alert-info">
                    Buscando cliente...
                </div>
            `;

            try {
                const response = await fetch(`/Producto/BuscarClientesStreaming?termino=${encodeURIComponent(termino)}`);
                const data = await leerJsonSeguro(response);

                const clientes = data.clientes || [];

                if (clientes.length === 0) {
                    resultado.innerHTML = `
                        <div class="alert alert-warning">
                            No se encontraron clientes.
                        </div>
                    `;
                    return;
                }

                let html = `<div class="list-group">`;

                clientes.forEach(cliente => {
                    const ids = cliente.idsClienteStreaming || cliente.idClienteStreaming || "";
                    const idReal = String(ids).split(",")[0];

                    html += `
                        <button type="button"
                                class="list-group-item list-group-item-action"
                                onclick="seleccionarClienteAsignar(
                                    '${idReal}',
                                    '${escaparAtributo(cliente.nombreCliente || '')}',
                                    '${escaparAtributo(cliente.celularCliente || '')}',
                                    '${escaparAtributo(cliente.correoCliente || '')}'
                                )">
                            <strong>${escaparHtml(cliente.nombreCliente || 'Sin nombre')}</strong><br>
                            <small>
                                Celular: ${escaparHtml(cliente.celularCliente || 'No registrado')} |
                                Correo: ${escaparHtml(cliente.correoCliente || 'No registrado')}
                            </small>
                        </button>
                    `;
                });

                html += `</div>`;

                resultado.innerHTML = html;

            } catch (error) {
                console.error(error);
                resultado.innerHTML = `
                    <div class="alert alert-danger">
                        ${error.message}
                    </div>
                `;
            }
        }

        function seleccionarClienteAsignar(idClienteStreaming, nombre, celular, correo) {
            document.getElementById("asigIdClienteStreaming").value = idClienteStreaming;

            const seleccionado = document.getElementById("asigClienteSeleccionado");

            seleccionado.classList.remove("d-none");
            seleccionado.innerHTML = `
                <strong>Cliente seleccionado:</strong><br>
                ${escaparHtml(nombre)}<br>
                Celular: ${escaparHtml(celular || 'No registrado')} |
                Correo: ${escaparHtml(correo || 'No registrado')}
            `;

            document.getElementById("asigResultadoClientes").innerHTML = "";
        }

        async function guardarAsignacionCliente() {
            const model = {
                idPltfSuscripcion: parseInt(document.getElementById("asigIdPltfSuscripcion").value || "0"),
                idClienteStreaming: parseInt(document.getElementById("asigIdClienteStreaming").value || "0"),
                fechaIniPago: document.getElementById("asigFechaInicio").value,
                fechaFinPago: document.getElementById("asigFechaFin").value,
                clavePerfil: document.getElementById("asigClavePerfil").value,
                cantidad: parseInt(document.getElementById("asigCantidad").value || "0"),
                ppm: document.getElementById("asigPpm").value,
                valorVenta: parseInt(document.getElementById("asigValorVenta").value || "0"),
                valorNeto: parseInt(document.getElementById("asigValorNeto").value || "0"),
                estado: parseInt(document.getElementById("asigEstado").value || "0")
            };

            if (model.idPltfSuscripcion <= 0) {
                alert("No se encontró la cuenta / plan.");
                return;
            }

            if (model.idClienteStreaming <= 0) {
                alert("Debe seleccionar un cliente.");
                return;
            }

            if (!model.fechaIniPago || !model.fechaFinPago) {
                alert("Debe ingresar fecha inicio y fecha fin.");
                return;
            }

            if (new Date(model.fechaFinPago) < new Date(model.fechaIniPago)) {
                alert("La fecha fin no puede ser menor que la fecha inicio.");
                return;
            }

            if (model.cantidad <= 0) {
                alert("La cantidad debe ser mayor a cero.");
                return;
            }

            try {
                const response = await fetch("/Streaming/AsignarClienteACuenta", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(model)
                });

                const data = await leerJsonSeguro(response);

                alert(data.mensaje || "Cliente asignado correctamente.");

                $("#modalAsignarCliente").modal("hide");

                await consultarEstructura();

            } catch (error) {
                console.error(error);
                alert(error.message);
            }
        }

        function obtenerFechaHoyInput() {
            const d = new Date();

            return formatearDateTimeLocal(d);
        }

        function obtenerFechaMasUnMesInput() {
            const d = new Date();
            d.setMonth(d.getMonth() + 1);

            return formatearDateTimeLocal(d);
        }

        function formatearDateTimeLocal(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, "0");
            const day = String(d.getDate()).padStart(2, "0");
            const hours = String(d.getHours()).padStart(2, "0");
            const minutes = String(d.getMinutes()).padStart(2, "0");

            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        function escaparAtributo(valor) {
            if (valor === null || valor === undefined) return "";

            return String(valor)
                .replace(/\\/g, "\\\\")
                .replace(/'/g, "\\'")
                .replace(/"/g, "&quot;")
                .replace(/\n/g, " ");
        }
                function abrirModalEditarCuenta(cuenta) {
            document.getElementById("editPerfilIdClientePlataforma").value = cuenta.idClientePlataforma || 0;
            document.getElementById("editPerfilIdPltfSuscripcion").value = cuenta.idPltfSuscripcion || 0;

            document.getElementById("editPerfilFechaIniPago").value = formatearFechaInputEditar(cuenta.fechaIniPago || cuenta.fechaIni || cuenta.fechaInicio);
            document.getElementById("editPerfilFechaFinPago").value = formatearFechaInputEditar(cuenta.fechaFinPago || cuenta.fechaFin || cuenta.fechaFinal);

            document.getElementById("editPerfilClavePerfil").value = cuenta.clavePerfil || "";
            document.getElementById("editPerfilCantidad").value = cuenta.cantidad || 1;
            document.getElementById("editPerfilPpm").value = cuenta.ppm || "Perfil";
            document.getElementById("editPerfilValorVenta").value = cuenta.valorVenta || 0;
            document.getElementById("editPerfilValorNeto").value = cuenta.valorNeto || 0;
            document.getElementById("editPerfilEstado").value = cuenta.estado ?? 1;

            $("#modalEditarPerfilCuenta").modal("show");
        }

        function formatearFechaInputEditar(fecha) {
            if (!fecha) return "";

            const d = new Date(fecha);

            if (isNaN(d.getTime())) return "";

            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, "0");
            const day = String(d.getDate()).padStart(2, "0");
            const hours = String(d.getHours()).padStart(2, "0");
            const minutes = String(d.getMinutes()).padStart(2, "0");

            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

