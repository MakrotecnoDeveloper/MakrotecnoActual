@model IEnumerable<Plataforma.Models.PeriodoNomina>
@{
    ViewData["Title"] = "Períodos";
}
<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Períodos de nómina</h2>
        <a asp-action="CrearPeriodo" class="btn btn-primary">Nuevo período</a>
    </div>

@if (TempData["ok"] != null)
{
        <div class="alert alert-success">@TempData["ok"]</div>
}

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Tipo</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Pago</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Descripcion</td>
                    <td>@item.TipoPeriodo</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaPago?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>