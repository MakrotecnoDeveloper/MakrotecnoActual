@model IEnumerable<Plataforma.Models.PeriodoNomina>
@{
    ViewData["Title"] = "Períodos";
}
<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Períodos de nómina</h2>
        <a asp-action="CrearPeriodo" class="btn btn-primary">Nuevo período</a>
    </div>

    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success">@TempData["ok"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Tipo</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Pago</th>
                <th>Estado</th>
                <th style="width:260px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Descripcion</td>
                    <td>@item.TipoPeriodo</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaPago?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Estado</td>
                    <td>
                        @if (item.Estado == "Abierto")
                        {
                            <form asp-action="CambiarEstadoPeriodo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPeriodo" value="@item.IdPeriodo" />
                                <input type="hidden" name="nuevoEstado" value="Calculado" />
                                <button type="submit" class="btn btn-sm btn-warning">
                                    Pasar a Calculado
                                </button>
                            </form>
                        }
                        else if (item.Estado == "Calculado")
                        {
                            <form asp-action="CambiarEstadoPeriodo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPeriodo" value="@item.IdPeriodo" />
                                <input type="hidden" name="nuevoEstado" value="Cerrado" />
                                <button type="submit" class="btn btn-sm btn-dark">
                                    Pasar a Cerrado
                                </button>
                            </form>
                        }
                        else if (item.Estado == "Cerrado")
                        {
                            <form asp-action="CambiarEstadoPeriodo" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPeriodo" value="@item.IdPeriodo" />
                                <input type="hidden" name="nuevoEstado" value="Pagado" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    Pasar a Pagado
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="badge bg-success">Finalizado</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>