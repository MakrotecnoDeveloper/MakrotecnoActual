@model IEnumerable<Plataforma.Models.LiquidacionNomina>
@{
    ViewData["Title"] = "Liquidaciones";
}
<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liquidaciones</h2>
        @if (ViewBag.EstadoPeriodo == "Calculado")
        {
            <a asp-action="GenerarLiquidacion" class="btn btn-success">Nueva liquidación</a>
        }
        else
        {
            <button type="button" class="btn btn-secondary" disabled>Nueva liquidación</button>
        }
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cédula</th>
                <th>Período</th>
                <th>Fecha</th>
                <th>Devengado</th>
                <th>Deducciones</th>
                <th>Neto</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdLiquidacion</td>
                    <td>@item.Cedula</td>
                    <td>@item.PeriodoNomina?.Descripcion</td>
                    <td>@item.FechaLiquidacion.ToString("yyyy-MM-dd")</td>
                    <td>@item.TotalDevengado.ToString("N2")</td>
                    <td>@item.TotalDeducciones.ToString("N2")</td>
                    <td>@item.NetoPagar.ToString("N2")</td>
                    <td>@item.Estado</td>
                    <td>
                        <a asp-action="DetalleLiquidacion" asp-route-id="@item.IdLiquidacion" class="btn btn-sm btn-info">Ver detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>