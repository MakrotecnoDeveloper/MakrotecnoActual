@model IEnumerable<Plataforma.Models.DetalleConceptoEmpleado>
@{
    ViewData["Title"] = "Asignaciones";
}
<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asignaciones de conceptos</h2>
        <a asp-action="AsignarConcepto" class="btn btn-primary">Nueva asignación</a>
    </div>

@if (TempData["ok"] != null)
{
        <div class="alert alert-success">@TempData["ok"]</div>
}

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Empleado</th>
                <th>Concepto</th>
                <th>% personalizado</th>
                <th>Valor fijo</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Cedula</td>
                    <td>@item.Empleado?.Nombre @item.Empleado?.Apellido</td>
                    <td>@item.ConceptoNomina?.Nombre</td>
                    <td>@item.PorcentajePersonalizado?.ToString("N2")</td>
                    <td>@item.ValorFijoPersonalizado?.ToString("N2")</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaFin?.ToString("yyyy-MM-dd")</td>
                    <td>@(item.Estado ? "Activo" : "Inactivo")</td>
                </tr>
            }
        </tbody>
    </table>
</div>