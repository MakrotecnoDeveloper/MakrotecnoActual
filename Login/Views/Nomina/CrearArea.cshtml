@model Plataforma.Models.AreaFormVm
@{
    ViewData["Title"] = "Crear área";
}
<div class="content-wrapper">
    <h2>Crear área</h2>

    <form asp-action="CrearArea" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-5 mb-3">
                <label asp-for="NombreArea" class="form-label"></label>
                <input asp-for="NombreArea" class="form-control" />
            </div>

            <div class="col-md-5 mb-3">
                <label asp-for="DescripcionArea" class="form-label"></label>
                <input asp-for="DescripcionArea" class="form-control" />
            </div>

            <div class="col-md-2 mb-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" />
                    <label asp-for="Estado" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Areas" class="btn btn-secondary">Volver</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}