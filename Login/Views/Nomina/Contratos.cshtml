@model IEnumerable<Plataforma.Models.Contrato>
@{
    ViewData["Title"] = "Contratos";
}
<div class="content-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Contratos</h2>
        <a asp-action="CrearContrato" class="btn btn-primary">Nuevo contrato</a>
    </div>

@if (TempData["ok"] != null)
{
        <div class="alert alert-success">@TempData["ok"]</div>
}

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cédula</th>
                <th>Empleado</th>
                <th>Tipo</th>
                <th>Salario</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdContrato</td>
                    <td>@item.Cedula</td>
                    <td>@item.Empleado?.Nombre @item.Empleado?.Apellido</td>
                    <td>@item.TipoContrato</td>
                    <td>@item.SalarioBase.ToString("N2")</td>
                    <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                    <td>@item.FechaFin?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>