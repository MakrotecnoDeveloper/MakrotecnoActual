@model Plataforma.Models.AsignarConceptoEmpleadoVm
@{
    ViewData["Title"] = "Asignar concepto";
}
<div class="content-wrapper">
    <h2>Asignar concepto a empleado</h2>

    <form asp-action="AsignarConcepto" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Cedula" class="form-label">Empleado</label>
                <select asp-for="Cedula" asp-items="Model.Empleados" class="form-select"></select>
                <span asp-validation-for="Cedula" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="IdConcepto" class="form-label">Concepto</label>
                <select asp-for="IdConcepto" asp-items="Model.Conceptos" class="form-select"></select>
                <span asp-validation-for="IdConcepto" class="text-danger"></span>
            </div>

            <div class="col-md-2 mb-3">
                <label asp-for="PorcentajePersonalizado" class="form-label"></label>
                <input asp-for="PorcentajePersonalizado" class="form-control" />
            </div>

            <div class="col-md-2 mb-3">
                <label asp-for="ValorFijoPersonalizado" class="form-label"></label>
                <input asp-for="ValorFijoPersonalizado" class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label asp-for="FechaFin" class="form-label"></label>
                <input asp-for="FechaFin" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="Observacion" class="form-label"></label>
                <input asp-for="Observacion" class="form-control" />
            </div>

            <div class="col-md-2 mb-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Estado" class="form-check-input" />
                    <label asp-for="Estado" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="Asignaciones" class="btn btn-secondary">Volver</a>
    </form>
</div>
@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}

