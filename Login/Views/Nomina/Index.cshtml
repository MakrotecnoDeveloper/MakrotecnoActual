@model List<string>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="container">
        <h2>Gestión de Nómina</h2>

        <h4>Registrar Empleado</h4>
        <form asp-action="RegistrarEmpleado" method="post">
            <input type="text" name="Nombre" placeholder="Nombre" class="form-control" />
            <input type="text" name="Apellido" placeholder="Apellido" class="form-control" />
            <button type="submit" class="btn btn-primary mt-2">Guardar</button>
        </form>

        <h4 class="mt-4">Crear Contrato</h4>
        <form asp-action="CrearContrato" method="post">
            <input type="number" name="Cedula" placeholder="Cédula Empleado" class="form-control" />
            <select name="TipoContrato" class="form-control">
                <option value="">Seleccionar Contrato</option>
                <option value="Indefinido">Indefinido</option>
                <option value="Fijo">Fijo</option>
                <option value="Horas">Horas</option>
                <option value="Comision">Comision</option>
            </select>
            <input type="number" name="SalarioBase" placeholder="Salario Base" class="form-control" />
            <input type="date" name="FechaInicio" class="form-control" />
            <input type="date" name="FechaFinal" class="form-control" />
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="Estado" value="true" />
                <label class="form-check-label">Contrato Activo</label>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Guardar</button>
        </form>

        <h4 class="mt-4">Crear Conceptos</h4>
        <form asp-action="CrearConceptosNomina" method="post">
            <input type="text" name="Nombre" placeholder="Nombre Concepto" class="form-control" />
            <select name="Tipo" class="form-control">
                <option value="">Seleccionar Concepto</option>
                <option value="Ingreso">Ingreso</option>
                <option value="Deduccion">Deduccion</option>
            </select>
            <select class="form-select" name="ServicioAsociado">
                <option value="">-- Seleccione --</option>
                @foreach (var servicio in Model)
                {
                    <option value="@servicio">@servicio</option>
                }
            </select>
            <input type="number" step="0.01"  name="Porcentaje" placeholder="Ej: 4 = 4%" class="form-control" />
            <input type="number" step="0.01"  name="ValorFijo" placeholder="Ej: 1000000" class="form-control" />
            <button type="submit" class="btn btn-primary mt-2">Asociar</button>
        </form>

        <h4 class="mt-4">Asociar Concepto</h4>
        <form asp-action="AsociarConcepto" method="post">
            <input type="number" name="Cedula" placeholder="Cédula Empleado" class="form-control" />
            <input type="number" name="IdConcepto" placeholder="Id Concepto" class="form-control" />
            <button type="submit" class="btn btn-primary mt-2">Asociar</button>
        </form>

        <h4 class="mt-4">Liquidar Nómina</h4>
        <form asp-action="Liquidar" method="post">
            <input type="number" name="cedulaEmpleado" placeholder="Cédula Empleado" class="form-control" />
            <input type="date" name="fechaInicio" class="form-control" />
            <input type="date" name="fechaFin" class="form-control" />
            <button type="submit" class="btn btn-success mt-2">Liquidar</button>
        </form>
    </div>
</div>