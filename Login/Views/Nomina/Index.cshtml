@model IEnumerable<Plataforma.Models.PeriodoNomina>
@{
    ViewData["Title"] = "Nómina";
    var ultimas = ViewBag.UltimasLiquidaciones as List<Plataforma.Models.LiquidacionNomina>;
}
<div class="content-wrapper">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Nómina</h2>
            <div class="d-flex gap-2">
                <a asp-action="Contratos" class="btn btn-outline-primary">Contratos</a>
                <a asp-action="Periodos" class="btn btn-outline-primary">Períodos</a>
                <a asp-action="Conceptos" class="btn btn-outline-primary">Conceptos</a>
                <a asp-action="Asignaciones" class="btn btn-outline-primary">Asignaciones</a>
                <a asp-action="GenerarLiquidacion" class="btn btn-success">Generar liquidación</a>
            </div>
        </div>

    @if (TempData["ok"] != null)
    {
            <div class="alert alert-success">@TempData["ok"]</div>
    }
    @if (TempData["error"] != null)
    {
            <div class="alert alert-danger">@TempData["error"]</div>
    }

        <div class="card mb-4">
            <div class="card-header"><strong>Períodos disponibles</strong></div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Descripción</th>
                            <th>Tipo</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Pago</th>
                            <th>Estado</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Descripcion</td>
                                <td>@item.TipoPeriodo</td>
                                <td>@item.FechaInicio.ToString("yyyy-MM-dd")</td>
                                <td>@item.FechaFin.ToString("yyyy-MM-dd")</td>
                                <td>@item.FechaPago?.ToString("yyyy-MM-dd")</td>
                                <td>@item.Estado</td>
                                <td>
                                    <form asp-action="GenerarNovedadesDesdeCierreCaja" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPeriodo" value="@item.IdPeriodo" />
                                        <button type="submit" class="btn btn-sm btn-primary">Generar novedades desde cierre</button>
                                    </form>
                                    <a asp-action="Liquidaciones" asp-route-idPeriodo="@item.IdPeriodo" class="btn btn-sm btn-dark">Liquidaciones</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    @if (ultimas != null && ultimas.Any())
    {
            <div class="card">
                <div class="card-header"><strong>Últimas liquidaciones</strong></div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cédula</th>
                                <th>Período</th>
                                <th>Fecha</th>
                                <th>Neto</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ultimas)
                            {
                                <tr>
                                    <td>@item.IdLiquidacion</td>
                                    <td>@item.Cedula</td>
                                    <td>@item.PeriodoNomina?.Descripcion</td>
                                    <td>@item.FechaLiquidacion.ToString("yyyy-MM-dd")</td>
                                    <td>@item.NetoPagar.ToString("N2")</td>
                                    <td>
                                        <a asp-action="DetalleLiquidacion" asp-route-id="@item.IdLiquidacion" class="btn btn-sm btn-info">Ver detalle</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
    }
</div>