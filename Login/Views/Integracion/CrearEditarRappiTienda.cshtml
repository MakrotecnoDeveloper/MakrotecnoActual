@model MakroTecno.ViewModels.Integraciones.RappiTiendaViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear tienda Rappi" : "Editar tienda Rappi";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="fas fa-store"></i> @ViewData["Title"]
                </h4>
            </div>

            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="CrearEditarRappiTienda" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label asp-for="IdTiendaRappi" class="form-label">ID tienda Rappi</label>
                            <input asp-for="IdTiendaRappi" class="form-control" required />
                            <span asp-validation-for="IdTiendaRappi" class="text-danger"></span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="NombreTiendaRappi" class="form-label">Nombre tienda Rappi</label>
                            <input asp-for="NombreTiendaRappi" class="form-control" required />
                            <span asp-validation-for="NombreTiendaRappi" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="SedeId" class="form-label">Sede ERP</label>
                            <select asp-for="SedeId" asp-items="Model.Sedes" class="form-select" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="SedeId" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <input asp-for="Activa" class="form-check-input" />
                                <label asp-for="Activa" class="form-check-label">
                                    Tienda activa
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Guardar
                        </button>

                        <a asp-action="RappiTiendas" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}