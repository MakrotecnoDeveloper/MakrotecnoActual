@model MakroTecno.ViewModels.Integraciones.RappiCategoriaMapeoViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear categoría Rappi" : "Editar categoría Rappi";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">
                    <i class="fas fa-tags"></i> @ViewData["Title"]
                </h4>
            </div>

            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="CrearEditarRappiCategoria" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div class="row">

                        <div class="col-md-5 mb-3">
                            <label asp-for="IdCateProducto" class="form-label">Categoría ERP</label>
                            <select asp-for="IdCateProducto" asp-items="Model.CategoriasErp" class="form-select" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="IdCateProducto" class="text-danger"></span>
                        </div>

                        <div class="col-md-7 mb-3">
                            <label asp-for="CategoriaRappi" class="form-label">Categoría Rappi</label>
                            <input asp-for="CategoriaRappi" class="form-control" required />
                            <span asp-validation-for="CategoriaRappi" class="text-danger"></span>
                            <small class="text-muted">
                                Escribe exactamente la categoría aceptada por la plantilla de Rappi.
                            </small>
                        </div>

                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <input asp-for="Activo" class="form-check-input" />
                                <label asp-for="Activo" class="form-check-label">
                                    Homologación activa
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Guardar
                        </button>

                        <a asp-action="RappiCategorias" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}