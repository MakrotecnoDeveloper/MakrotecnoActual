@model MakroTecno.ViewModels.Integraciones.RappiProductoConfigViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear configuración producto Rappi" : "Editar configuración producto Rappi";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h4 class="mb-0">
                    <i class="fas fa-box"></i> @ViewData["Title"]
                </h4>
            </div>

            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <form asp-action="CrearEditarRappiProductoConfig" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div class="row">

                        <div class="col-md-12 mb-3">
                            <label asp-for="ProductoId" class="form-label">Producto ERP</label>
                            <select asp-for="ProductoId" asp-items="Model.Productos" class="form-select" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="ProductoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="SkuRappi" class="form-label">SKU Rappi</label>
                            <input asp-for="SkuRappi" class="form-control" />
                            <small class="text-muted">
                                Si se deja vacío, se usará el código del producto ERP.
                            </small>
                        </div>

                        <div class="col-md-8 mb-3">
                            <label asp-for="NombreRappi" class="form-label">Nombre Rappi</label>
                            <input asp-for="NombreRappi" class="form-control" />
                            <small class="text-muted">
                                Si se deja vacío, se usará el nombre del producto ERP.
                            </small>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="MarcaRappi" class="form-label">Marca</label>
                            <input asp-for="MarcaRappi" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Ean" class="form-label">EAN / Código de barras</label>
                            <input asp-for="Ean" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="UnidadMedidaRappi" class="form-label">Unidad de medida Rappi</label>
                            <select asp-for="UnidadMedidaRappi" class="form-select">
                                <option value="Und (unidades)">Und (unidades)</option>
                                <option value="g (gramos)">g (gramos)</option>
                                <option value="Kg (kilogramos)">Kg (kilogramos)</option>
                                <option value="mL (mililitros)">mL (mililitros)</option>
                                <option value="L (lítros)">L (lítros)</option>
                                <option value="cc (centímetros cúbicos)">cc (centímetros cúbicos)</option>
                                <option value="oz (onzas)">oz (onzas)</option>
                                <option value="mm (milimetros)">mm (milimetros)</option>
                                <option value="c (centímetros)">c (centímetros)</option>
                                <option value="Lb (libras)">Lb (libras)</option>
                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="CantidadPresentacion" class="form-label">Cantidad presentación</label>
                            <input asp-for="CantidadPresentacion" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="col-md-9 mb-3">
                            <label asp-for="DescripcionRappi" class="form-label">Descripción Rappi</label>
                            <textarea asp-for="DescripcionRappi" class="form-control" rows="3"></textarea>
                            <small class="text-muted">
                                Si se deja vacía, el sistema generará una descripción básica automática.
                            </small>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="form-check mt-4">
                                <input asp-for="EsPesable" class="form-check-input" />
                                <label asp-for="EsPesable" class="form-check-label">
                                    Es pesable
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="form-check mt-4">
                                <input asp-for="EsPreempaquetado" class="form-check-input" />
                                <label asp-for="EsPreempaquetado" class="form-check-label">
                                    Es preempaquetado
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="form-check mt-4">
                                <input asp-for="PublicarEnRappi" class="form-check-input" />
                                <label asp-for="PublicarEnRappi" class="form-check-label">
                                    Publicar en Rappi
                                </label>
                            </div>
                        </div>

                        <div class="col-md-3 mb-3">
                            <div class="form-check mt-4">
                                <input asp-for="Activo" class="form-check-input" />
                                <label asp-for="Activo" class="form-check-label">
                                    Activo
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Guardar
                        </button>

                        <a asp-action="RappiProductosConfig" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}