@model List<MakroTecno.ViewModels.Integraciones.RappiCategoriaMapeoViewModel>

@{
    ViewData["Title"] = "Categorías Rappi";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-tags"></i> Homologación de categorías Rappi
                </h4>

                <a asp-action="CrearEditarRappiCategoria" class="btn btn-light btn-sm">
                    <i class="fas fa-plus"></i> Nueva categoría
                </a>
            </div>

            <div class="card-body">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>Categoría ERP</th>
                            <th>Categoría Rappi</th>
                            <th>Estado</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.IdCateProducto</strong><br />
                                        <small>@item.CategoriaErpNombre</small>
                                    </td>
                                    <td>@item.CategoriaRappi</td>
                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactiva</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="CrearEditarRappiCategoria"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No hay categorías homologadas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>

            </div>
        </div>

    </div>
</div>