@model List<MakroTecno.ViewModels.Integraciones.RappiProductoConfigViewModel>

@{
    ViewData["Title"] = "Productos Rappi";
}

<div class="content-wrapper">
    <div class="container mt-4">

        <div class="card shadow-sm">
            <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-box"></i> Configuración de productos Rappi
                </h4>

                <a asp-action="CrearEditarRappiProductoConfig" class="btn btn-dark btn-sm">
                    <i class="fas fa-plus"></i> Nuevo producto
                </a>
            </div>

            <div class="card-body">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <table class="table table-bordered table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>Producto ERP</th>
                            <th>SKU Rappi</th>
                            <th>Nombre Rappi</th>
                            <th>Marca</th>
                            <th>EAN</th>
                            <th>Publicar</th>
                            <th>Estado</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ProductoId</strong><br />
                                        <small>@item.NombreProducto</small>
                                    </td>
                                    <td>@item.SkuRappi</td>
                                    <td>@item.NombreRappi</td>
                                    <td>@item.MarcaRappi</td>
                                    <td>@item.Ean</td>
                                    <td>
                                        @if (item.PublicarEnRappi)
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="CrearEditarRappiProductoConfig"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No hay productos configurados para Rappi.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>

            </div>
        </div>

    </div>
</div>